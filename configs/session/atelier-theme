# Parse colors.conf into KEY='value' lines (sourceable). Last assignment wins.
parse_colors() {
	conf=$1
	[ -f "$conf" ] || return 1
	while IFS= read -r line || [ -n "${line:-}" ]; do
		case $line in
		'' | \#*) continue ;;
		esac
		# strip inline comments that start with space+#
		case $line in
		*' #'*) line=${line%% \#*} ;;
		esac
		case $line in
		*=*) ;;
		*) continue ;;
		esac
		key=${line%%=*}
		val=${line#*=}
		key=$(printf '%s' "$key" | tr -d ' \t"'"'")
		val=$(printf '%s' "$val" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
		val=${val#\"}
		val=${val%\"}
		val=${val#\'}
		val=${val%\'}
		# skip empty keys; quote value for POSIX source
		[ -n "$key" ] || continue
		printf "%s='%s'\n" "$key" "$(printf '%s' "$val" | sed "s/'/'\\\\''/g")"
	done <"$conf"
}

hex_to_rgb() {
	hex=${1#\#}
	r=$(printf '%s' "$hex" | cut -c1-2)
	g=$(printf '%s' "$hex" | cut -c3-4)
	b=$(printf '%s' "$hex" | cut -c5-6)
	printf '%d,%d,%d' "0x$r" "0x$g" "0x$b"
}

# Build a sed script from sourced palette.env
write_sed_script() {
	envfile=$1
	sedfile=$2
	: >"$sedfile"
	# shellcheck disable=SC1090
	set -a
	# shellcheck source=/dev/null
	. "$envfile"
	set +a
	# Iterate known keys plus extras from envfile
	keys=$(sed -n "s/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p" "$envfile")
	for key in $keys; do
		eval "val=\${$key-}"
		# Escape sed replacement: \, &, |
		esc=$(printf '%s' "$val" | sed -e 's/[\\|&]/\\&/g')
		printf 's|{{ %s }}|%s|g\n' "$key" "$esc" >>"$sedfile"
		strip=${val#\#}
		esc_s=$(printf '%s' "$strip" | sed -e 's/[\\|&]/\\&/g')
		printf 's|{{ %s_strip }}|%s|g\n' "$key" "$esc_s" >>"$sedfile"
		case $val in
		\#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F])
			rgb=$(hex_to_rgb "$val")
			printf 's|{{ %s_rgb }}|%s|g\n' "$key" "$rgb" >>"$sedfile"
			;;
		esac
	done
}

render_templates() {
	sedfile=$1
	outdir=$2
	# User templates first, then shipped (do not overwrite existing)
	for dir in "$TEMPLATES_USER" "$TEMPLATES_SYS"; do
		[ -d "$dir" ] || continue
		for tpl in "$dir"/*.tpl; do
			[ -f "$tpl" ] || continue
			base=$(basename "$tpl" .tpl)
			out="$outdir/$base"
			if [ -f "$out" ]; then
				continue
			fi
			sed -f "$sedfile" "$tpl" >"$out"
		done
	done
}

write_nvim_lua() {
	outdir=$1
	envfile=$2
	scheme_file=$outdir/nvim.colorscheme
	if [ -f "$scheme_file" ]; then
		scheme=$(read_sidecar "$scheme_file" "tokyonight-night")
		printf 'pcall(vim.cmd.colorscheme, "%s")\n' "$scheme" >"$outdir/nvim.lua"
		return
	fi
	# shellcheck disable=SC1090
	set -a
	# shellcheck source=/dev/null
	. "$envfile"
	set +a
	cat >"$outdir/nvim.lua" <<EOF
local ok, base16 = pcall(require, "mini.base16")
if not ok then
	return
end
base16.setup({
	palette = {
		base00 = "${background}",
		base01 = "${background_alt}",
		base02 = "${border}",
		base03 = "${comment}",
		base04 = "${foreground_dim}",
		base05 = "${foreground}",
		base06 = "${color7}",
		base07 = "${color15}",
		base08 = "${red}",
		base09 = "${orange}",
		base0A = "${yellow}",
		base0B = "${green}",
		base0C = "${cyan}",
		base0D = "${blue}",
		base0E = "${magenta}",
		base0F = "${color8}",
	},
})
EOF
}

write_gowall_json() {
	outdir=$1
	envfile=$2
	# shellcheck disable=SC1090
	set -a
	# shellcheck source=/dev/null
	. "$envfile"
	set +a
	cat >"$outdir/gowall.json" <<EOF
{"name":"atelier","colors":["${foreground}","${foreground_dim}","${comment}","${accent}","${red}","${orange}","${yellow}","${green}","${cyan}","${blue}","${magenta}","${color0}","${color1}","${color2}","${color3}","${color4}","${color5}","${color6}","${color7}","${color8}","${color9}","${color10}","${color11}","${color12}","${color13}","${color14}","${color15}","${background}","${background_alt}","${background_deep}","${border}"]}
EOF
}

source_wallpaper() {
	for f in \
		"$CFG/wallpaper.png" "$CFG/wallpaper.jpg" "$CFG/wallpaper.jpeg" "$CFG/wallpaper.webp" \
		"$SHARE/wallpaper.png" "$SHARE/wallpaper.jpg" "$SHARE/wallpaper.jpeg" "$SHARE/wallpaper.webp" \
		"$SHARE/wallpapers/default.png" "$SHARE/wallpapers/default.jpg"
	do
		if [ -f "$f" ]; then
			printf '%s' "$f"
			return 0
		fi
	done
	return 1
}

recolor_wallpaper() {
	src=$1
	dest=$2
	json=$3
	if ! have gowall; then
		cp -f "$src" "$dest"
		return 0
	fi
	# Isolate gowall from opening a GUI preview when possible.
	set +e
	gowall convert "$src" "$dest" -t "$json" --preview false >/dev/null 2>&1
	st=$?
	if [ "$st" -ne 0 ] || [ ! -s "$dest" ]; then
		gowall convert "$src" "$dest" -t "$json" >/dev/null 2>&1
		st=$?
	fi
	if [ "$st" -ne 0 ] || [ ! -s "$dest" ]; then
		gowall convert "$src" -t "$json" --output "$dest" --preview false >/dev/null 2>&1
		st=$?
	fi
	set -e
	if [ ! -s "$dest" ]; then
		cp -f "$src" "$dest"
	fi
}

apply_wallpaper() {
	img=$1
	bg=${2:-#1a1b26}
	if [ -f "$img" ] && have feh; then
		if ! feh --no-fehbg --bg-fill "$img" >/dev/null 2>&1; then
			warn_retint "wallpaper failed"
		fi
	elif have xsetroot; then
		if ! xsetroot -solid "$bg" >/dev/null 2>&1; then
			warn_retint "root color failed"
		fi
	fi
}

remember_theme_background() {
	name=$1
	token=$2
	[ -n "$name" ] && [ -n "$token" ] || return 0
	mkdir -p "$BG_STATE"
	printf '%s\n' "$token" >"$BG_STATE/$name"
}

# Still images only. Symlinks are skipped: a theme file must be a regular file.
collect_backgrounds() {
	slug=$1
	dest=$2
	{
		for dir in "$NEXT/backgrounds" "$CFG/backgrounds/$slug"; do
			[ -d "$dir" ] || continue
			find "$dir" -maxdepth 1 -type f \
				\( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o \
				-iname '*.webp' \) -print
		done
	} | LC_ALL=C sort -u >"$dest"
}

background_token_for() {
	path=$1
	case $path in
	"$NEXT/backgrounds/"*)
		printf 'theme:%s\n' "$(basename "$path")"
		;;
	*)
		printf 'user:%s\n' "$path"
		;;
	esac
}

path_for_token() {
	token=$1
	list=$2
	case $token in
	theme:*)
		base=${token#theme:}
		while IFS= read -r p || [ -n "${p:-}" ]; do
			[ -n "${p:-}" ] || continue
			case $p in
			"$NEXT/backgrounds/$base")
				printf '%s\n' "$p"
				return 0
				;;
			esac
		done <"$list"
		;;
	user:*)
		p=${token#user:}
		if [ -f "$p" ] && grep -Fxq "$p" "$list"; then
			printf '%s\n' "$p"
			return 0
		fi
		;;
	esac
	return 1
}

# Same theme again: next image. A different theme: the image remembered for
# it, or the first file. Prints the chosen path.
choose_background_path() {
	prev=$1
	list=$2
	n=$(grep -c . "$list" || true)
	[ "${n:-0}" -gt 0 ] || return 1
	if [ "$prev" = "$slug" ] && [ -f "$CURRENT/background.token" ]; then
		cur=$(sed -n '1p' "$CURRENT/background.token")
		i=0
		found=0
		while IFS= read -r p || [ -n "${p:-}" ]; do
			[ -n "${p:-}" ] || continue
			i=$((i + 1))
			t=$(background_token_for "$p")
			if [ "$t" = "$cur" ]; then
				found=$i
				break
			fi
		done <"$list"
		if [ "$found" -gt 0 ]; then
			next=$((found % n + 1))
			sed -n "${next}p" "$list"
			return 0
		fi
	fi
	if [ "$prev" != "$slug" ] && [ -f "$BG_STATE/$slug" ]; then
		remembered=$(sed -n '1p' "$BG_STATE/$slug")
		if path_for_token "$remembered" "$list"; then
			return 0
		fi
	fi
	sed -n '1p' "$list"
}

# Theme backgrounds win over the recolored stock image. Returns 0 when a
# still was linked into the staged theme.
stage_theme_background() {
	slug=$1
	prev=$2
	list=$(mktemp)
	collect_backgrounds "$slug" "$list"
	if ! choose_background_path "$prev" "$list" >"${list}.choice"; then
		rm -f "$list" "${list}.choice"
		return 1
	fi
	path=$(sed -n '1p' "${list}.choice")
	rm -f "$list" "${list}.choice"
	[ -n "$path" ] && [ -f "$path" ] || return 1
	token=$(background_token_for "$path")
	case $token in
	theme:*)
		ln -sfn "backgrounds/$(basename "$path")" "$NEXT/wallpaper.png"
		;;
	*)
		ln -sfn "$path" "$NEXT/wallpaper.png"
		;;
	esac
	printf '%s\n' "$token" >"$NEXT/background.token"
	remember_theme_background "$slug" "$token"
	return 0
}

install_symlinks() {
	outdir=$1
	mkdir -p "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"
	mkdir -p "$HOME/.config/qt5ct/colors" "$HOME/.config/qt6ct/colors"
	if [ -f "$outdir/gtk-colors.css" ]; then
		ln -sfn "$outdir/gtk-colors.css" "$HOME/.config/gtk-3.0/atelier-colors.css"
		ln -sfn "$outdir/gtk-colors.css" "$HOME/.config/gtk-4.0/atelier-colors.css"
	fi
	if [ -f "$outdir/qt-colors.conf" ]; then
		ln -sfn "$outdir/qt-colors.conf" "$HOME/.config/qt5ct/colors/atelier.conf"
		ln -sfn "$outdir/qt-colors.conf" "$HOME/.config/qt6ct/colors/atelier.conf"
	fi
	if [ -f "$outdir/btop.theme" ]; then
		mkdir -p "$HOME/.config/btop/themes"
		ln -sfn "$outdir/btop.theme" "$HOME/.config/btop/themes/atelier.theme"
	fi
	link_fastfetch "$outdir"
	install_dunst "$outdir"
	ensure_picom_include
}

# Replace the stock fastfetch config with the generated palette. A file the
# user has edited is left alone.
link_fastfetch() {
	outdir=$1
	gen="$outdir/fastfetch.jsonc"
	[ -f "$gen" ] || return 0
	mkdir -p "$HOME/.config/fastfetch"
	dest="$HOME/.config/fastfetch/config.jsonc"
	stock="$SHARE/fastfetch/config.jsonc"
	if [ -L "$dest" ]; then
		target=$(readlink "$dest" || true)
		case $target in
		*/atelier/current/fastfetch.jsonc|*/atelier/current.next/fastfetch.jsonc)
			ln -sfn "$gen" "$dest"
			;;
		esac
		return 0
	fi
	if [ ! -e "$dest" ]; then
		ln -sfn "$gen" "$dest"
		return 0
	fi
	if [ -f "$stock" ] && cmp -s "$dest" "$stock"; then
		ln -sfn "$gen" "$dest"
	fi
}

# Base geometry once, then a palette file dunst reads from dunstrc.d.
install_dunst() {
	outdir=$1
	[ -f "$outdir/dunst.conf" ] || return 0
	mkdir -p "$HOME/.config/dunst/dunstrc.d"
	dest="$HOME/.config/dunst/dunstrc"
	stock="$SHARE/dunst/dunstrc"
	if [ ! -e "$dest" ] && [ -f "$stock" ]; then
		cp -f "$stock" "$dest"
	fi
	ln -sfn "$outdir/dunst.conf" "$HOME/.config/dunst/dunstrc.d/atelier.conf"
}

# Picom 13 includes with @include, and an absolute path is accepted.
# The marker is written with the directive so a comment cannot skip the insert.
ensure_picom_include() {
	conf="$HOME/.config/picom/picom.conf"
	colors="$CURRENT/picom-colors.conf"
	[ -f "$conf" ] && [ -f "$colors" ] || return 0
	if grep -q 'atelier-theme-picom' "$conf"; then
		return 0
	fi
	esc=$(printf '%s' "$colors" | sed 's/\\/\\\\/g; s/"/\\"/g')
	if ! cat >>"$conf" <<EOF

# atelier-theme-picom
@include "$esc"
EOF
	then
		warn_retint "could not update picom.conf"
	fi
}

reload_session() {
	outdir=$1
	envfile=$2
	# shellcheck disable=SC1090
	set -a
	# shellcheck source=/dev/null
	. "$envfile"
	set +a

	if have bspc; then
		_bsp=0
		bspc config normal_border_color "${color8}" 2>/dev/null || _bsp=1
		bspc config active_border_color "${accent}" 2>/dev/null || _bsp=1
		bspc config focused_border_color "${accent}" 2>/dev/null || _bsp=1
		bspc config presel_feedback_color "${magenta}" 2>/dev/null || _bsp=1
		[ "$_bsp" -eq 0 ] || warn_retint "bspwm border colors failed"
		unset _bsp
	fi

	# Polybar needs bspwm; skip during ~/.xinitrc (bspwmrc launches bars).
	if pgrep -u "$(id -u)" -x bspwm >/dev/null 2>&1 \
		&& [ -x "$HOME/.config/polybar/launch.sh" ]; then
		if ! "$HOME/.config/polybar/launch.sh" >/dev/null 2>&1; then
			warn_retint "polybar reload failed"
		fi
	fi

	if have xrdb && [ -f "$outdir/Xresources" ]; then
		# Keep font/dpi from ~/.Xresources, overlay palette
		_xr=0
		if [ -f "$HOME/.Xresources" ]; then
			xrdb -merge "$HOME/.Xresources" >/dev/null 2>&1 || _xr=1
		fi
		xrdb -merge "$outdir/Xresources" >/dev/null 2>&1 || _xr=1
		[ "$_xr" -eq 0 ] || warn_retint "X resources failed"
		unset _xr
	fi

	gtk_theme=${gtk_theme:-Yaru-dark}
	icon_theme=${icon_theme:-Papirus-Dark}
	color_scheme=${color_scheme:-prefer-dark}
	if have gsettings; then
		_gtk=0
		gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme" 2>/dev/null || _gtk=1
		gsettings set org.gnome.desktop.interface icon-theme "$icon_theme" 2>/dev/null || _gtk=1
		gsettings set org.gnome.desktop.interface color-scheme "$color_scheme" 2>/dev/null || _gtk=1
		gsettings set org.gnome.desktop.interface cursor-theme 'Yaru' 2>/dev/null || _gtk=1
		[ "$_gtk" -eq 0 ] || warn_retint "GTK settings failed"
		unset _gtk
	fi

	apply_wallpaper "$outdir/wallpaper.png" "${background}"
	reload_picom
	reload_dunst

	# ASUS ROG Aura: follow accent (or colors.conf keyboard= override).
	# No-op when atelier-asus is not installed.
	_kbd=${accent:-}
	[ -n "${keyboard:-}" ] && _kbd=$keyboard
	if [ -n "$_kbd" ] && have atelier-kbd; then
		if ! atelier-kbd color "$_kbd" >/dev/null 2>&1; then
			warn_retint "keyboard color failed"
		fi
	fi
	unset _kbd
}

reload_picom() {
	[ "${ATELIER_SKIP_PICOM:-}" = 1 ] && return 0
	if ! pgrep -u "$(id -u)" -x bspwm >/dev/null 2>&1; then
		return 0
	fi
	conf="$HOME/.config/picom/picom.conf"
	[ -f "$conf" ] && have picom || return 0
	pkill -x picom 2>/dev/null || true
	sleep 0.1
	if picom --config "$conf" -b >>/tmp/atelier-picom.log 2>&1; then
		return 0
	fi
	if picom --backend xrender --vsync -b >>/tmp/atelier-picom.log 2>&1; then
		return 0
	fi
	warn_retint "picom reload failed"
}

reload_dunst() {
	if ! pgrep -u "$(id -u)" -x dunst >/dev/null 2>&1; then
		return 0
	fi
	if ! have dunstctl; then
		warn_retint "dunst is running but dunstctl is missing"
		return 0
	fi
	if ! dunstctl reload >/dev/null 2>&1; then
		warn_retint "dunst reload failed"
	fi
}

cmd_set() {
	raw=${1:-}
	[ -n "$raw" ] || usage
	slug=$(slugify "$raw")
	sys=""
	usr=""
	[ -f "$THEMES_SYS/$slug/colors.conf" ] && sys="$THEMES_SYS/$slug"
	[ -f "$THEMES_USER/$slug/colors.conf" ] && usr="$THEMES_USER/$slug"
	if [ -z "$sys" ] && [ -z "$usr" ]; then
		printf 'atelier-theme: unknown theme: %s\n' "$slug" >&2
		exit 1
	fi

	lock_theme_set
	prev_name=""
	if [ -f "$CURRENT/theme.name" ]; then
		prev_name=$(sed -n '1p' "$CURRENT/theme.name")
	fi
	if [ -f "$CURRENT/background.token" ]; then
		remember_theme_background "$prev_name" "$(sed -n '1p' "$CURRENT/background.token")"
	fi

	rm -rf "$NEXT"
	mkdir -p "$NEXT"

	# Official first, user overlay
	if [ -n "$sys" ]; then
		cp -a "$sys"/. "$NEXT"/
	fi
	if [ -n "$usr" ]; then
		cp -a "$usr"/. "$NEXT"/
	fi

	[ -f "$NEXT/colors.conf" ] || {
		printf 'atelier-theme: missing colors.conf\n' >&2
		exit 1
	}

	{
		palette_defaults
		parse_colors "$NEXT/colors.conf"
	} >"$NEXT/palette.env.raw"
	# Compact last-wins so sed replacements are unique
	awk -F= '
		/^[A-Za-z_][A-Za-z0-9_]*=/ { k=$1; last[k]=$0 }
		END { for (k in last) print last[k] }
	' "$NEXT/palette.env.raw" >"$NEXT/palette.env"
	rm -f "$NEXT/palette.env.raw"

	# Sidecars → extra template keys
	mode=$(grep "^mode=" "$NEXT/palette.env" | tail -n 1 | sed -n "s/^mode='\\(.*\\)'/\\1/p")
	[ -n "$mode" ] || mode=dark
	if [ "$mode" = light ]; then
		gtk_default=Yaru
		icons_default=Papirus
		scheme=prefer-light
	else
		gtk_default=Yaru-dark
		icons_default=Papirus-Dark
		scheme=prefer-dark
	fi
	gtk_theme=$(read_sidecar "$NEXT/gtk.theme" "$gtk_default")
	icon_theme=$(read_sidecar "$NEXT/icons.theme" "$icons_default")
	if [ "$mode" = light ]; then
		window_theme=light
	else
		window_theme=dark
	fi
	printf "gtk_theme='%s'\nicon_theme='%s'\ncolor_scheme='%s'\nwindow_theme='%s'\n" \
		"$gtk_theme" "$icon_theme" "$scheme" "$window_theme" >>"$NEXT/palette.env"

	write_sed_script "$NEXT/palette.env" "$NEXT/sed.script"
	render_templates "$NEXT/sed.script" "$NEXT"
	write_nvim_lua "$NEXT" "$NEXT/palette.env"
	write_gowall_json "$NEXT" "$NEXT/palette.env"

	printf '%s\n' "$slug" >"$NEXT/theme.name"

	# A theme with stills uses those. Otherwise recolor the one stock source.
	if ! stage_theme_background "$slug" "$prev_name"; then
		src=$(source_wallpaper || true)
		mkdir -p "$CACHE/wallpapers"
		if [ -n "$src" ] && [ -f "$src" ]; then
			ph=$(cksum "$NEXT/colors.conf" | awk '{print $1"-"$2}')
			sh=$(cksum "$src" | awk '{print $1"-"$2}')
			cached="$CACHE/wallpapers/${slug}-${ph}-${sh}.png"
			if [ ! -s "$cached" ]; then
				recolor_wallpaper "$src" "$cached" "$NEXT/gowall.json"
			fi
			cp -f "$cached" "$NEXT/wallpaper.png"
		fi
	fi

	# BAT theme sidecar → shell-colors
	if [ -f "$NEXT/bat.theme" ]; then
		bt=$(read_sidecar "$NEXT/bat.theme" "")
		if [ -n "$bt" ] && [ -f "$NEXT/shell-colors.sh" ]; then
			printf "export BAT_THEME='%s'\n" "$bt" >>"$NEXT/shell-colors.sh"
		fi
	fi

	rm -f "$NEXT/sed.script"

	mkdir -p "$CFG"
	rm -rf "$CURRENT"
	mv "$NEXT" "$CURRENT"

	install_symlinks "$CURRENT"
	reload_session "$CURRENT" "$CURRENT/palette.env"
	hook="$CFG/hooks/theme-set"
	if [ -x "$hook" ]; then
		if ! "$hook" "$slug"; then
			warn_retint "hook theme-set failed"
		fi
	fi
	printf 'atelier-theme: applied %s\n' "$slug"
}

cmd_save() {
	name=${1:-}
	[ -n "$name" ] || usage
	slug=$(slugify "$name")
	[ -d "$CURRENT" ] || {
		printf 'atelier-theme: nothing to save (run set first)\n' >&2
		exit 1
	}
	dest="$THEMES_USER/$slug"
	mkdir -p "$dest"
	cp -f "$CURRENT/colors.conf" "$dest/colors.conf"
	# Keep display name
	if grep -q '^name=' "$dest/colors.conf"; then
		sed -i "s/^name=.*/name=$name/" "$dest/colors.conf"
	else
		printf 'name=%s\n' "$name" | cat - "$dest/colors.conf" >"$dest/colors.conf.new"
		mv "$dest/colors.conf.new" "$dest/colors.conf"
	fi
	[ -f "$CURRENT/nvim.colorscheme" ] && cp -f "$CURRENT/nvim.colorscheme" "$dest/"
	[ -f "$CURRENT/gtk.theme" ] && cp -f "$CURRENT/gtk.theme" "$dest/"
	[ -f "$CURRENT/icons.theme" ] && cp -f "$CURRENT/icons.theme" "$dest/"
	[ -f "$CURRENT/bat.theme" ] && cp -f "$CURRENT/bat.theme" "$dest/"
	printf 'atelier-theme: saved %s → %s\n' "$slug" "$dest"
}

cmd_wallpaper() {
	path=${1:-}
	[ -n "$path" ] || usage
	[ -f "$path" ] || {
		printf 'atelier-theme: not a file: %s\n' "$path" >&2
		exit 1
	}
	mkdir -p "$CFG"
	ext=$(printf '%s' "$path" | sed 's/.*\.//')
	case $ext in
	png | PNG) cp -f "$path" "$CFG/wallpaper.png" ;;
	jpg | jpeg | JPG | JPEG | webp | WEBP)
		if have convert; then
			convert "$path" "$CFG/wallpaper.png"
		elif have gowall; then
			# convert format via gowall if it can write png
			gowall convert "$path" "$CFG/wallpaper.png" >/dev/null 2>&1 || cp -f "$path" "$CFG/wallpaper.png"
		else
			cp -f "$path" "$CFG/wallpaper.png"
		fi
		;;
	*)
		cp -f "$path" "$CFG/wallpaper.png"
		;;
	esac
	# Drop cached recolors so the new source is used
	rm -rf "$CACHE/wallpapers"
	if [ -f "$CURRENT/theme.name" ]; then
		cmd_set "$(cat "$CURRENT/theme.name")"
	else
		cmd_set tokyo-night
	fi
}

write_matugen_config() {
	outconf=$1
	outfile=$2
	mode=$3
	tpl="$SHARE/matugen/colors.conf.tpl"
	[ -f "$tpl" ] || tpl="$TEMPLATES_SYS/../matugen/colors.conf.tpl"
	cat >"$outconf" <<EOF
[config]
reload_apps = false

[templates.atelier]
input_path = '$tpl'
output_path = '$outfile'
EOF
}

gowall_extract_fallback() {
	img=$1
	outfile=$2
	mode=$3
	have gowall || return 1
	# Best-effort: dump extract output and pick hex codes
	tmp=$(mktemp)
	if ! gowall extract "$img" >"$tmp" 2>/dev/null; then
		rm -f "$tmp"
		return 1
	fi
	hexes=$(grep -oE '#[0-9A-Fa-f]{6}' "$tmp" | head -n 16)
	rm -f "$tmp"
	[ -n "$hexes" ] || return 1
	i=0
	# shellcheck disable=SC2086
	set -- $hexes
	bg=${1:-#1a1b26}
	fg=${2:-#c0caf5}
	acc=${3:-#7aa2f7}
	cat >"$outfile" <<EOF
name=Generated
mode=$mode
background=$bg
background_alt=${4:-$bg}
background_deep=$bg
foreground=$fg
foreground_dim=$fg
comment=${5:-#565f89}
border=${6:-#3b4261}
accent=$acc
red=${7:-#f7768e}
green=${8:-#9ece6a}
yellow=${9:-#e0af68}
blue=$acc
magenta=${10:-#bb9af7}
cyan=${11:-#7dcfff}
orange=${12:-#ff9e64}
cursor=$fg
selection_background=${4:-$bg}
selection_foreground=$fg
color0=${1:-#15161e}
color1=${7:-#f7768e}
color2=${8:-#9ece6a}
color3=${9:-#e0af68}
color4=$acc
color5=${10:-#bb9af7}
color6=${11:-#7dcfff}
color7=$fg
color8=${6:-#414868}
color9=${7:-#f7768e}
color10=${8:-#9ece6a}
color11=${9:-#e0af68}
color12=$acc
color13=${10:-#bb9af7}
color14=${11:-#7dcfff}
color15=$fg
EOF
}

cmd_from_wallpaper() {
	img=${1:-}
	[ -n "$img" ] || usage
	shift
	name=""
	mode=dark
	while [ "$#" -gt 0 ]; do
		case $1 in
		--name)
			name=$2
			shift 2
			;;
		--mode)
			mode=$2
			shift 2
			;;
		*)
			printf 'atelier-theme: unknown option: %s\n' "$1" >&2
			exit 2
			;;
		esac
	done
	[ -f "$img" ] || {
		printf 'atelier-theme: not a file: %s\n' "$img" >&2
		exit 1
	}
	[ -n "$name" ] || name="generated"
	slug=$(slugify "$name")
	dest="$THEMES_USER/$slug"
	mkdir -p "$dest"
	outfile="$dest/colors.conf"

	ok=0
	if have matugen; then
		tmpc=$(mktemp)
		write_matugen_config "$tmpc" "$outfile" "$mode"
		if matugen image "$img" --mode "$mode" --config "$tmpc" >/dev/null 2>&1; then
			ok=1
		fi
		rm -f "$tmpc"
	fi
	if [ "$ok" -eq 0 ]; then
		if gowall_extract_fallback "$img" "$outfile" "$mode"; then
			ok=1
		fi
	fi
	if [ "$ok" -eq 0 ]; then
		printf 'atelier-theme: need matugen (preferred) or gowall extract\n' >&2
		printf '  sudo xbps-install -S matugen\n' >&2
		exit 1
	fi
	# Ensure name/mode
	if grep -q '^name=' "$outfile"; then
		sed -i "s/^name=.*/name=$name/" "$outfile"
	else
		printf 'name=%s\n' "$name" | cat - "$outfile" >"$outfile.new"
		mv "$outfile.new" "$outfile"
	fi
	if grep -q '^mode=' "$outfile"; then
		sed -i "s/^mode=.*/mode=$mode/" "$outfile"
	fi
	cmd_set "$slug"
}

# --- dispatch --------------------------------------------------------------

[ "$#" -ge 1 ] || usage
cmd=$1
shift

case $cmd in
list)
	cmd_list
	;;
current)
	cmd_current
	;;
set)
	cmd_set "${1:-}"
	;;
save)
	cmd_save "${1:-}"
	;;
wallpaper)
	cmd_wallpaper "${1:-}"
	;;
from-wallpaper)
	cmd_from_wallpaper "$@"
	;;
-h | --help | help)
	usage
	;;
*)
	printf 'atelier-theme: unknown command: %s\n' "$cmd" >&2
	usage
	;;
esac
