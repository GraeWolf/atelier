#!/bin/sh
# Atelier — theme engine (named palettes, still backgrounds, live retint)
# Usage: atelier-theme list|current|set <name>|from-wallpaper <img> [--name N] [--mode dark|light]
#        atelier-theme save <name>|wallpaper <path>
set -eu

SHARE="${ATELIER_SHARE:-/usr/share/atelier}"
CFG="${XDG_CONFIG_HOME:-$HOME/.config}/atelier"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/atelier"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/atelier"
CURRENT="$CFG/current"
NEXT="$CFG/current.next"
THEMES_USER="$CFG/themes"
THEMES_SYS="$SHARE/themes"
TEMPLATES_USER="$CFG/templates"
TEMPLATES_SYS="$SHARE/templates"
BG_STATE="$STATE/theme-backgrounds"

have() { command -v "$1" >/dev/null 2>&1; }

warn_retint() {
	printf 'atelier-theme: %s\n' "$*" >&2
}

# One switch at a time. The lock covers staging through the live retint.
lock_theme_set() {
	if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ]; then
		_lock="$XDG_RUNTIME_DIR/atelier-theme.lock"
	else
		_lock="/tmp/atelier-theme.lock.$(id -u)"
	fi
	exec 9>"$_lock"
	unset _lock
	if have flock; then
		if ! flock -w 30 9; then
			printf 'atelier-theme: another theme switch is still running\n' >&2
			exit 1
		fi
	fi
}

usage() {
	printf 'Usage: atelier-theme list|current|set <name>|save <name>|wallpaper <path>\n' >&2
	printf '       atelier-theme from-wallpaper <image> [--name <name>] [--mode dark|light]\n' >&2
	exit 2
}

slugify() {
	printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//;s/-$//'
}

read_sidecar() {
	# read_sidecar file default
	if [ -f "$1" ]; then
		# first non-comment, non-empty line
		sed -n '/^[[:space:]]*#/d;/^[[:space:]]*$/d;p' "$1" | sed -n '1p'
	else
		printf '%s' "$2"
	fi
}

theme_slug_from_dir() {
	basename "$1"
}

theme_dirs() {
	# print existing theme directories (user overrides system by slug later)
	if [ -d "$THEMES_USER" ]; then
		find "$THEMES_USER" -mindepth 1 -maxdepth 1 -type d 2>/dev/null || true
	fi
	if [ -d "$THEMES_SYS" ]; then
		find "$THEMES_SYS" -mindepth 1 -maxdepth 1 -type d 2>/dev/null || true
	fi
}

find_theme_dir() {
	slug=$1
	if [ -f "$THEMES_USER/$slug/colors.conf" ]; then
		printf '%s' "$THEMES_USER/$slug"
		return 0
	fi
	if [ -f "$THEMES_SYS/$slug/colors.conf" ]; then
		printf '%s' "$THEMES_SYS/$slug"
		return 0
	fi
	return 1
}

cmd_list() {
	seen=" "
	theme_dirs | while IFS= read -r dir || [ -n "${dir:-}" ]; do
		[ -n "${dir:-}" ] || continue
		[ -f "$dir/colors.conf" ] || continue
		slug=$(theme_slug_from_dir "$dir")
		case $seen in
		*" $slug "*) continue ;;
		esac
		seen="$seen$slug "
		disp=$(sed -n 's/^name=//p' "$dir/colors.conf" | sed -n '1p')
		[ -n "$disp" ] || disp=$slug
		mark=""
		if [ -f "$CURRENT/theme.name" ] && [ "$(cat "$CURRENT/theme.name")" = "$slug" ]; then
			mark=" *"
		fi
		printf '%s\t%s%s\n' "$slug" "$disp" "$mark"
	done | sort -u
}

cmd_current() {
	if [ -f "$CURRENT/theme.name" ]; then
		cat "$CURRENT/theme.name"
		return 0
	fi
	printf 'tokyo-night\n'
}

palette_defaults() {
