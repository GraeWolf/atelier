		"foreground_dim='#a9b1d6'" \
		"comment='#565f89'" \
		"border='#3b4261'" \
		"accent='#7aa2f7'" \
		"red='#f7768e'" \
		"green='#9ece6a'" \
		"yellow='#e0af68'" \
		"blue='#7aa2f7'" \
		"magenta='#bb9af7'" \
		"cyan='#7dcfff'" \
		"orange='#ff9e64'" \
		"cursor='#c0caf5'" \
		"selection_background='#33467c'" \
		"selection_foreground='#c0caf5'" \
		"color0='#15161e'" \
		"color1='#f7768e'" \
		"color2='#9ece6a'" \
		"color3='#e0af68'" \
		"color4='#7aa2f7'" \
		"color5='#bb9af7'" \
		"color6='#7dcfff'" \
		"color7='#a9b1d6'" \
		"color8='#414868'" \
		"color9='#f7768e'" \
