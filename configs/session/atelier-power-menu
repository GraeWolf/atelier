#!/bin/sh
# Atelier — session power menu (rofi). Bound to Super+Ctrl+Escape.
# Actions use loginctl / atelier-lock / bspc — no root required for typical seats.
set -eu

have() { command -v "$1" >/dev/null 2>&1; }

have rofi || {
	printf 'atelier-power-menu: rofi is required\n' >&2
	exit 1
}

items="Lock
Logout
Suspend"
# Hibernate is a kernel S4 action; only list it when the kernel advertises disk.
if [ -r /sys/power/state ] && grep -qw disk /sys/power/state; then
	items="$items
Hibernate"
fi
items="$items
Reboot
Shutdown"

choice=$(
	printf '%s\n' "$items" | rofi -dmenu -i -p "Power" -format s
) || exit 0

[ -n "$choice" ] || exit 0

case $choice in
Lock)
	if have atelier-lock; then
		exec atelier-lock
	fi
	if have xsecurelock; then
		exec xsecurelock
	fi
	printf 'atelier-power-menu: no lock helper found\n' >&2
	exit 1
	;;
Logout)
	if have bspc; then
		bspc quit
		exit 0
	fi
	# Fallback if not under bspwm
	if have loginctl; then
		exec loginctl terminate-session "${XDG_SESSION_ID:-}"
	fi
	exit 1
	;;
Suspend)
	have loginctl || exit 1
	# Swapfile present: sleep to RAM, then hibernate after 30 minutes.
	if [ -r /sys/power/state ] && grep -qw disk /sys/power/state \
		&& awk 'NR > 1 { sz += $3 } END { exit !(sz > 0) }' /proc/swaps 2>/dev/null
	then
		exec loginctl suspend-then-hibernate
	fi
	exec loginctl suspend
	;;
Hibernate)
	have loginctl || exit 1
	if ! awk 'NR > 1 { sz += $3 } END { exit !(sz > 0) }' /proc/swaps 2>/dev/null; then
		rofi -e "Hibernate needs a swapfile. Run: sudo atelier-setup-swap" 2>/dev/null || \
			printf 'atelier-power-menu: no swap; sudo atelier-setup-swap\n' >&2
		exit 1
	fi
	exec loginctl hibernate
	;;
Reboot)
	have loginctl || exit 1
	exec loginctl reboot
	;;
Shutdown)
	have loginctl || exit 1
	exec loginctl poweroff
	;;
*)
	exit 0
	;;
esac
