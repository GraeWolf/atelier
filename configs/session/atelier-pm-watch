#!/bin/sh
# Record elogind PrepareForSleep, with the inhibitor list at that moment.
#
# system-sleep hooks run only after delay inhibitors release, or after
# InhibitDelayMaxSec. This signal is the start of that wait.
#
# Logs: /tmp/atelier-prepare-sleep.log (always)
#       $XDG_RUNTIME_DIR/atelier-prepare-sleep.log when that dir exists
#       /var/log/atelier-pm.log when it is writable
set -eu

# elogind's loginctl has no list-inhibitors. busctl is what the desktop has.
# dbus-monitor is optional and often not installed.
if ! command -v busctl >/dev/null 2>&1 && ! command -v dbus-monitor >/dev/null 2>&1; then
	exit 0
fi

# Always /tmp so the file is findable even when the session's
# XDG_RUNTIME_DIR is unset or different from the shell that reads it.
# Also the runtime dir and the system pm log when those are writable.
log=/tmp/atelier-prepare-sleep.log
pidfile=/tmp/atelier-pm-watch.pid
syslog=/var/log/atelier-pm.log
runtime_log=""
if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
	mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true
	runtime_log=$XDG_RUNTIME_DIR/atelier-prepare-sleep.log
fi

if [ -f "$pidfile" ]; then
	old=$(cat "$pidfile" 2>/dev/null || true)
	if [ -n "$old" ] && kill -0 "$old" 2>/dev/null; then
		exit 0
	fi
fi
printf '%s\n' "$$" >"$pidfile"

logline() {
	ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date)
	printf '%s atelier-pm-watch: %s\n' "$ts" "$*" >>"$log" 2>/dev/null || true
	if [ -n "$runtime_log" ]; then
		printf '%s atelier-pm-watch: %s\n' "$ts" "$*" >>"$runtime_log" 2>/dev/null || true
	fi
	printf '%s atelier-pm-watch: %s\n' "$ts" "$*" >>"$syslog" 2>/dev/null || true
}

dump_inhibitors() {
	if ! command -v busctl >/dev/null 2>&1; then
		logline "busctl missing; cannot list inhibitors"
		return 0
	fi
	# elogind's loginctl has no list-inhibitors. ListInhibitors is
	# a(ssssuu): what, who, why, mode, uid, pid.
	logline "ListInhibitors:"
	busctl call org.freedesktop.login1 /org/freedesktop/login1 \
		org.freedesktop.login1.Manager ListInhibitors 2>/dev/null |
		while read -r line; do
			logline "  $line"
		done
	busctl get-property org.freedesktop.login1 /org/freedesktop/login1 \
		org.freedesktop.login1.Manager InhibitDelayMaxUSec 2>/dev/null |
		while read -r line; do
			logline "InhibitDelayMaxUSec $line"
		done
}

logline "watching PrepareForSleep"

# busctl monitor prints the signal, then a line "BOOLEAN true/false".
# That signal is when elogind has accepted suspend, before it waits on
# delay inhibitors and before system-sleep hooks.
if command -v busctl >/dev/null 2>&1; then
	busctl monitor --match \
		"type='signal',interface='org.freedesktop.login1.Manager',member='PrepareForSleep'" \
		2>/dev/null |
		while read -r line; do
			case $line in
			*'false'*)
				logline "PrepareForSleep false ($line)"
				;;
			*'true'*)
				logline "PrepareForSleep true ($line)"
				dump_inhibitors
				;;
			esac
		done
else
	dbus-monitor --system \
		"type='signal',interface='org.freedesktop.login1.Manager',member='PrepareForSleep'" \
		2>/dev/null |
		while read -r line; do
			case $line in
			*'boolean true'*)
				logline "PrepareForSleep true"
				dump_inhibitors
				;;
			*'boolean false'*)
				logline "PrepareForSleep false"
				;;
			esac
		done
fi
