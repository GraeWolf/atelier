# Atelier — ghostty (Tokyo Night)
# https://ghostty.org/docs/config
#
# Font: Fira Code is shipped via atelier-base (font-firacode).
# JetBrains Mono is planned but not yet packaged — do not require it here.

font-family = Fira Code
font-family-bold = Fira Code
font-size = 12

background-opacity = 0.75
window-decoration = none

# Tokyo Night colors
background = #1a1b26
foreground = #c0caf5
cursor-color = #c0caf5
selection-background = #33467c
selection-foreground = #c0caf5

palette = 0=#15161e
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#a9b1d6
palette = 8=#414868
palette = 9=#f7768e
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#bb9af7
palette = 14=#7dcfff
palette = 15=#c0caf5

# Slight transparency; picom opacity-rule also softens the window.
# Keep high enough for readable text; browsers stay fully opaque in picom.
background-opacity = 0.92
minimum-contrast = 1.1

window-padding-x = 8
window-padding-y = 8
window-theme = dark
confirm-close-surface = false
clipboard-paste-protection = false
