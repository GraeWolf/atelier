/* Atelier — Tokyo Night theme for rofi */
/* Avoid fully transparent elements — they break input/visibility with broken compositors */
* {
	bg:       #1a1b26;
	bg-alt:   #292e42;
	fg:       #c0caf5;
	fg-alt:   #565f89;
	blue:     #7aa2f7;
	magenta:  #bb9af7;
	red:      #f7768e;
	green:    #9ece6a;

	background-color: @bg;
	text-color:       @fg;
}

window {
	width: 40%;
	border: 2px;
	border-color: @blue;
	border-radius: 0;
	padding: 12px;
	background-color: @bg;
	transparency: "real";
}

mainbox {
	children: [ inputbar, listview ];
	spacing: 10px;
	background-color: @bg;
}

inputbar {
	children: [ prompt, entry ];
	padding: 8px;
	background-color: @bg-alt;
	border-radius: 0;
	spacing: 8px;
	text-color: @fg;
}

prompt {
	enabled: true;
	background-color: transparent;
	text-color: @blue;
}

entry {
	placeholder: "Search…";
	placeholder-color: @fg-alt;
	background-color: transparent;
	text-color: @fg;
	cursor: text;
	blink: true;
}

listview {
	lines: 10;
	scrollbar: false;
	spacing: 4px;
	background-color: @bg;
	cycle: true;
	dynamic: true;
	fixed-height: true;
}

element {
	padding: 8px;
	border-radius: 0;
	background-color: @bg;
	text-color: @fg;
}

element selected {
	background-color: @bg-alt;
	text-color: @blue;
}

element-icon {
	size: 1.2em;
	background-color: transparent;
	/* keep icons from eating the whole row in odd font situations */
}

element-text {
	background-color: transparent;
	text-color: inherit;
	highlight: bold #7aa2f7;
	vertical-align: 0.5;
}
