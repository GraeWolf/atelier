[Desktop Entry]
Type=Application
Name=Install Atelier Linux
GenericName=System Installer
Comment=Install Atelier Linux (whole-disk, simple GUI)
# GUI when launched from a desktop session; TTY live uses: sudo atelier-install
Exec=env LANG=C.UTF-8 LC_ALL=C.UTF-8 atelier-install --gui
Icon=system-software-install
Terminal=false
Categories=System;Settings;
Keywords=install;atelier;system;
StartupNotify=false
