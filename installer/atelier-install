}

edit_encryption() {
	local crc=0
	ui_confirm "Encrypt the root filesystem with LUKS2?

/boot and the EFI partition stay unencrypted.
A forgotten passphrase means the data is gone.

Yes = encrypt (a passphrase is next)
No  = do not encrypt" || crc=$?
	case $crc in
	0)
		ENCRYPT_DISK=1
		if ! prompt_luks_passphrase; then
			ENCRYPT_DISK=0
			wipe_luks_pass
			ui_error "Encryption left off (no passphrase)."
		fi
		;;
	1)
		ENCRYPT_DISK=0
		wipe_luks_pass
		;;
	*)
		return 0
		;;
	esac
	log "ENCRYPT_DISK=$ENCRYPT_DISK"
}

edit_swap() {
	local gib crc=0
	gib=$(swap_size_gib)
	ui_confirm "Create a ${gib} GiB /swapfile for hibernation?

The file is /swapfile on the root filesystem.
It is encrypted when LUKS is on.

Yes = create the swapfile
No  = no swap" || crc=$?
	case $crc in
	0) CREATE_SWAP=1 ;;
	1) CREATE_SWAP=0 ;;
	*) return 0 ;;
	esac
	log "CREATE_SWAP=$CREATE_SWAP size=${gib}GiB"
}

edit_grub() {
	local msg crc=0
	msg="Install GRUB?

Yes = install GRUB
No  = skip GRUB"
	if [ "${ENCRYPT_DISK:-0}" -eq 1 ]; then
		msg="Install GRUB?

Encrypted disks need GRUB so the kernel can
unlock LUKS at boot.

Yes = install GRUB
No  = skip GRUB"
	fi
	ui_confirm "$msg" || crc=$?
	case $crc in
	0) INSTALL_BOOTLOADER=1 ;;
	1) INSTALL_BOOTLOADER=0 ;;
	*) return 0 ;;
	esac
	log "INSTALL_BOOTLOADER=$INSTALL_BOOTLOADER"
}

edit_packages() {
	local cur="" next
	if [ ${#PKG_EXTRA[@]} -gt 0 ]; then
		cur="${PKG_EXTRA[*]}"
	fi
	ui_read next ui_entry "Extra packages, space-separated.
Blank keeps the list. A single - clears it." "$cur" || return 0
	if [ "$next" = "-" ]; then
		next=""
	fi
	if ! assign_packages "$next"; then
		ui_error "Invalid package name '${ASSIGN_PACKAGES_ERR:-}'."
