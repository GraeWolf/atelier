	if [ -n "$PRESET_FILE" ]; then preset=$PRESET_FILE; else preset="built-in defaults"; fi
	cat <<EOF
Install summary

Preset:      $preset
Disk:        ${DISK:-not selected} (ERASED)
Firmware:    $mode
Hostname:    $HOSTNAME
User:        $USERNAME
Password:    $pw
Root:        locked (sudo via wheel)
Encryption:  $enc
Swapfile:    $sw
Timezone:    $TIMEZONE
Locale:      $LOCALE
Keymap:      $KEYMAP
NVIDIA:      $ns
Xlibre:      yes (required, no X.Org fallback)
Gaming:      $gs
Packages:    $pkgs
Mirror:      $VOID_REPO
GRUB:        $bl

Install starts the copy. Edit changes one field. Quit leaves the disk alone.
EOF
}

# Nine lines. The full summary_text plus the choice list does not fit a
# 24-row console. This card keeps every field, and Start / Edit / Quit
# stay on screen under it. Gaming is its own line.
summary_menu_prompt() {
	local mode=BIOS ns enc sw bl pkgs pw gs
	is_efi && mode=UEFI
	gs=$(gaming_label)
	case $NVIDIA_MODE in
	auto)
		if [ "$INSTALL_NVIDIA" -eq 1 ]; then
			ns="yes (auto, GPU)"
		else
			ns="no (auto, no GPU)"
		fi
		;;
	yes) ns="yes" ;;
	no) ns="no" ;;
	*) ns=$NVIDIA_MODE ;;
	esac
	if [ "$ENCRYPT_DISK" -eq 1 ]; then
		if [ -n "$LUKSPASS" ]; then
			enc="yes"
		else
			enc="yes, no passphrase"
		fi
	else
		enc="no"
	fi
	if [ "$CREATE_SWAP" -eq 1 ]; then
		sw="yes"
	else
		sw="no"
	fi
	if [ "$INSTALL_BOOTLOADER" -eq 1 ]; then
		bl="yes"
	else
		bl="no"
	fi
	if [ ${#PKG_EXTRA[@]} -eq 0 ]; then
		pkgs="(none)"
	else
		pkgs="${PKG_EXTRA[*]}"
	fi
	if [ -n "$USERPASS" ]; then
		pw="set"
	else
		pw="not set"
	fi
	printf '%s\n' \
		"Disk: ${DISK:-none} (${mode}, ERASED)  GRUB: $bl" \
		"Host: $HOSTNAME  User: $USERNAME  Password: $pw" \
		"Root: locked (sudo via wheel)" \
		"TZ: $TIMEZONE  Locale: $LOCALE  Key: $KEYMAP" \
		"NVIDIA: $ns  XLibre: required" \
		"Gaming: $gs" \
		"Encrypt: $enc  Swap: $sw  Packages: $pkgs" \
		"Mirror: $VOID_REPO" \
		"Preset: ${PRESET_FILE:-built-in defaults}"
}

# Summary choices. Prints install, edit, or quit. 1 = Escape/Ctrl+C.
# The cursor starts on Edit, so Enter does not start the install.
# A tall terminal gets the full summary. A 24-row console gets the short card.
gum_summary_choice() {
	local pick="" rc=0
	ui_screen_open
	if [ "$UI_ROWS" -ge 42 ]; then
		ui_card "$(summary_text)"
	else
		ui_card "$(summary_menu_prompt)"
	fi
	ui_nl
	UI_INTERRUPTED=0
	gum_pick pick 3 "Enter selects. Escape stays here and does not install." \
		"Edit a field" \
		"Start installation" "Edit a field" "Quit" || rc=$?
	if [ "${UI_INTERRUPTED:-0}" -eq 1 ] || [ "$rc" -ne 0 ]; then
		UI_INTERRUPTED=0
		return 1
	fi
	case $pick in
	"Start installation") printf 'install\n' ;;
	"Edit a field") printf 'edit\n' ;;
	"Quit") printf 'quit\n' ;;
	*) return 1 ;;
	esac
}

step_welcome() {
	local preset
	ui_mark_step 1 Welcome
	if [ -n "$PRESET_FILE" ]; then
		preset=$PRESET_FILE
	else
		preset="built-in defaults"
	fi
	# Ten lines so the card, the banner, and Next/Back/Abort fit on 80x24.
	wizard_page "Welcome to Atelier Linux installer v${VERSION}.
Whole-disk install. The selected disk is erased.
XLibre is always installed (no X.Org fallback).

Preset: $preset

Asks for the disk, hostname, username, and password.
Root is locked. The user has sudo. A private preset
that sets the names skips those questions. LUKS is
asked only when encryption is on. Edit other fields
from the summary."
}

step_disk() {
	local args=() path size model rc=0 pick crc=0
	ui_mark_step 2 Disk
	while IFS='|' read -r path size model; do
		[ -n "$path" ] || continue
		args+=("$path" "$size  $model")
	done < <(list_disks)
	if [ ${#args[@]} -eq 0 ]; then
		ui_error "No disks found."
		return 2
	fi

	ui_read pick ui_list_pick "Select disk to ERASE:" "${args[@]}" || rc=$?
	if [ "$rc" -eq 1 ]; then return 1; fi
	if [ "$rc" -ge 2 ]; then return 2; fi
	DISK=${pick//|/}
	DISK=$(printf '%s' "$DISK" | tr -d '\r' | awk 'NF{print $1; exit}')
	case $DISK in
	/dev/*) ;;
	*) ui_error "Invalid disk selection (got: ${DISK:-empty}). Use the arrow keys, then Enter."; return 1 ;;
	esac
	[ -b "$DISK" ] || { ui_error "Invalid disk: $DISK"; return 1; }

	# Highlight No. Enter does not erase the disk; Yes has to be chosen.
	ui_confirm "ALL DATA on $DISK will be DESTROYED.

Yes = use this disk
No  = go back" no || crc=$?
	case $crc in
	0) ;;
	1) return 1 ;;
	*) return 2 ;;
	esac
	log "DISK=$DISK"
	return 0
}

# Ask only for a name the preset left empty. Going forward with both
# names already valid skips this step. Going back passes through it.
step_names() {
	if valid_hostname "${HOSTNAME:-}" && valid_username "${USERNAME:-}"; then
		if [ "$NAV" = back ]; then
			return 1
		fi
		return 0
	fi
	if ! valid_hostname "${HOSTNAME:-}"; then
		prompt_hostname || return 1
	fi
	if ! valid_username "${USERNAME:-}"; then
		prompt_username || return 1
	fi
	return 0
}

step_password() {
	prompt_user_password || return 1
	return 0
}

# No screen when encryption is off. The summary Edit screen can turn it on.
step_luks() {
	[ "${ENCRYPT_DISK:-0}" -eq 1 ] || return 0
	[ -n "${LUKSPASS:-}" ] && return 0
	prompt_luks_passphrase || return 1
	return 0
}

step_summary() {
	local choice rc
	while true; do
		rc=0
		choice=""
		if [ "${ENCRYPT_DISK:-0}" -eq 1 ]; then
			ui_mark_step 7 Summary
		else
			ui_mark_step 6 Summary
		fi
		# gum draws a short card on a 24-row console so Quit stays on
		# screen. Text mode keeps the full summary in the prompt.
		if [ "$UI" = gum ]; then
			ui_read choice gum_summary_choice || rc=$?
		else
			ui_read choice ui_list_pick "$(summary_text)" \
				install "Start installation" \
				edit "Edit a field" \
				quit "Quit" || rc=$?
		fi
		# EOF in text mode. Escape on the gum menu is rc 1: show it again.
		if [ "$rc" -ge 2 ]; then
			return 2
		fi
		if [ "$rc" -ne 0 ]; then
			continue
		fi
		log "summary choice=$choice"
		case $choice in
		install)
			if [ -z "$DISK" ] || [ ! -b "$DISK" ]; then
				ui_error "Select a disk before installing."
				continue
			fi
			if ! valid_hostname "${HOSTNAME:-}"; then
				ui_error "Set a hostname before installing."
				prompt_hostname || true
				continue
			fi
			if ! valid_username "${USERNAME:-}"; then
				ui_error "Set a username before installing."
				prompt_username || true
				continue
			fi
			if [ -z "$USERPASS" ]; then
				ui_error "Set the user password before installing."
				continue
			fi
			if [ "${ENCRYPT_DISK:-0}" -eq 1 ] && [ -z "${LUKSPASS:-}" ]; then
				ui_error "Encryption is on but there is no LUKS passphrase."
				prompt_luks_passphrase || true
				continue
			fi
			return 0
			;;
		edit) edit_menu ;;
		quit) return 2 ;;
		*)
			continue
			;;
		esac
	done
}

# --- install backend ----------------------------------------------------------
partition_disk() {
	if [ "${DRY_RUN:-0}" -eq 1 ]; then
		die "Refusing to partition $DISK during a dry run."
	fi
	log "Partitioning $DISK encrypt=$ENCRYPT_DISK"
	umount -R "$TARGETDIR" 2>/dev/null || true
	lsblk -ln -o NAME,MOUNTPOINT "$DISK" 2>/dev/null | while read -r n m; do
		[ -n "$m" ] || continue
		umount "$m" 2>/dev/null || umount -l "$m" 2>/dev/null || true
	done
	close_cryptroot
	wipefs -a "$DISK" 2>/dev/null || true
	parted -s "$DISK" mklabel gpt
	PART_ESP=""
	PART_BOOT=""
	PART_CRYPT=""
	PART_ROOT=""
	if [ "${ENCRYPT_DISK:-0}" -eq 1 ]; then
		# Unencrypted /boot so GRUB can read kernel+initramfs without cryptodisk.
		if is_efi; then
			parted -s "$DISK" mkpart ESP fat32 1MiB 513MiB
			parted -s "$DISK" set 1 esp on
			parted -s "$DISK" mkpart boot ext4 513MiB 1537MiB
			parted -s "$DISK" mkpart luks 1537MiB 100%
			PART_ESP=$(part_path "$DISK" 1)
			PART_BOOT=$(part_path "$DISK" 2)
			PART_CRYPT=$(part_path "$DISK" 3)
		else
			parted -s "$DISK" mkpart bios_grub 1MiB 2MiB
			parted -s "$DISK" set 1 bios_grub on
			parted -s "$DISK" mkpart boot ext4 2MiB 1026MiB
			parted -s "$DISK" mkpart luks 1026MiB 100%
			PART_BOOT=$(part_path "$DISK" 2)
			PART_CRYPT=$(part_path "$DISK" 3)
		fi
		sleep 1; udevadm settle 2>/dev/null || sleep 2
		[ -n "$PART_ESP" ] && mkfs.vfat -F32 -n EFI "$PART_ESP"
		mkfs.ext4 -F -L atelier-boot "$PART_BOOT"
		luks_format_and_open
		mkfs.ext4 -F -L atelier-root "$PART_ROOT"
	elif is_efi; then
		parted -s "$DISK" mkpart ESP fat32 1MiB 513MiB
		parted -s "$DISK" set 1 esp on
		parted -s "$DISK" mkpart root ext4 513MiB 100%
		PART_ESP=$(part_path "$DISK" 1)
		PART_ROOT=$(part_path "$DISK" 2)
		sleep 1; udevadm settle 2>/dev/null || sleep 2
		mkfs.vfat -F32 -n EFI "$PART_ESP"
		mkfs.ext4 -F -L atelier-root "$PART_ROOT"
	else
		parted -s "$DISK" mkpart bios_grub 1MiB 2MiB
		parted -s "$DISK" set 1 bios_grub on
		parted -s "$DISK" mkpart root ext4 2MiB 100%
		PART_ROOT=$(part_path "$DISK" 2)
		sleep 1; udevadm settle 2>/dev/null || sleep 2
		mkfs.ext4 -F -L atelier-root "$PART_ROOT"
	fi
	log "Partitions: esp=${PART_ESP:-none} boot=${PART_BOOT:-none} crypt=${PART_CRYPT:-none} root=$PART_ROOT"
}

mount_target() {
	mkdir -p "$TARGETDIR"
	mount "$PART_ROOT" "$TARGETDIR"
	if [ -n "${PART_BOOT:-}" ]; then
		mkdir -p "$TARGETDIR/boot"
		mount "$PART_BOOT" "$TARGETDIR/boot"
	fi
	if [ -n "${PART_ESP:-}" ]; then
		mkdir -p "$TARGETDIR/boot/efi"
		mount "$PART_ESP" "$TARGETDIR/boot/efi"
	fi
	for d in dev proc sys run; do
		mkdir -p "$TARGETDIR/$d"
		mount --rbind "/$d" "$TARGETDIR/$d"
		mount --make-rslave "$TARGETDIR/$d" 2>/dev/null || true
	done
}

write_fstab() {
	local uuid_root uuid_esp uuid_boot
	# Root UUID is the ext4 filesystem (mapper when encrypted), not the LUKS container.
	uuid_root=$(blkid -s UUID -o value "$PART_ROOT")
	{
		printf '# /etc/fstab - generated by atelier-install\n'
		printf 'UUID=%s / ext4 defaults 0 1\n' "$uuid_root"
		if [ -n "${PART_BOOT:-}" ]; then
			uuid_boot=$(blkid -s UUID -o value "$PART_BOOT")
			printf 'UUID=%s /boot ext4 defaults 0 2\n' "$uuid_boot"
		fi
		if [ -n "${PART_ESP:-}" ]; then
			uuid_esp=$(blkid -s UUID -o value "$PART_ESP")
			printf 'UUID=%s /boot/efi vfat defaults 0 2\n' "$uuid_esp"
		fi
		printf 'tmpfs /tmp tmpfs defaults,nosuid,nodev 0 0\n'
	} >"$TARGETDIR/etc/fstab"
}

write_crypttab() {
	[ "${ENCRYPT_DISK:-0}" -eq 1 ] || return 0
	local uuid
	uuid=$(blkid -s UUID -o value "$PART_CRYPT")
	[ -n "$uuid" ] || die "Could not read LUKS UUID from $PART_CRYPT"
	{
		printf '# /etc/crypttab - generated by atelier-install\n'
		printf '%s UUID=%s none luks\n' "$CRYPT_NAME" "$uuid"
	} >"$TARGETDIR/etc/crypttab"
	chmod 600 "$TARGETDIR/etc/crypttab"
	log "crypttab $CRYPT_NAME UUID=$uuid"
}

write_dracut_crypt() {
	[ "${ENCRYPT_DISK:-0}" -eq 1 ] || return 0
	mkdir -p "$TARGETDIR/etc/dracut.conf.d"
	{
		printf '# generated by atelier-install (keep surrounding spaces in += values)\n'
		printf 'add_dracutmodules+=" crypt "\n'
		printf 'install_items+=" /etc/crypttab "\n'
		# USB HID at the LUKS prompt. hid-asus rebinds ASUS N-KEY 0b05:19b6
		# (ITE 8910) and a failed vendor GET_REPORT (-75) leaves the
		# laptop keyboard dead until switch-root. Keep hid-generic.
		printf 'force_drivers+=" xhci_pci xhci_hcd usbhid hid hid_generic "\n'
		printf 'omit_drivers+=" hid_asus "\n'
	} >"$TARGETDIR/etc/dracut.conf.d/10-atelier-crypt.conf"
}

configure_grub_crypt() {
	[ "${ENCRYPT_DISK:-0}" -eq 1 ] || return 0
	local uuid extra grub="$TARGETDIR/etc/default/grub"
	uuid=$(blkid -s UUID -o value "$PART_CRYPT")
	[ -n "$uuid" ] || die "Could not read LUKS UUID from $PART_CRYPT"
	# rd.luks.uuid = LUKS container (not the inner ext4). rd.luks.name
	# keeps the mapper at /dev/mapper/cryptroot to match crypttab.
	extra="rd.luks.uuid=${uuid} rd.luks.name=${uuid}=${CRYPT_NAME}"
	mkdir -p "$(dirname "$grub")"
	if [ ! -f "$grub" ]; then
		printf 'GRUB_CMDLINE_LINUX_DEFAULT="loglevel=4 %s"\n' "$extra" >"$grub"
		log "GRUB $extra"
		return 0
	fi
	if grep -q 'rd.luks.uuid=' "$grub"; then
		sed -i -e "s/rd.luks.uuid=[^ \"']*/rd.luks.uuid=${uuid}/g" \
			-e "s/rd.luks.name=[^ \"']*/rd.luks.name=${uuid}=${CRYPT_NAME}/g" "$grub"
	elif grep -q '^GRUB_CMDLINE_LINUX_DEFAULT=' "$grub"; then
		sed -i -e "/^GRUB_CMDLINE_LINUX_DEFAULT=/s/\"[[:space:]]*$/ ${extra}\"/" "$grub"
	fi
	if ! grep -q 'rd.luks.uuid=' "$grub"; then
		printf 'GRUB_CMDLINE_LINUX_DEFAULT="loglevel=4 %s"\n' "$extra" >>"$grub"
	fi
	log "GRUB $extra"
}

# Swapfile + resume= for hibernation. Prefer atelier-setup-swap (live or
# target); inline fallback keeps the option working without atelier-config.
setup_swapfile() {
	[ "${CREATE_SWAP:-0}" -eq 1 ] || return 0
	log "Setting up swapfile for hibernation"
	if have atelier-setup-swap; then
		ATELIER_TARGET="$TARGETDIR" atelier-setup-swap --yes >>"$LOG" 2>&1 \
			|| die "swapfile setup failed (see $LOG)"
		return 0
	fi
	if [ -x "$TARGETDIR/usr/bin/atelier-setup-swap" ]; then
		chroot "$TARGETDIR" /usr/bin/atelier-setup-swap --yes >>"$LOG" 2>&1 \
			|| die "swapfile setup failed (see $LOG)"
		return 0
	fi
	setup_swapfile_inline
}

# PAM gnome-keyring on TTY login / passwd. Helper lives in atelier-config.
setup_keyring() {
	log "Enabling gnome-keyring PAM unlock"
	if have atelier-setup-keyring; then
		ATELIER_TARGET="$TARGETDIR" atelier-setup-keyring >>"$LOG" 2>&1 || \
			log "WARN: atelier-setup-keyring failed (see $LOG)"
		return 0
	fi
	if [ -x "$TARGETDIR/usr/bin/atelier-setup-keyring" ]; then
		chroot "$TARGETDIR" /usr/bin/atelier-setup-keyring >>"$LOG" 2>&1 || \
			log "WARN: atelier-setup-keyring failed (see $LOG)"
		return 0
	fi
	log "WARN: atelier-setup-keyring not found; after reboot: sudo atelier-setup-keyring"
}

setup_swapfile_inline() {
	local swapfile="$TARGETDIR/swapfile" gib size_bytes uuid offset avail
	local fstab="$TARGETDIR/etc/fstab" grub="$TARGETDIR/etc/default/grub"
	local dracut_conf="$TARGETDIR/etc/dracut.conf.d/20-atelier-resume.conf"
	local resume_arg dracut_mods
	have mkswap || die "mkswap is required for a swapfile"
	have filefrag || die "filefrag (e2fsprogs) is required for a swapfile"
	gib=$(swap_size_gib)
	size_bytes=$((gib * 1073741824))
	uuid=$(blkid -s UUID -o value "$PART_ROOT")
	[ -n "$uuid" ] || die "Could not read root UUID from $PART_ROOT"
	avail=$(df -B1 --output=avail "$TARGETDIR" | tail -n 1)
	avail=$(printf '%s' "$avail" | tr -d ' ')
	[ $((avail + 0)) -ge $((size_bytes + 67108864)) ] || \
		die "Not enough free space on the target for a ${gib}GiB swapfile"
	log "creating /swapfile (${gib}GiB) on target"
	rm -f "$swapfile"
	mkswap --file --size "$size_bytes" "$swapfile"
	chmod 600 "$swapfile"
	offset=$(filefrag -v -b"$(getconf PAGESIZE)" "$swapfile" | awk '
		/^[[:space:]]*0:/ { gsub(/\./, "", $4); print $4; exit }
	')
	case $offset in
	''|*[!0-9]*) die "could not read resume_offset from filefrag" ;;
	esac
	log "resume_offset=$offset"
	if ! grep -qE '^[[:space:]]*/swapfile[[:space:]]' "$fstab"; then
		printf '\n# swapfile for hibernation (atelier-install)\n/swapfile none swap sw 0 0\n' \
			>>"$fstab"
	fi
	resume_arg="UUID=${uuid}"
	dracut_mods=" resume "
	if [ "${ENCRYPT_DISK:-0}" -eq 1 ]; then
		resume_arg="/dev/mapper/cryptroot"
		dracut_mods=" crypt resume "
	fi
	mkdir -p "$(dirname "$dracut_conf")"
	{
		printf '# generated by atelier-install (keep surrounding spaces in += values)\n'
		printf 'add_dracutmodules+="%s"\n' "$dracut_mods"
	} >"$dracut_conf"
	mkdir -p "$(dirname "$grub")"
	if [ ! -f "$grub" ]; then
		printf 'GRUB_CMDLINE_LINUX_DEFAULT="loglevel=4 resume=%s resume_offset=%s"\n' \
			"$resume_arg" "$offset" >"$grub"
	else
		if ! grep -q '^GRUB_CMDLINE_LINUX_DEFAULT=' "$grub"; then
			printf 'GRUB_CMDLINE_LINUX_DEFAULT="loglevel=4"\n' >>"$grub"
		fi
		sed -i \
			-e 's/[[:space:]]*resume=UUID=[^ "]*//g' \
			-e 's/[[:space:]]*resume=[^ "]*//g' \
			-e 's/[[:space:]]*resume_offset=[^ "]*//g' \
			"$grub"
		sed -i -e "/^GRUB_CMDLINE_LINUX_DEFAULT=/s#\"[[:space:]]*\$# resume=${resume_arg} resume_offset=${offset}\"#" \
			"$grub"
		if ! grep -q 'resume=' "$grub"; then
			printf 'GRUB_CMDLINE_LINUX_DEFAULT="loglevel=4 resume=%s resume_offset=%s"\n' \
				"$resume_arg" "$offset" >>"$grub"
		fi
	fi
	log "GRUB resume=${resume_arg} resume_offset=$offset"
	mkdir -p "$TARGETDIR/etc/elogind/sleep.conf.d" \
		"$TARGETDIR/etc/elogind/logind.conf.d"
	{
		printf '# generated by atelier-install\n'
		printf '[Sleep]\n'
		printf 'HibernateDelaySec=30min\n'
	} >"$TARGETDIR/etc/elogind/sleep.conf.d/20-atelier-hibernate.conf"
	{
		printf '# generated by atelier-install\n'
		printf '[Login]\n'
		printf 'HandleLidSwitch=suspend-then-hibernate\n'
		printf 'HandleLidSwitchExternalPower=suspend-then-hibernate\n'
	} >"$TARGETDIR/etc/elogind/logind.conf.d/20-atelier-hibernate.conf"
	log "elogind suspend-then-hibernate after 30min"
}

copy_install_log() {
	LOG_COPIED=0
	if [ -d "$TARGETDIR" ] && [ -f "$LOG" ]; then
		mkdir -p "$TARGETDIR/var/log"
		if cp -a "$LOG" "$TARGETDIR/var/log/atelier-install.log"; then
			LOG_COPIED=1
			log "copied install log to target /var/log/atelier-install.log"
		else
			log "WARN: could not copy install log onto the target"
		fi
	fi
}

regenerate_initramfs() {
	local need_crypt=0 need_nvidia=0 need_resume=0 dracut_bin=""
	[ "${ENCRYPT_DISK:-0}" -eq 1 ] && need_crypt=1
	# reconfigure-failed still means the nvidia package is on disk.
	case ${NVIDIA_INSTALL_STATUS:-} in
	ok|reconfigure-failed) need_nvidia=1 ;;
	esac
	[ "${CREATE_SWAP:-0}" -eq 1 ] && need_resume=1
	[ "$need_crypt" -eq 1 ] || [ "$need_nvidia" -eq 1 ] || [ "$need_resume" -eq 1 ] || return 0
	# Must run AFTER crypttab + dracut snippet exist; install_packages
	# reconfigures linux too early (no crypttab yet).
	# Do not use `chroot command -v`: command is a shell builtin, not a binary.
	if [ -x "$TARGETDIR/usr/bin/dracut" ]; then
		dracut_bin=/usr/bin/dracut
	elif [ -x "$TARGETDIR/usr/sbin/dracut" ]; then
		dracut_bin=/usr/sbin/dracut
	elif [ "$need_crypt" -eq 1 ] || [ "$need_resume" -eq 1 ]; then
		die "dracut not found on target; cannot build LUKS/resume initramfs"
	else
		log "WARN: dracut not found; nouveau blacklist may not apply in initramfs"
		return 0
	fi
	log "Regenerating initramfs ($dracut_bin)"
	chroot "$TARGETDIR" "$dracut_bin" --force --regenerate-all >>"$LOG" 2>&1
}

install_packages() {
	log "Installing packages into $TARGETDIR"
	mkdir -p "$TARGETDIR/var/db/xbps/keys" "$TARGETDIR/usr/share" "$TARGETDIR/etc"
	[ -d /var/db/xbps/keys ] && cp -a /var/db/xbps/keys/. "$TARGETDIR/var/db/xbps/keys/" || true
	[ -d /usr/share/xbps.d ] && cp -a /usr/share/xbps.d "$TARGETDIR/usr/share/" || true

	local REPO_ARGS=(--repository="$VOID_REPO")
	if [ -d "$ATELIER_REPO_LIVE" ] && ls "$ATELIER_REPO_LIVE"/*.xbps >/dev/null 2>&1; then
		mkdir -p "$TARGETDIR/usr/share/atelier/repo"
		cp -a "$ATELIER_REPO_LIVE"/. "$TARGETDIR/usr/share/atelier/repo/"
		mkdir -p "$TARGETDIR/etc/xbps.d"
		printf 'repository=/usr/share/atelier/repo\n' >"$TARGETDIR/etc/xbps.d/10-repository-atelier.conf"
		REPO_ARGS+=(--repository="$ATELIER_REPO_LIVE")
	else
		log "WARN: personal repo missing at $ATELIER_REPO_LIVE"
	fi

	# Primary + nonfree mirrors. void-repo-nonfree is always installed.
	# dropbox is not in the base list; the preset PACKAGES line adds it.
	# /etc/xbps.d files with the same names replace the repo-default URLs
	# that the xbps and void-repo-* packages install under /usr/share/xbps.d.
	write_mirror_repos
	REPO_ARGS+=(--repository="$VOID_NONFREE_REPO")

	# GraeWolf personal packages (brave-origin, ...) - live medium + package ship conf+key
	if [ -f /etc/xbps.d/20-repository-graewolf.conf ]; then
		cp -a /etc/xbps.d/20-repository-graewolf.conf \
			"$TARGETDIR/etc/xbps.d/20-repository-graewolf.conf"
		REPO_ARGS+=(--repository="https://github.com/GraeWolf/void-repo/releases/download/x86_64")
	fi

	local pkgs=(
		base-system linux sudo dbus elogind NetworkManager polkit
		void-repo-nonfree
		xdg-user-dirs xdg-user-dirs-gtk
	)
	if [ "${INSTALL_BOOTLOADER:-1}" -eq 1 ]; then
		if is_efi; then pkgs+=(grub-x86_64-efi grub efibootmgr dosfstools)
		else pkgs+=(grub); fi
	else
		is_efi && pkgs+=(dosfstools)
	fi
	if [ "${ENCRYPT_DISK:-0}" -eq 1 ]; then
		# linux-base already pulls dracut; list it so the LUKS path is explicit.
		pkgs+=(cryptsetup dracut)
	fi
	if [ "${CREATE_SWAP:-0}" -eq 1 ]; then
		pkgs+=(dracut)
	fi

	if [ -d "$ATELIER_REPO_LIVE" ] && xbps-query --repository="$ATELIER_REPO_LIVE" -R atelier-desktop >/dev/null 2>&1; then
		pkgs+=(atelier-desktop)
	else
		log "WARN: atelier-desktop not in personal repo"
	fi

	# XLibre is required. The repo package drops the xbps.d snippet and
	# the public key; the xlibre metapackage itself is installed after
	# that file exists. xinit does not depend on an X server.
	if ! xbps-query --repository="$ATELIER_REPO_LIVE" -R atelier-xlibre-repo >/dev/null 2>&1; then
		die "atelier-xlibre-repo is not in the personal repo at $ATELIER_REPO_LIVE.
XLibre is required and there is no X.Org fallback."
	fi
	pkgs+=(atelier-xlibre-repo)

	# Preset extra packages (dropbox by default). Preflight already
	# required each name to exist. They join this transaction so a
	# removed preset entry is not installed behind the user's back.
	if [ "${#PKG_EXTRA[@]}" -gt 0 ]; then
		pkgs+=("${PKG_EXTRA[@]}")
		log "preset extra packages: ${PKG_EXTRA[*]}"
	fi

	log "xbps-install ${pkgs[*]}"
	if ! xbps-install -r "$TARGETDIR" -SyU "${REPO_ARGS[@]}" "${pkgs[@]}" 2>&1 | tee -a "$LOG"; then
		die "Base package installation failed."
	fi

	# NVIDIA is a separate transaction so a DKMS/driver failure cannot
	# roll back the rest of the system. Failure stays non-fatal, but it
	# is recorded for the result screen (not only the log).
	NVIDIA_INSTALL_STATUS=skipped
	if [ "${INSTALL_NVIDIA:-0}" -eq 1 ]; then
		NVIDIA_INSTALL_STATUS=failed
		local npkgs=(linux-headers nvidia)
		if [ -d "$ATELIER_REPO_LIVE" ] && \
			xbps-query --repository="$ATELIER_REPO_LIVE" -R atelier-nvidia >/dev/null 2>&1; then
			npkgs+=(atelier-nvidia)
		else
			log "WARN: atelier-nvidia not in personal repo"
		fi
		log "xbps-install NVIDIA ${npkgs[*]}"
		if ! xbps-install -r "$TARGETDIR" -SyU "${REPO_ARGS[@]}" "${npkgs[@]}" 2>&1 | tee -a "$LOG"; then
			log "ERROR: NVIDIA package install failed; desktop install will continue"
			log "ERROR: after reboot run: sudo atelier-setup-nvidia"
		elif ! xbps-query -r "$TARGETDIR" nvidia >/dev/null 2>&1; then
			log "ERROR: NVIDIA install command succeeded but xbps-query does not see nvidia"
			log "ERROR: after reboot run: sudo atelier-setup-nvidia"
		else
			NVIDIA_INSTALL_STATUS=ok
			log "NVIDIA packages installed (install command and xbps-query nvidia)"
		fi
	fi

	install_xlibre "${REPO_ARGS[@]}"
	install_gaming "${REPO_ARGS[@]}"

	xbps-reconfigure -r "$TARGETDIR" -f base-files >>"$LOG" 2>&1 || true
	log "xbps-reconfigure -a"
	RECONFIGURE_STATUS=ok
	if ! chroot "$TARGETDIR" xbps-reconfigure -a >>"$LOG" 2>&1; then
		RECONFIGURE_STATUS=failed
		log "ERROR: xbps-reconfigure -a failed"
		if [ "${INSTALL_NVIDIA:-0}" -eq 1 ] && [ "$NVIDIA_INSTALL_STATUS" = ok ]; then
			NVIDIA_INSTALL_STATUS=reconfigure-failed
			log "ERROR: NVIDIA packages are installed but xbps-reconfigure -a failed"
		fi
	fi
}

enable_sv() {
	local sv=$1
	if [ -d "$TARGETDIR/etc/sv/$sv" ]; then
		mkdir -p "$TARGETDIR/etc/runit/runsvdir/default"
		ln -sfn "/etc/sv/$sv" "$TARGETDIR/etc/runit/runsvdir/default/$sv"
		log "enabled service $sv"
	fi
}

# Uncomment one locale in /etc/default/libc-locales.
# Match the name as literal text. A '.' in en_US.UTF-8 must not be a
# regex "any character", or a different locale line can be uncommented.
enable_libc_locale() {
	local file=$1 loc=$2 tmp
	[ -f "$file" ] || return 0
	[ -n "$loc" ] || return 0
	tmp=$(mktemp)
	awk -v loc="$loc" '
		{
			if (substr($0, 1, 1) == "#" &&
				(substr($0, 2) == loc || substr($0, 2, length(loc) + 1) == (loc " "))) {
				sub(/^#/, "")
			}
			print
		}
	' "$file" >"$tmp"
	cat "$tmp" >"$file"
	rm -f "$tmp"
}

configure_system() {
	log "Configuring system"
	printf '%s\n' "$HOSTNAME" >"$TARGETDIR/etc/hostname"
	if [ -e "/usr/share/zoneinfo/$TIMEZONE" ]; then
		ln -sf "/usr/share/zoneinfo/$TIMEZONE" "$TARGETDIR/etc/localtime"
	elif [ -e "$TARGETDIR/usr/share/zoneinfo/$TIMEZONE" ]; then
		chroot "$TARGETDIR" ln -sf "/usr/share/zoneinfo/$TIMEZONE" /etc/localtime
	fi
	if [ -f "$TARGETDIR/etc/default/libc-locales" ]; then
		enable_libc_locale "$TARGETDIR/etc/default/libc-locales" "$LOCALE"
	fi
	printf 'LANG=%s\n' "$LOCALE" >"$TARGETDIR/etc/locale.conf"
	chroot "$TARGETDIR" xbps-reconfigure -f glibc-locales >>"$LOG" 2>&1 || true
	if [ -f "$TARGETDIR/etc/rc.conf" ]; then
		sed -i -e "s|#\?KEYMAP=.*|KEYMAP=$KEYMAP|g" "$TARGETDIR/etc/rc.conf" || true
	fi
	printf 'KEYMAP=%s\n' "$KEYMAP" >"$TARGETDIR/etc/vconsole.conf"
	# No root password. The user is in wheel; sudoers.d/wheel is written below.
	if ! chroot "$TARGETDIR" passwd -l root >>"$LOG" 2>&1; then
		log "WARN: passwd -l root failed; trying usermod -L"
		chroot "$TARGETDIR" usermod -L root >>"$LOG" 2>&1 || die "Could not lock the root account."
	fi
	log "root account locked; $USERNAME will use sudo via wheel"
	local groups="wheel,users,audio,video,input,cdrom,optical,storage,network,floppy"
	chroot "$TARGETDIR" useradd -m -s /bin/bash -G "$groups" "$USERNAME" || true
	printf '%s:%s\n' "$USERNAME" "$USERPASS" | chroot "$TARGETDIR" chpasswd -c SHA512
	# Root is locked, so this file is the only administration path.
	mkdir -p "$TARGETDIR/etc/sudoers.d"
	printf '%%%s ALL=(ALL:ALL) ALL\n' "wheel" >"$TARGETDIR/etc/sudoers.d/wheel"
	chmod 440 "$TARGETDIR/etc/sudoers.d/wheel"

	# XDG user directories (Desktop, Documents, Downloads, ...) for the new user
	if [ -x "$TARGETDIR/usr/bin/xdg-user-dirs-update" ]; then
		log "running xdg-user-dirs-update for $USERNAME"
		chroot "$TARGETDIR" su - "$USERNAME" -c 'xdg-user-dirs-update' >>"$LOG" 2>&1 || \
			log "WARN: xdg-user-dirs-update failed for $USERNAME"
	else
		log "WARN: xdg-user-dirs-update not found on target"
	fi

	setup_keyring

	enable_sv NetworkManager
	enable_sv dbus
	enable_sv elogind
	write_fstab
	write_crypttab
	write_dracut_crypt
	configure_grub_crypt
	setup_swapfile
	regenerate_initramfs
	rm -f "$TARGETDIR/usr/sbin/void-installer" "$TARGETDIR/usr/bin/void-installer" \
		"$TARGETDIR/etc/profile.d/atelier-live.sh" 2>/dev/null || true
}

install_bootloader() {
	[ "${INSTALL_BOOTLOADER:-1}" -eq 1 ] || { log "skipping bootloader"; return 0; }
	log "Installing GRUB on $DISK"
	if is_efi; then
		chroot "$TARGETDIR" grub-install --target=x86_64-efi \
			--efi-directory=/boot/efi --bootloader-id=atelier --recheck >>"$LOG" 2>&1
	else
		chroot "$TARGETDIR" grub-install --target=i386-pc "$DISK" >>"$LOG" 2>&1
	fi
	chroot "$TARGETDIR" grub-mkconfig -o /boot/grub/grub.cfg >>"$LOG" 2>&1
}

cleanup_mounts() {
	log "Unmounting target"
	sync
	umount -R "$TARGETDIR" 2>/dev/null || umount -Rl "$TARGETDIR" 2>/dev/null || true
	close_cryptroot
}

# Copy the log, forget the LUKS passphrase, unmount, close the mapper.
# Safe to call twice (failure path and the EXIT trap).
release_target() {
	if [ "${INSTALL_CLEANED:-0}" -eq 1 ]; then
		return 0
	fi
	INSTALL_CLEANED=1
	copy_install_log
	wipe_luks_pass
	cleanup_mounts
}

begin_phase() {
	INSTALL_PHASE=$1
	log "=== phase: $1 ==="
	# Preflight has its own spinner. Later phases stay on screen with xbps.
	if [ "$1" != preflight ]; then
		ui_phase "$1"
	fi
}

# why is the human reason. cmd is the failing command, or empty when die()
# already explained it. Printed with %s so the log tail is never re-expanded.
format_failure() {
	local phase=$1 why=$2 cmd=$3
	local tail="" footer
	cmd=$(printf '%.160s' "$cmd")
	if [ -f "$LOG" ]; then
		tail=$(tail -n 8 "$LOG" 2>/dev/null || true)
	fi
	if [ "$phase" = "preflight" ]; then
		footer="The disk was not modified."
	else
		footer="Mounts were unmounted and any LUKS mapping was closed."
	fi
	if [ -n "$cmd" ]; then
		printf 'Installation failed during: %s\n\n%s\n\nCommand: %s\n\nLast lines of the log:\n%s\n\n%s\nLog: %s\n' \
			"$phase" "$why" "$cmd" "$tail" "$footer" "$LOG"
	else
		printf 'Installation failed during: %s\n\n%s\n\nLast lines of the log:\n%s\n\n%s\nLog: %s\n' \
			"$phase" "$why" "$tail" "$footer" "$LOG"
	fi
}

# Inherited by functions because of set -E. A command substitution is a
# subshell: exit there only, and let the parent trap report the failure.
on_install_err() {
	if [ "${BASHPID:-$$}" != "${INSTALL_MAIN_PID:-}" ]; then
		exit 1
	fi
	INSTALL_FAIL_CMD=${BASH_COMMAND:-unknown}
	exit 1
}

on_install_exit() {
	local st=$?
	local phase cmd why text
	trap - EXIT ERR INT
	set +e
	INSTALL_TRAPS=0
	ui_spin_end
	if [ "$st" -eq 0 ]; then
		exit 0
	fi
	phase=${INSTALL_PHASE:-unknown}
	cmd=${INSTALL_FAIL_CMD:-}
	why=${INSTALL_FAIL_TEXT:-A command failed.}
	log "FAILED phase=$phase status=$st cmd=${cmd:-none}"
	if [ -n "${INSTALL_FAIL_TEXT:-}" ]; then
		cmd=""
	fi
	text=$(format_failure "$phase" "$why" "$cmd")
	# Log the screen text before release_target copies it.
	log "ERROR: $text"
	release_target
	if [ "${LOG_COPIED:-0}" -eq 1 ]; then
		text="$text
Log copied to the new system as /var/log/atelier-install.log"
	fi
	ui_show_fail "$text"
	exit "$st"
}

install_arm_traps() {
	INSTALL_TRAPS=1
	trap on_install_err ERR
	trap on_install_exit EXIT
}

preflight_require() {
	local t=$1
	if ! have "$t"; then
		die "Required tool '$t' is not installed on the live system."
	fi
	log "preflight: tool $t"
}

preflight_tools() {
	local t
	for t in parted mkfs.ext4 xbps-install xbps-query lsblk blkid mount umount wipefs; do
		preflight_require "$t"
	done
	if [ "${ENCRYPT_DISK:-0}" -eq 1 ]; then
		preflight_require cryptsetup
	fi
	if [ "${CREATE_SWAP:-0}" -eq 1 ]; then
		preflight_require mkswap
		preflight_require filefrag
	fi
}

preflight_firmware() {
	if [ ! -d /sys/firmware ]; then
		die "Cannot detect firmware mode: /sys/firmware is not mounted."
	fi
	if is_efi; then
		FIRMWARE_MODE=UEFI
		preflight_require mkfs.vfat
	else
		FIRMWARE_MODE=BIOS
	fi
	log "preflight: firmware $FIRMWARE_MODE"
}

preflight_nvidia() {
	local sysfs=0
	if compgen -G '/sys/bus/pci/devices/*/vendor' >/dev/null; then
		sysfs=1
	fi
	if ! have lspci && [ "$sysfs" -ne 1 ]; then
		die "Cannot detect a GPU: lspci is missing and /sys/bus/pci is unreadable."
	fi
	if detect_nvidia_gpu; then
		NVIDIA_GPU_DETECTED=1
		log "preflight: NVIDIA GPU detected"
	else
		NVIDIA_GPU_DETECTED=0
		log "preflight: no NVIDIA GPU detected"
	fi
}

# curl and wget are not on the live ISO. timeout(1) is (coreutils in
# base-system). The TCP fallback is what a stock live image uses.
# Every failure names VOID_REPO. A hang becomes a timeout (MIRROR_TIMEOUT).
preflight_network() {
	local url host hostport port rc tool rest
	url="${VOID_REPO%/}/x86_64-repodata"
	rest=${VOID_REPO#*://}
	hostport=${rest%%/*}
	case $hostport in
	*:*)
		host=${hostport%%:*}
		port=${hostport##*:}
		;;
	*)
		host=$hostport
		case $VOID_REPO in
		http://*) port=80 ;;
		*) port=443 ;;
		esac
		;;
	esac
	[ -n "$host" ] || die "Invalid mirror URL: $VOID_REPO"
	case $host in
	*[!A-Za-z0-9._-]*) die "Invalid mirror host: $host" ;;
	esac
	case $port in
	''|*[!0-9]*) die "Invalid mirror port in $VOID_REPO" ;;
	esac
	log "preflight: network check $url (timeout ${MIRROR_TIMEOUT}s)"
	rc=0
	if have curl; then
		tool=curl
		curl -fsI --max-time "$MIRROR_TIMEOUT" -o /dev/null "$url" >>"$LOG" 2>&1 || rc=$?
	elif have wget; then
		tool=wget
		wget -q --spider --timeout="$MIRROR_TIMEOUT" "$url" >>"$LOG" 2>&1 || rc=$?
	elif have timeout; then
		tool=tcp
		timeout "$MIRROR_TIMEOUT" bash -c "echo >/dev/tcp/${host}/${port}" >>"$LOG" 2>&1 || rc=$?
	else
		die "Network check needs curl, wget, or timeout(1).
Void mirror: $VOID_REPO"
	fi
	if [ "$rc" -eq 0 ]; then
		log "preflight: network OK ($VOID_REPO via $tool)"
		return 0
	fi
	if [ "$rc" -eq 124 ] || { [ "$tool" = curl ] && [ "$rc" -eq 28 ]; }; then
		die "Timed out after ${MIRROR_TIMEOUT}s contacting the Void mirror:
$VOID_REPO
Index: $url"
	fi
	die "Could not reach the Void mirror:
$VOID_REPO
Index: $url
($tool status $rc, host $host)"
}

repo_has() {
	local repo=$1 pkg=$2
	local ver="" rc=0
	log "preflight: query $pkg from $repo"
	# xbps-query does not download a remote index unless -M is set
	# (or xbps-install -S has already cached it). Void mirrors are
	# cached on the live ISO; the XLibre GitHub repo is not, so a
	# plain -R query never sees xlibre / xlibre-xserver and -s falls
	# through to the installed atelier-xlibre-repo package.
	# -i uses only this repository. -p pkgver avoids logging the
	# whole package record (that was flooding the failure tail).
	# timeout(1) so a dead mirror cannot hang preflight. 124 is timeout's
	# status. The message names the repository that did not answer.
	if have timeout; then
		ver=$(timeout "$MIRROR_TIMEOUT" xbps-query -M -i --repository="$repo" -R -p pkgver "$pkg" 2>>"$LOG") || rc=$?
	else
		log "preflight: timeout(1) missing; xbps-query has no deadline"
		ver=$(xbps-query -M -i --repository="$repo" -R -p pkgver "$pkg" 2>>"$LOG") || rc=$?
	fi
	if [ "$rc" -eq 124 ]; then
		die "Timed out after ${MIRROR_TIMEOUT}s contacting this repository:
$repo
The check was for package '$pkg'."
	fi
	if [ "$rc" -ne 0 ] || [ -z "$ver" ]; then
		log "preflight: $pkg is not in $repo (xbps-query status ${rc})"
		return 1
	fi
	log "preflight: found $ver"
	return 0
}

# True when the package is visible in Void main, nonfree, the personal
# repo, or the GraeWolf repo when that config is on the live system.
pkg_visible() {
	local p=$1
	if repo_has "$VOID_REPO" "$p"; then
		return 0
	fi
	if repo_has "$VOID_NONFREE_REPO" "$p"; then
		return 0
	fi
	if [ -d "$ATELIER_REPO_LIVE" ] && repo_has "$ATELIER_REPO_LIVE" "$p"; then
		return 0
	fi
	if [ -f /etc/xbps.d/20-repository-graewolf.conf ] && \
		repo_has "https://github.com/GraeWolf/void-repo/releases/download/x86_64" "$p"; then
		return 0
	fi
	return 1
}

preflight_personal_repo() {
	local pkg=""
	if [ ! -d "$ATELIER_REPO_LIVE" ]; then
		die "Personal repository is missing at $ATELIER_REPO_LIVE."
	fi
	for pkg in "$ATELIER_REPO_LIVE"/*.xbps; do
		case $pkg in
		*.sig) continue ;;
		esac
		[ -f "$pkg" ] || continue
		break
	done
	if [ ! -f "$pkg" ]; then
		die "Personal repository at $ATELIER_REPO_LIVE has no packages."
	fi
	if ! repo_has "$ATELIER_REPO_LIVE" atelier-desktop; then
		die "Personal repository did not sync: atelier-desktop is not visible at
$ATELIER_REPO_LIVE"
	fi
	if ! repo_has "$ATELIER_REPO_LIVE" atelier-xlibre-repo; then
		die "Personal repository did not sync: atelier-xlibre-repo is not visible.
XLibre is required and there is no X.Org fallback."
	fi
	log "preflight: personal repo OK ($ATELIER_REPO_LIVE)"
}

# xbps will not sync the XLibre repo until its public key is trusted.
# The key is one file inside atelier-xlibre-repo. Read it with xbps-query
# --cat: libxbps unpacks the zstd package. The live ISO has no zstd CLI,
# and its tar cannot open a .xbps without that CLI. Do not xbps-install
# into an empty root either: that root has no xbps package, so the
# transaction dies with "MISSING: xbps>=0".
ensure_xlibre_key() {
	local dest="/var/db/xbps/keys/$XLIBRE_KEY_NAME"
	local tmpkey=""
	if [ -f "$dest" ]; then
		log "preflight: XLibre public key already trusted"
		return 0
	fi
	if ! xbps-query -i --repository="$ATELIER_REPO_LIVE" -R atelier-xlibre-repo >/dev/null 2>&1; then
		log "preflight: atelier-xlibre-repo is not in $ATELIER_REPO_LIVE"
		return 1
	fi
	mkdir -p /var/db/xbps/keys
	tmpkey=$(mktemp)
	# --cat expects the absolute path stored in the package.
	if xbps-query -i --repository="$ATELIER_REPO_LIVE" \
		--cat "/var/db/xbps/keys/$XLIBRE_KEY_NAME" atelier-xlibre-repo \
		>"$tmpkey" 2>>"$LOG"; then
		if [ -s "$tmpkey" ] && grep -q '<plist' "$tmpkey"; then
			cp -a "$tmpkey" "$dest"
			chmod 644 "$dest"
			rm -f "$tmpkey"
			log "preflight: trusted XLibre public key via xbps-query --cat"
			return 0
		fi
		log "preflight: xbps-query --cat did not return a plist"
	else
		log "preflight: xbps-query --cat failed"
	fi
	rm -f "$tmpkey"
	# Live root already has xbps, so depends=xbps is satisfied. -i skips
	# the other configured repos (void mirror, GraeWolf) for this one package.
	log "preflight: installing atelier-xlibre-repo on the live system"
	if xbps-install -y -i --repository="$ATELIER_REPO_LIVE" atelier-xlibre-repo >>"$LOG" 2>&1 \
		&& [ -f "$dest" ]; then
		log "preflight: trusted XLibre public key via live-system install"
		return 0
	fi
	log "preflight: atelier-xlibre-repo did not provide $dest"
	return 1
}

preflight_void_repos() {
	if ! repo_has "$VOID_REPO" base-system; then
		die "Could not sync the Void main repository (base-system not found):
$VOID_REPO"
	fi
	if ! repo_has "$VOID_REPO" linux; then
		die "Could not sync the Void main repository (linux not found):
$VOID_REPO"
	fi
	# Preset packages are checked before the disk is wiped. The shipped
	# preset lists dropbox, so a missing nonfree index still stops here.
	local extra
	if [ "${#PKG_EXTRA[@]}" -gt 0 ]; then
		for extra in "${PKG_EXTRA[@]}"; do
			if ! pkg_visible "$extra"; then
				die "Could not find preset package '$extra'.
Main:     $VOID_REPO
Nonfree:  $VOID_NONFREE_REPO
Personal: $ATELIER_REPO_LIVE"
			fi
			log "preflight: preset package $extra is available"
		done
	fi
	if [ "${INSTALL_NVIDIA:-0}" -eq 1 ]; then
		if ! repo_has "$VOID_NONFREE_REPO" nvidia; then
			die "NVIDIA drivers were requested, but the nvidia package is not in:
$VOID_NONFREE_REPO"
		fi
		if ! repo_has "$VOID_REPO" linux-headers; then
			die "NVIDIA drivers were requested, but linux-headers is not in:
$VOID_REPO"
		fi
		log "preflight: nvidia and linux-headers are visible"
	fi
	log "preflight: Void main and nonfree repositories synced"
}

# Mirror-relative multilib URLs. void-repo-multilib hardcodes
# repo-default in /usr/share/xbps.d. write_mirror_repos puts the chosen
# mirror in /etc/xbps.d under the same filenames, which XBPS prefers.
multilib_repo() {
	printf '%s\n' "${VOID_REPO%/}/multilib"
}

multilib_nonfree_repo() {
	printf '%s\n' "${VOID_REPO%/}/multilib/nonfree"
}

# 32-bit packages live in multilib. steam lives in nonfree (pkg_visible).
preflight_gaming_pkg() {
	local p=$1 ml=$2 mlnf=$3
	case $p in
	*-32bit)
		repo_has "$ml" "$p" && return 0
		repo_has "$mlnf" "$p" && return 0
		return 1
		;;
	esac
	pkg_visible "$p" && return 0
	repo_has "$ml" "$p" && return 0
	repo_has "$mlnf" "$p" && return 0
	return 1
}

preflight_gaming() {
	local p ml mlnf
	if [ "${INSTALL_GAMING:-0}" -ne 1 ]; then
		log "preflight: gaming off"
		return 0
	fi
	if [ -z "${GAMING_LIST_FILE:-}" ] || [ ! -r "$GAMING_LIST_FILE" ]; then
		die "Gaming is enabled, but the package list is missing.
Expected gaming.txt next to atelier-install, or
/usr/share/atelier/installer/gaming.txt"
	fi
	if [ ${#GAMING_REPO_PKGS[@]} -eq 0 ] || [ ${#GAMING_PKGS[@]} -eq 0 ]; then
		die "Gaming package list is incomplete: $GAMING_LIST_FILE
It needs repo enablers and packages to install."
	fi
	ml=$(multilib_repo)
	mlnf=$(multilib_nonfree_repo)
	for p in "${GAMING_REPO_PKGS[@]}"; do
		if ! repo_has "$VOID_REPO" "$p"; then
			die "Gaming needs '$p' from the Void main repository:
$VOID_REPO"
		fi
		log "preflight: gaming repo package $p is available"
	done
	for p in "${GAMING_PKGS[@]}"; do
		if ! preflight_gaming_pkg "$p" "$ml" "$mlnf"; then
			die "Gaming package '$p' was not found.
Main:             $VOID_REPO
Nonfree:          $VOID_NONFREE_REPO
Multilib:         $ml
Multilib nonfree: $mlnf"
		fi
		log "preflight: gaming package $p is available"
	done
	if [ "${INSTALL_NVIDIA:-0}" -eq 1 ]; then
		if [ ${#GAMING_NVIDIA_PKGS[@]} -eq 0 ]; then
			die "NVIDIA and gaming are both enabled, but $GAMING_LIST_FILE
lists no nvidia packages (expected nvidia-libs-32bit)."
		fi
		for p in "${GAMING_NVIDIA_PKGS[@]}"; do
			if ! repo_has "$mlnf" "$p"; then
				die "Gaming needs '$p' from the multilib nonfree repository:
$mlnf"
			fi
			log "preflight: gaming nvidia package $p is available"
		done
	fi
	log "preflight: gaming packages reachable"
}

preflight_xlibre_repo() {
	if ! ensure_xlibre_key; then
		die "Could not trust the XLibre repository public key from atelier-xlibre-repo in
$ATELIER_REPO_LIVE
There is no X.Org fallback."
	fi
	if ! repo_has "$XLIBRE_REPO" xlibre; then
		die "Could not sync the XLibre repository (package xlibre not found):
$XLIBRE_REPO
There is no X.Org fallback."
	fi
	if ! repo_has "$XLIBRE_REPO" xlibre-xserver; then
		die "The XLibre repository has no xlibre-xserver package.
xinit does not install an X server, and there is no X.Org fallback."
	fi
	log "preflight: XLibre repository synced"
}

preflight_checks() {
	log "preflight: starting (disk not touched yet)"
	if [ "${INSTALL_XLIBRE:-0}" -ne 1 ]; then
		die "XLibre is required and there is no X.Org fallback."
	fi
	ui_spin_begin "Checking mirror, tools, and repositories"
	preflight_tools
	preflight_firmware
	preflight_nvidia
	preflight_network
	preflight_personal_repo
	preflight_void_repos
	preflight_gaming
	preflight_xlibre_repo
	ui_spin_end
	log "preflight: OK firmware=$FIRMWARE_MODE nvidia_gpu=$NVIDIA_GPU_DETECTED gaming=$INSTALL_GAMING mirror=$VOID_REPO"
}

# Same basenames as /usr/share/xbps.d from the xbps package and from
# void-repo-nonfree / void-repo-multilib / void-repo-multilib-nonfree.
# XBPS reads /etc/xbps.d first and skips a system file it has already seen.
write_mirror_repos() {
	local ml mlnf dir
	ml=$(multilib_repo)
	mlnf=$(multilib_nonfree_repo)
	dir="$TARGETDIR/etc/xbps.d"
	mkdir -p "$dir"
	{
		printf '# Overrides /usr/share/xbps.d/00-repository-main.conf\n'
		printf 'repository=%s\n' "$VOID_REPO"
	} >"$dir/00-repository-main.conf"
	{
		printf '# Overrides /usr/share/xbps.d/10-repository-nonfree.conf\n'
		printf 'repository=%s\n' "$VOID_NONFREE_REPO"
	} >"$dir/10-repository-nonfree.conf"
	{
		printf '# Overrides /usr/share/xbps.d/10-repository-multilib.conf\n'
		printf 'repository=%s\n' "$ml"
	} >"$dir/10-repository-multilib.conf"
	{
		printf '# Overrides /usr/share/xbps.d/10-repository-multilib-nonfree.conf\n'
		printf 'repository=%s\n' "$mlnf"
	} >"$dir/10-repository-multilib-nonfree.conf"
	log "mirror repos main=$VOID_REPO nonfree=$VOID_NONFREE_REPO multilib=$ml nonfree-multilib=$mlnf"
}

target_pkg_installed() {
	xbps-query -r "$TARGETDIR" "$1" >/dev/null 2>&1
}

# Separate transactions, like NVIDIA. Enabling the multilib repos and
# installing packages from them cannot share one xbps transaction: the
# new indexes are not visible until void-repo-multilib is configured.
# Failure is recorded for the result screen and does not roll back
# the desktop. XLibre stays fatal; Steam is optional.
install_gaming() {
	local -a repo_args=("$@")
	local ml mlnf p
	GAMING_INSTALL_STATUS=skipped
	[ "${INSTALL_GAMING:-0}" -eq 1 ] || return 0
	GAMING_INSTALL_STATUS=failed
	if [ ${#GAMING_REPO_PKGS[@]} -eq 0 ] || [ ${#GAMING_PKGS[@]} -eq 0 ]; then
		log "ERROR: gaming package list is empty (${GAMING_LIST_FILE:-missing})"
		return 0
	fi
	ml=$(multilib_repo)
	mlnf=$(multilib_nonfree_repo)
	log "xbps-install gaming repos ${GAMING_REPO_PKGS[*]}"
	if ! xbps-install -r "$TARGETDIR" -SyU "${repo_args[@]}" "${GAMING_REPO_PKGS[@]}" 2>&1 | tee -a "$LOG"; then
		log "ERROR: could not enable multilib repositories"
		return 0
	fi
	for p in "${GAMING_REPO_PKGS[@]}"; do
		if ! target_pkg_installed "$p"; then
			log "ERROR: $p is not installed after the multilib repo transaction"
			return 0
		fi
	done
	write_mirror_repos
	log "xbps-install gaming ${GAMING_PKGS[*]}"
	if ! xbps-install -r "$TARGETDIR" -SyU "${repo_args[@]}" \
		--repository="$ml" --repository="$mlnf" \
		"${GAMING_PKGS[@]}" 2>&1 | tee -a "$LOG"; then
		log "ERROR: Steam and 32-bit graphics packages failed to install"
		return 0
	fi
	for p in "${GAMING_PKGS[@]}"; do
		if ! target_pkg_installed "$p"; then
			log "ERROR: gaming install command succeeded but xbps-query does not see $p"
			return 0
		fi
	done
	GAMING_INSTALL_STATUS=ok
	if [ "${INSTALL_NVIDIA:-0}" -ne 1 ]; then
		log "gaming packages installed"
		return 0
	fi
	if [ ${#GAMING_NVIDIA_PKGS[@]} -eq 0 ]; then
		log "ERROR: no NVIDIA gaming packages in the list"
		GAMING_INSTALL_STATUS=partial
		return 0
	fi
	if ! target_pkg_installed nvidia; then
		log "ERROR: skipping ${GAMING_NVIDIA_PKGS[*]} because nvidia is not installed"
		GAMING_INSTALL_STATUS=partial
		return 0
	fi
	log "xbps-install gaming nvidia ${GAMING_NVIDIA_PKGS[*]}"
	if ! xbps-install -r "$TARGETDIR" -SyU "${repo_args[@]}" \
		--repository="$ml" --repository="$mlnf" \
		"${GAMING_NVIDIA_PKGS[@]}" 2>&1 | tee -a "$LOG"; then
		log "ERROR: 32-bit NVIDIA libraries failed to install"
		GAMING_INSTALL_STATUS=partial
		return 0
	fi
	for p in "${GAMING_NVIDIA_PKGS[@]}"; do
		if ! target_pkg_installed "$p"; then
			log "ERROR: $p is not installed after the gaming NVIDIA transaction"
			GAMING_INSTALL_STATUS=partial
			return 0
		fi
	done
	log "gaming packages installed, including ${GAMING_NVIDIA_PKGS[*]}"
}

# $@ is the xbps --repository arguments for Void, nonfree, and the personal repo.
install_xlibre() {
	if [ ! -f "$TARGETDIR/etc/xbps.d/99-repository-xlibre.conf" ]; then
		die "XLibre repository config is missing on the target (atelier-xlibre-repo).
There is no X.Org fallback."
	fi
	if [ ! -f "$TARGETDIR/var/db/xbps/keys/$XLIBRE_KEY_NAME" ]; then
		die "XLibre signing key is missing on the target.
There is no X.Org fallback."
	fi
	log "xbps-install xlibre (required)"
	if ! xbps-install -r "$TARGETDIR" -SyU "$@" \
		--repository="$XLIBRE_REPO" xlibre 2>&1 | tee -a "$LOG"; then
		die "XLibre package install failed. There is no X.Org fallback."
	fi
	if ! xbps-query -r "$TARGETDIR" xlibre-xserver >/dev/null 2>&1; then
		die "xlibre-xserver is not installed.
The xlibre metapackage did not pull in an X server, and xinit does not provide one."
	fi
	if [ ! -x "$TARGETDIR/usr/bin/Xorg" ] && [ ! -x "$TARGETDIR/usr/bin/X" ]; then
		die "No X server binary on the target (/usr/bin/Xorg or /usr/bin/X).
xinit does not provide an X server, and there is no X.Org fallback."
	fi
	log "XLibre X server is installed on the target"
}

run_install() {
	INSTALL_MAIN_PID=$BASHPID
	INSTALL_CLEANED=0
	INSTALL_FAIL_TEXT=""
	INSTALL_FAIL_CMD=""
	LOG_COPIED=0
	install_arm_traps
	begin_phase preflight

	if [ "${ENCRYPT_DISK:-0}" -eq 1 ]; then
		have cryptsetup || die "cryptsetup is required for disk encryption"
		[ -n "${LUKSPASS:-}" ] || die "LUKS passphrase missing"
	fi

	preflight_checks

	ui_info "Installing... This may take a long time.

Log: $LOG

Do not power off."

	begin_phase partitioning
	partition_disk
	begin_phase mounting
	mount_target
	begin_phase packages
	install_packages
	begin_phase configure
	configure_system
	begin_phase bootloader
	install_bootloader

	trap - ERR
	begin_phase finish
	release_target
	trap - EXIT
	INSTALL_TRAPS=0

	local done_msg="Installation complete.

Reboot into Atelier Linux and remove the live medium.

Log: $LOG"
	if [ "${LOG_COPIED:-0}" -eq 1 ]; then
		done_msg="$done_msg
Also copied to the new system as /var/log/atelier-install.log"
	fi
	if [ "${NVIDIA_INSTALL_STATUS:-}" = failed ]; then
		done_msg="$done_msg

NVIDIA drivers failed to install.
The desktop install was not rolled back.
After reboot: sudo atelier-setup-nvidia
See /var/log/atelier-install.log"
	elif [ "${NVIDIA_INSTALL_STATUS:-}" = reconfigure-failed ]; then
		done_msg="$done_msg

NVIDIA packages were installed, but xbps-reconfigure -a failed.
The kernel module may not be built.
After reboot: sudo atelier-setup-nvidia
See /var/log/atelier-install.log"
	fi
	if [ "${RECONFIGURE_STATUS:-}" = failed ] && [ "${NVIDIA_INSTALL_STATUS:-}" != reconfigure-failed ]; then
		done_msg="$done_msg

xbps-reconfigure -a failed.
Packages may be unpacked but not configured.
See /var/log/atelier-install.log"
	fi
	case ${GAMING_INSTALL_STATUS:-} in
	failed)
		done_msg="$done_msg

Steam was not installed. The rest of the install was kept.
After reboot, with the network up:
sudo xbps-install -S void-repo-multilib void-repo-multilib-nonfree
sudo xbps-install -S steam
See /var/log/atelier-install.log"
		;;
	partial)
		done_msg="$done_msg

Steam was installed, but 32-bit NVIDIA libraries were not.
After reboot: sudo xbps-install -S nvidia-libs-32bit
See /var/log/atelier-install.log"
		;;
	esac
	ui_result "$done_msg"
	if ui_confirm "Reboot now?"; then
		sync
		reboot || telinit 6 2>/dev/null || true
	fi
}

usage() {
	cat <<EOF
Atelier installer v${VERSION} (whole-disk, optional LUKS2, swapfile, Steam)

Usage: atelier-install [options]

  (default)       TUI with gum (live tty and terminal emulators)
  --tui           Force the gum TUI
  --text          Plain prompts on stdin/stderr (no gum)
  --preset FILE   Read settings from FILE instead of /etc/atelier/install.conf
  --dry-run       Walk the prompts, then exit before the disk is touched
  -h, --help      This help

A value set in the preset is not asked. The summary screen can edit it.
Root is locked. The preset user gets sudo via the wheel group.

Live medium: log in as anon / voidlinux, then:
  sudo atelier-install
EOF
}

# --- main wizard loop ---------------------------------------------------------
main() {
	local orig_args=("$@")
	: >"$LOG"
	log "atelier-install $VERSION starting"

	while [ $# -gt 0 ]; do
		case $1 in
		--tui) UI_MODE=tui ;;
		--text) UI_MODE=text ;;
		--dry-run) DRY_RUN=1 ;;
		--preset)
			shift
			[ $# -ge 1 ] || die "--preset needs a file path"
			PRESET_PATH=$1
			;;
		--preset=*)
			PRESET_PATH=${1#--preset=}
			[ -n "$PRESET_PATH" ] || die "--preset needs a file path"
			;;
		-h|--help) usage; exit 0 ;;
		*) die "Unknown option: $1 (try --help)" ;;
		esac
		shift
	done

	select_ui
	log "atelier-install UI_MODE=$UI_MODE UI=$UI DRY_RUN=$DRY_RUN"

	ensure_root "${orig_args[@]}"
	if [ "$DRY_RUN" -eq 0 ]; then
		have parted || die "parted is required"
		have mkfs.ext4 || die "e2fsprogs (mkfs.ext4) is required"
		have xbps-install || die "xbps-install is required"
	fi
	have lsblk || die "util-linux (lsblk) is required"
	if [ "$UI" = "gum" ]; then
		have gum || die "gum is required for TUI mode (Void package: gum)"
		trap ui_on_int INT
	fi
	if [ "$UI" = "none" ]; then
		die "No UI backend (install gum for TUI mode, or pass --text)"
	fi

	if [ -n "$PRESET_PATH" ]; then
		load_preset "$PRESET_PATH"
	elif [ -f /etc/atelier/install.conf ]; then
		load_preset /etc/atelier/install.conf
	else
		log "no preset file; using built-in defaults"
		apply_nvidia_policy || die "Invalid NVIDIA mode '$NVIDIA_MODE'"
		set_mirror "$VOID_REPO"
	fi
	load_gaming_list

	# Disk, hostname and username unless the preset set them, one user
	# password, LUKS only when encryption is on, then summary.
	local steps=(welcome disk names password luks summary)
	local i=0 n=${#steps[@]} rc
	while [ "$i" -ge 0 ] && [ "$i" -lt "$n" ]; do
		rc=0
		case ${steps[$i]} in
		welcome) step_welcome || rc=$? ;;
		disk) step_disk || rc=$? ;;
		names) step_names || rc=$? ;;
		password) step_password || rc=$? ;;
		luks) step_luks || rc=$? ;;
		summary) step_summary || rc=$? ;;
		esac
		log "step ${steps[$i]} rc=$rc"
		case $rc in
		0) NAV=forward; i=$((i + 1)) ;;
		1) NAV=back; i=$((i - 1)); [ "$i" -lt 0 ] && i=0 ;;
		*) log "abort"; exit 1 ;;
		esac
	done

	if [ "$DRY_RUN" -eq 1 ]; then
		log "dry-run: not installing"
		summary_text
		printf 'dry-run: disk was not modified\n'
		exit 0
	fi

	run_install
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
	main "$@"
fi
