edit_gaming() {
	local crc=0
	ui_confirm "Install Steam and 32-bit graphics?

This enables the Void multilib repositories
and installs Steam, Mesa, Vulkan, and libglvnd
for 32-bit games. When NVIDIA drivers are
installed, nvidia-libs-32bit is included.

Yes = install Steam
No  = do not install Steam" || crc=$?
	case $crc in
	0) INSTALL_GAMING=1 ;;
	1) INSTALL_GAMING=0 ;;
	*) return 0 ;;
	esac
	log "INSTALL_GAMING=$INSTALL_GAMING"
}

edit_menu() {
	local field pkgs enc sw grub gs
	if [ ${#PKG_EXTRA[@]} -eq 0 ]; then pkgs="(none)"; else pkgs="${PKG_EXTRA[*]}"; fi
	if [ "$ENCRYPT_DISK" -eq 1 ]; then enc=yes; else enc=no; fi
