#!/usr/bin/env bash
# Atelier Linux - graphical installer (wizard, whole-disk MVP)
# Back/Next steps, ASCII-only UI strings for yad safety.
set -euo pipefail

VERSION="0.2.0"
TITLE="Atelier Installer"
TARGETDIR="${TARGETDIR:-/mnt/atelier-target}"
LOG="${LOG:-/tmp/atelier-install.log}"
VOID_REPO="${VOID_REPO:-https://repo-default.voidlinux.org/current}"
VOID_NONFREE_REPO="${VOID_NONFREE_REPO:-https://repo-default.voidlinux.org/current/nonfree}"
ATELIER_REPO_LIVE="${ATELIER_REPO_LIVE:-/usr/share/atelier/repo}"

# State (wizard)
INSTALL_NVIDIA=0
INSTALL_XLIBRE=0
INSTALL_BOOTLOADER=1
PKG_EXTRA_CLI=0
PKG_MEDIA=0
DISK=""
HOSTNAME="atelier"
USERNAME="user"
USERPASS=""
ROOTPASS=""
TIMEZONE="UTC"
LOCALE="en_US.UTF-8"
KEYMAP="us"
PART_ESP=""
PART_ROOT=""

# --- locale / GUI env ---------------------------------------------------------
ensure_gui_env() {
	if [ -z "${LANG:-}" ] || [ "$LANG" = "C" ] || [ "$LANG" = "POSIX" ]; then
		if locale -a 2>/dev/null | grep -qiE 'en_US\.utf-?8'; then
			export LANG=en_US.UTF-8
		else
			export LANG=C.UTF-8
		fi
	fi
	export LC_ALL="${LC_ALL:-$LANG}"
	export LC_CTYPE="${LC_CTYPE:-$LANG}"
	if [ -z "${XDG_RUNTIME_DIR:-}" ] || [ ! -d "${XDG_RUNTIME_DIR}" ] || [ ! -w "${XDG_RUNTIME_DIR}" ]; then
		if [ -d "/run/user/$(id -u)" ] && [ -w "/run/user/$(id -u)" ]; then
			export XDG_RUNTIME_DIR="/run/user/$(id -u)"
		else
			export XDG_RUNTIME_DIR="${TMPDIR:-/tmp}/runtime-$(id -u)"
			mkdir -p "$XDG_RUNTIME_DIR"
			chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true
		fi
	fi
}
ensure_gui_env

# --- helpers ------------------------------------------------------------------
die() { ui_error "$*"; exit 1; }
log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$LOG"; }
have() { command -v "$1" >/dev/null 2>&1; }

UI=none
if have yad; then UI=yad
elif have zenity; then UI=zenity
elif have dialog; then UI=dialog
fi

yad_run() { yad --title="$TITLE" --center --on-top "$@"; }

ui_error() {
	local msg=$1
	log "ERROR: $msg"
	case $UI in
	yad) yad_run --error --text="$msg" --width=480 --button=OK:0 2>/dev/null || true ;;
	zenity) zenity --title="$TITLE" --error --text="$msg" --width=480 2>/dev/null || true ;;
	dialog) dialog --title "$TITLE" --msgbox "$msg" 10 60 ;;
	*) printf 'ERROR: %s\n' "$msg" >&2 ;;
	esac
}

ui_info() {
	local msg=$1
	case $UI in
	yad) yad_run --info --text="$msg" --width=480 --button=OK:0 ;;
	zenity) zenity --title="$TITLE" --info --text="$msg" --width=480 ;;
	dialog) dialog --title "$TITLE" --msgbox "$msg" 12 60 ;;
	*) printf '%s\n' "$msg" ;;
	esac
}

# Returns: 0=yes/next/ok, 1=no/back, 2=abort (close)
ui_confirm() {
	local msg=$1
	case $UI in
	yad) yad_run --text="$msg" --width=520 --button="No:1" --button="Yes:0" ;;
	zenity) zenity --title="$TITLE" --question --text="$msg" --width=520 --ok-label=Yes --cancel-label=No ;;
	dialog) dialog --title "$TITLE" --yesno "$msg" 12 60 ;;
	*) printf '%s [y/N] ' "$msg" >&2; read -r a; case $a in y|Y|yes|YES) return 0;; *) return 1;; esac ;;
	esac
}

# Wizard page: text + Back/Next. 0=next 1=back 2=abort
wizard_page() {
	local msg=$1
	local rc=0
	case $UI in
	yad)
		yad_run --text="$msg" --width=560 --height=280 \
			--button="Abort:2" --button="Back:1" --button="Next:0" || rc=$?
		;;
	zenity)
		# zenity has no native 3-button; Next via question "Continue?"
		if zenity --title="$TITLE" --question --text="$msg" --width=560 \
			--ok-label="Next" --cancel-label="Back"; then
			rc=0
		else
			rc=1
		fi
		;;
	dialog)
		dialog --title "$TITLE" --yes-label Next --no-label Back --yesno "$msg" 16 70 && rc=0 || rc=1
		;;
	*)
		printf '%s\n[Enter]=Next [b]=Back [q]=Abort: ' "$msg" >&2
		read -r a
		case $a in b|B) rc=1;; q|Q) rc=2;; *) rc=0;; esac
		;;
	esac
	return "$rc"
}

ui_entry() {
	local label=$1 default=${2:-}
	case $UI in
	yad) yad_run --entry --text="$label" --entry-text="$default" --width=420 --button=Cancel:1 --button=OK:0 ;;
	zenity) zenity --title="$TITLE" --entry --text="$label" --entry-text="$default" --width=420 ;;
	dialog)
		dialog --title "$TITLE" --inputbox "$label" 10 50 "$default" 2>/tmp/atelier-entry.$$
		cat /tmp/atelier-entry.$$; rm -f /tmp/atelier-entry.$$
		;;
	*) printf '%s [%s]: ' "$label" "$default" >&2; read -r a; printf '%s\n' "${a:-$default}" ;;
	esac
}

ui_password() {
	local label=$1
	case $UI in
	yad) yad_run --entry --hide-text --text="$label" --width=420 --button=Cancel:1 --button=OK:0 ;;
	zenity) zenity --title="$TITLE" --password --text="$label" --width=420 ;;
	dialog)
		dialog --title "$TITLE" --passwordbox "$label" 10 50 2>/tmp/atelier-pw.$$
		cat /tmp/atelier-pw.$$; rm -f /tmp/atelier-pw.$$
		;;
	*) printf '%s: ' "$label" >&2; stty -echo; read -r a; stty echo; printf '\n%s\n' "$a" >&2; printf '%s\n' "$a" ;;
	esac
}

# List pick: returns selected first column. Args after text: pairs id detail
ui_list_pick() {
	local text=$1; shift
	case $UI in
	yad)
		yad_run --list --text="$text" --width=640 --height=400 \
			--column=Id --column=Details --print-column=1 --hide-column=1 \
			--button=Cancel:1 --button=OK:0 "$@" 2>/dev/null | awk -F'|' 'NF{print $1; exit}'
		;;
	zenity)
		zenity --title="$TITLE" --list --text="$text" --width=640 --height=400 \
			--column=Id --column=Details --print-column=1 --hide-column=1 "$@" 2>/dev/null
		;;
	dialog)
		local items=()
		while [ $# -ge 2 ]; do items+=("$1" "$2"); shift 2; done
		dialog --title "$TITLE" --menu "$text" 20 70 12 "${items[@]}" 2>/tmp/atelier-pick.$$
		cat /tmp/atelier-pick.$$; rm -f /tmp/atelier-pick.$$
		;;
	*) printf '%s\n' "$text" >&2; printf '%s\n' "$@" >&2; read -r a; printf '%s\n' "$a" ;;
	esac
}

# Checklist: print selected tags one per line. Args: TAG "Label" on/off ...
ui_checklist() {
	local text=$1; shift
	case $UI in
	yad)
		# yad checklist: column CHK + TAG + Label; print checked tags
		local args=() t l s
		while [ $# -ge 3 ]; do
			t=$1; l=$2; s=$3; shift 3
			if [ "$s" = on ]; then args+=(TRUE "$t" "$l"); else args+=(FALSE "$t" "$l"); fi
		done
		yad_run --list --checklist --text="$text" --width=560 --height=320 \
			--column=Pick --column=Tag --column=Option --print-column=2 --separator='\n' \
			--button=Cancel:1 --button=OK:0 "${args[@]}" 2>/dev/null | sed '/^$/d'
		;;
	zenity)
		local args=() t l s
		while [ $# -ge 3 ]; do
			t=$1; l=$2; s=$3; shift 3
			if [ "$s" = on ]; then args+=(TRUE "$t" "$l"); else args+=(FALSE "$t" "$l"); fi
		done
		zenity --title="$TITLE" --list --checklist --text="$text" --width=560 --height=320 \
			--column=Pick --column=Tag --column=Option --print-column=2 --separator='\n' \
			"${args[@]}" 2>/dev/null | sed '/^$/d'
		;;
	*)
		# fallback: all off unless previously set - return empty
		printf ''
		;;
	esac
}

ensure_root() {
	if [ "$(id -u)" -eq 0 ]; then return 0; fi
	if have pkexec; then
		exec pkexec env \
			DISPLAY="${DISPLAY:-}" XAUTHORITY="${XAUTHORITY:-}" \
			XAUTHLOCALHOSTNAME="${XAUTHLOCALHOSTNAME:-}" \
			WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" \
			XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}" \
			DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-}" \
			LANG="${LANG:-C.UTF-8}" LC_ALL="${LC_ALL:-${LANG:-C.UTF-8}}" \
			"$0" "$@"
	fi
	if have sudo; then
		exec sudo --preserve-env=DISPLAY,XAUTHORITY,WAYLAND_DISPLAY,XDG_RUNTIME_DIR,DBUS_SESSION_BUS_ADDRESS,LANG,LC_ALL \
			"$0" "$@"
	fi
	die "Root privileges required (pkexec or sudo)."
}

is_efi() { [ -d /sys/firmware/efi ]; }

part_path() {
	local disk=$1 num=$2 base
	base=$(basename "$disk")
	if printf '%s' "$base" | grep -qE '[0-9]$'; then printf '%s\n' "${disk}p${num}"
	else printf '%s\n' "${disk}${num}"; fi
}

list_disks() {
	lsblk -dn -b -o NAME,SIZE,TYPE,MODEL 2>/dev/null | while read -r name size type model; do
		[ "$type" = "disk" ] || continue
		case $name in loop*|ram*|zram*|sr*) continue ;; esac
		model=${model:-disk}
		hs=$(lsblk -dn -o SIZE "/dev/$name" 2>/dev/null || echo "?")
		printf '%s|%s|%s\n' "/dev/$name" "$hs" "$model"
	done
}

detect_nvidia_gpu() {
	have lspci && lspci -nn 2>/dev/null | grep -qi nvidia
}

valid_hostname() {
	local h=$1
	printf '%s' "$h" | grep -qE '^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$'
}

valid_username() {
	local u=$1
	[ "$u" != "root" ] || return 1
	printf '%s' "$u" | grep -qE '^[a-z_][a-z0-9_-]{0,31}$'
}

list_timezones() {
	if have timedatectl; then
		timedatectl list-timezones 2>/dev/null && return 0
	fi
	find /usr/share/zoneinfo -type f 2>/dev/null \
		| sed 's|^/usr/share/zoneinfo/||' \
		| grep -vE '^(posix|right)/' \
		| grep -vE '\.tab$|Factory|localtime|leapseconds|tzdata|zone\.tab|iso3166' \
		| sort -u
}

# --- wizard steps: print nav code via return; mutate globals -----------------
# Convention: return 0 next, 1 back, 2 abort

step_welcome() {
	wizard_page "Welcome to Atelier Linux installer v${VERSION}.

WHOLE-DISK install only (erases one selected disk).
No encryption, no custom partitions.

Steps cover identity, locale, graphics, optional software,
mirror, and bootloader.

Next to continue."
}

step_disk() {
	local args=() path size model rc=0 pick
	while IFS='|' read -r path size model; do
		[ -n "$path" ] || continue
		args+=("$path" "$size  $model")
	done < <(list_disks)
	if [ ${#args[@]} -eq 0 ]; then
		ui_error "No disks found."
		return 2
	fi

	# Show list with cancel=back
	case $UI in
	yad)
		pick=$(yad_run --list --text="Select disk to ERASE and install onto:" \
			--width=640 --height=360 --column=Device --column=Details \
			--print-column=1 --button=Back:1 --button=Next:0 "${args[@]}" 2>/dev/null) || rc=$?
		pick=$(printf '%s' "$pick" | awk -F'|' 'NF{print $1; exit}')
		;;
	*)
		pick=$(ui_list_pick "Select disk to ERASE:" "${args[@]}") || rc=1
		;;
	esac
	if [ "$rc" -eq 1 ]; then return 1; fi
	if [ "$rc" -ge 2 ]; then return 2; fi
	DISK=${pick//|/}
	DISK=$(printf '%s' "$DISK" | awk 'NF{print $1; exit}')
	[ -b "$DISK" ] || { ui_error "Invalid disk: $DISK"; return 1; }

	if ! ui_confirm "ALL DATA on $DISK will be DESTROYED.

Yes = use this disk
No  = go back"; then
		return 1
	fi
	log "DISK=$DISK"
	return 0
}

step_identity() {
	local h u p1 p2 r1 r2
	while true; do
		h=$(ui_entry "Hostname:" "$HOSTNAME") || return 1
		h=${h// /}
		if valid_hostname "$h"; then HOSTNAME=$h; break; fi
		ui_error "Invalid hostname. Use letters, digits, hyphens (not leading/trailing -)."
	done
	while true; do
		u=$(ui_entry "Username:" "$USERNAME") || return 1
		u=$(printf '%s' "$u" | tr -cd 'a-z0-9_-' | head -c 32)
		if valid_username "$u"; then USERNAME=$u; break; fi
		ui_error "Invalid username (lowercase, start with letter/_, not root)."
	done
	while true; do
		p1=$(ui_password "Password for $USERNAME:") || return 1
		p2=$(ui_password "Confirm password for $USERNAME:") || return 1
		if [ -n "$p1" ] && [ "$p1" = "$p2" ]; then USERPASS=$p1; break; fi
		ui_error "Passwords empty or do not match. Try again."
	done
	while true; do
		r1=$(ui_password "Root password:") || return 1
		r2=$(ui_password "Confirm root password:") || return 1
		if [ -n "$r1" ] && [ "$r1" = "$r2" ]; then ROOTPASS=$r1; break; fi
		ui_error "Root passwords empty or do not match. Try again."
	done
	log "HOSTNAME=$HOSTNAME USERNAME=$USERNAME"
	return 0
}

step_locale() {
	local args=() tz loc km rc=0
	# Timezone list (cap for UI)
	while read -r tz; do
		[ -n "$tz" ] || continue
		args+=("$tz" "$tz")
	done < <(list_timezones | head -n 400)
	# Ensure current selection first
	args=("$TIMEZONE" "$TIMEZONE (current)" "${args[@]}")

	case $UI in
	yad)
		tz=$(yad_run --list --text="Select timezone:" --width=500 --height=400 \
			--column=Id --column=Zone --print-column=1 --hide-column=1 \
			--button=Back:1 --button=Next:0 "${args[@]}" 2>/dev/null) || rc=$?
		tz=$(printf '%s' "$tz" | awk -F'|' 'NF{print $1; exit}')
		;;
	*)
		tz=$(ui_list_pick "Select timezone:" "${args[@]}") || rc=1
		;;
	esac
	[ "$rc" -eq 1 ] && return 1
	[ "$rc" -ge 2 ] && return 2
	TIMEZONE=${tz:-$TIMEZONE}

	args=(
		en_US.UTF-8 "English (US)"
		en_GB.UTF-8 "English (UK)"
		C.UTF-8 "C.UTF-8 (minimal)"
		de_DE.UTF-8 "German"
		fr_FR.UTF-8 "French"
		es_ES.UTF-8 "Spanish"
		pt_BR.UTF-8 "Portuguese (Brazil)"
		ja_JP.UTF-8 "Japanese"
		zh_CN.UTF-8 "Chinese (Simplified)"
	)
	rc=0
	case $UI in
	yad)
		loc=$(yad_run --list --text="Select locale:" --width=500 --height=320 \
			--column=Id --column=Name --print-column=1 \
			--button=Back:1 --button=Next:0 "${args[@]}" 2>/dev/null) || rc=$?
		loc=$(printf '%s' "$loc" | awk -F'|' 'NF{print $1; exit}')
		;;
	*) loc=$(ui_list_pick "Select locale:" "${args[@]}") || rc=1 ;;
	esac
	[ "$rc" -eq 1 ] && return 1
	[ "$rc" -ge 2 ] && return 2
	LOCALE=${loc:-$LOCALE}

	args=(
		us "US QWERTY"
		uk "UK"
		de "German"
		fr "French"
		es "Spanish"
		it "Italian"
		se "Swedish"
		no "Norwegian"
		dvorak "Dvorak"
	)
	rc=0
	case $UI in
	yad)
		km=$(yad_run --list --text="Select console keymap:" --width=400 --height=320 \
			--column=Id --column=Name --print-column=1 \
			--button=Back:1 --button=Next:0 "${args[@]}" 2>/dev/null) || rc=$?
		km=$(printf '%s' "$km" | awk -F'|' 'NF{print $1; exit}')
		;;
	*) km=$(ui_list_pick "Select keymap:" "${args[@]}") || rc=1 ;;
	esac
	[ "$rc" -eq 1 ] && return 1
	[ "$rc" -ge 2 ] && return 2
	KEYMAP=${km:-$KEYMAP}
	log "TIMEZONE=$TIMEZONE LOCALE=$LOCALE KEYMAP=$KEYMAP"
	return 0
}

step_graphics() {
	INSTALL_NVIDIA=0
	if detect_nvidia_gpu; then
		if ui_confirm "NVIDIA GPU detected.

Install proprietary NVIDIA drivers?
  Yes = nonfree nvidia + Atelier config
  No  = skip (sudo atelier-setup-nvidia later)"; then
			INSTALL_NVIDIA=1
		fi
	else
		log "no NVIDIA GPU; INSTALL_NVIDIA=0"
		ui_info "No NVIDIA GPU detected.

Proprietary NVIDIA drivers will NOT be installed.

On a real NVIDIA PC later:
  sudo atelier-setup-nvidia"
	fi

	INSTALL_XLIBRE=0
	if ui_confirm "Install Xlibre display server?

  Yes = external xlibre-void (PLAN default)
  No  = keep X.Org

Usually No for VMs."; then
		INSTALL_XLIBRE=1
	fi
	log "INSTALL_NVIDIA=$INSTALL_NVIDIA INSTALL_XLIBRE=$INSTALL_XLIBRE"
	return 0
}

step_software() {
	PKG_EXTRA_CLI=0
	PKG_MEDIA=0
	local sel
	sel=$(ui_checklist "Optional package groups (desktop is always installed):" \
		extra_cli "Extra CLI tools (htop, ripgrep, fd, curl, wget)" off \
		media "Media tools (mpv, ffmpeg)" off) || return 1
	printf '%s\n' "$sel" | grep -qx extra_cli && PKG_EXTRA_CLI=1
	printf '%s\n' "$sel" | grep -qx media && PKG_MEDIA=1
	log "PKG_EXTRA_CLI=$PKG_EXTRA_CLI PKG_MEDIA=$PKG_MEDIA"
	return 0
}

step_mirror() {
	local args pick rc=0
	args=(
		"https://repo-default.voidlinux.org/current" "Default (repo-default)"
		"https://repo-fastly.voidlinux.org/current" "Fastly CDN"
		"https://mirrors.servercentral.com/voidlinux/current" "ServerCentral"
		"https://mirror.ps.kz/voidlinux/current" "ps.kz"
		"https://void.webconverger.org/current" "Webconverger"
	)
	case $UI in
	yad)
		pick=$(yad_run --list --text="Select Void package mirror:" --width=640 --height=300 \
			--column=URL --column=Name --print-column=1 \
			--button=Back:1 --button=Next:0 "${args[@]}" 2>/dev/null) || rc=$?
		pick=$(printf '%s' "$pick" | awk -F'|' 'NF{print $1; exit}')
		;;
	*) pick=$(ui_list_pick "Select Void mirror:" "${args[@]}") || rc=1 ;;
	esac
	[ "$rc" -eq 1 ] && return 1
	[ "$rc" -ge 2 ] && return 2
	VOID_REPO=${pick:-$VOID_REPO}
	# nonfree sibling
	case $VOID_REPO in
	*/current) VOID_NONFREE_REPO="${VOID_REPO}/nonfree" ;;
	*/current/) VOID_NONFREE_REPO="${VOID_REPO}nonfree" ;;
	*) VOID_NONFREE_REPO="${VOID_REPO%/}/nonfree" ;;
	esac
	log "VOID_REPO=$VOID_REPO VOID_NONFREE_REPO=$VOID_NONFREE_REPO"
	return 0
}

step_bootloader() {
	INSTALL_BOOTLOADER=1
	if ui_confirm "Install GRUB bootloader?

  Yes = recommended (EFI or BIOS auto-detected)
  No  = skip (advanced; you must install a bootloader later)

Yes is recommended."; then
		INSTALL_BOOTLOADER=1
	else
		INSTALL_BOOTLOADER=0
	fi
	log "INSTALL_BOOTLOADER=$INSTALL_BOOTLOADER"
	return 0
}

step_summary() {
	local mode=BIOS ns=no xs=no bl=yes ec=no md=no
	is_efi && mode=EFI
	[ "$INSTALL_NVIDIA" -eq 1 ] && ns=yes
	[ "$INSTALL_XLIBRE" -eq 1 ] && xs=yes
	[ "$INSTALL_BOOTLOADER" -eq 1 ] && bl=yes || bl=no
	[ "$PKG_EXTRA_CLI" -eq 1 ] && ec=yes
	[ "$PKG_MEDIA" -eq 1 ] && md=yes
	if ui_confirm "Install summary - proceed?

Disk:        $DISK (ERASED)
Firmware:    $mode
Hostname:    $HOSTNAME
User:        $USERNAME
Timezone:    $TIMEZONE
Locale:      $LOCALE
Keymap:      $KEYMAP
NVIDIA:      $ns
Xlibre:      $xs
Extra CLI:   $ec
Media:       $md
Mirror:      $VOID_REPO
Bootloader:  $bl

Yes = start install
No  = go back"; then
		return 0
	fi
	return 1
}

# --- install backend ----------------------------------------------------------
partition_disk() {
	log "Partitioning $DISK"
	umount -R "$TARGETDIR" 2>/dev/null || true
	lsblk -ln -o NAME,MOUNTPOINT "$DISK" 2>/dev/null | while read -r n m; do
		[ -n "$m" ] || continue
		umount "$m" 2>/dev/null || umount -l "$m" 2>/dev/null || true
	done
	wipefs -a "$DISK" 2>/dev/null || true
	parted -s "$DISK" mklabel gpt
	if is_efi; then
		parted -s "$DISK" mkpart ESP fat32 1MiB 513MiB
		parted -s "$DISK" set 1 esp on
		parted -s "$DISK" mkpart root ext4 513MiB 100%
		PART_ESP=$(part_path "$DISK" 1)
		PART_ROOT=$(part_path "$DISK" 2)
		sleep 1; udevadm settle 2>/dev/null || sleep 2
		mkfs.vfat -F32 -n EFI "$PART_ESP"
		mkfs.ext4 -F -L atelier-root "$PART_ROOT"
	else
		parted -s "$DISK" mkpart bios_grub 1MiB 2MiB
		parted -s "$DISK" set 1 bios_grub on
		parted -s "$DISK" mkpart root ext4 2MiB 100%
		PART_ESP=""
		PART_ROOT=$(part_path "$DISK" 2)
		sleep 1; udevadm settle 2>/dev/null || sleep 2
		mkfs.ext4 -F -L atelier-root "$PART_ROOT"
	fi
	log "Partitions: esp=${PART_ESP:-none} root=$PART_ROOT"
}

mount_target() {
	mkdir -p "$TARGETDIR"
	mount "$PART_ROOT" "$TARGETDIR"
	if [ -n "${PART_ESP:-}" ]; then
		mkdir -p "$TARGETDIR/boot/efi"
		mount "$PART_ESP" "$TARGETDIR/boot/efi"
	fi
	for d in dev proc sys run; do
		mkdir -p "$TARGETDIR/$d"
		mount --rbind "/$d" "$TARGETDIR/$d"
		mount --make-rslave "$TARGETDIR/$d" 2>/dev/null || true
	done
}

write_fstab() {
	local uuid_root uuid_esp
	uuid_root=$(blkid -s UUID -o value "$PART_ROOT")
	{
		printf '# /etc/fstab - generated by atelier-install\n'
		printf 'UUID=%s / ext4 defaults 0 1\n' "$uuid_root"
		if [ -n "${PART_ESP:-}" ]; then
			uuid_esp=$(blkid -s UUID -o value "$PART_ESP")
			printf 'UUID=%s /boot/efi vfat defaults 0 2\n' "$uuid_esp"
		fi
		printf 'tmpfs /tmp tmpfs defaults,nosuid,nodev 0 0\n'
	} >"$TARGETDIR/etc/fstab"
}

install_packages() {
	log "Installing packages into $TARGETDIR"
	mkdir -p "$TARGETDIR/var/db/xbps/keys" "$TARGETDIR/usr/share" "$TARGETDIR/etc"
	[ -d /var/db/xbps/keys ] && cp -a /var/db/xbps/keys/. "$TARGETDIR/var/db/xbps/keys/" || true
	[ -d /usr/share/xbps.d ] && cp -a /usr/share/xbps.d "$TARGETDIR/usr/share/" || true

	local REPO_ARGS=(--repository="$VOID_REPO")
	if [ -d "$ATELIER_REPO_LIVE" ] && ls "$ATELIER_REPO_LIVE"/*.xbps >/dev/null 2>&1; then
		mkdir -p "$TARGETDIR/usr/share/atelier/repo"
		cp -a "$ATELIER_REPO_LIVE"/. "$TARGETDIR/usr/share/atelier/repo/"
		mkdir -p "$TARGETDIR/etc/xbps.d"
		printf 'repository=/usr/share/atelier/repo\n' >"$TARGETDIR/etc/xbps.d/10-repository-atelier.conf"
		REPO_ARGS+=(--repository="$ATELIER_REPO_LIVE")
	else
		log "WARN: personal repo missing at $ATELIER_REPO_LIVE"
	fi

	# Primary mirror for target system
	mkdir -p "$TARGETDIR/etc/xbps.d"
	printf 'repository=%s\n' "$VOID_REPO" >"$TARGETDIR/etc/xbps.d/00-repository-main.conf"

	if [ "${INSTALL_NVIDIA:-0}" -eq 1 ]; then
		REPO_ARGS+=(--repository="$VOID_NONFREE_REPO")
		printf 'repository=%s\n' "$VOID_NONFREE_REPO" >"$TARGETDIR/etc/xbps.d/10-repository-nonfree.conf"
	fi

	# GraeWolf personal packages (brave-origin, …) — live medium + package ship conf+key
	if [ -f /etc/xbps.d/20-repository-graewolf.conf ]; then
		cp -a /etc/xbps.d/20-repository-graewolf.conf \
			"$TARGETDIR/etc/xbps.d/20-repository-graewolf.conf"
		REPO_ARGS+=(--repository="https://github.com/GraeWolf/void-repo/releases/download/x86_64")
	fi

	local pkgs=(base-system linux sudo dbus elogind NetworkManager polkit)
	if [ "${INSTALL_BOOTLOADER:-1}" -eq 1 ]; then
		if is_efi; then pkgs+=(grub-x86_64-efi grub efibootmgr dosfstools)
		else pkgs+=(grub); fi
	else
		is_efi && pkgs+=(dosfstools)
	fi

	if [ -d "$ATELIER_REPO_LIVE" ] && xbps-query --repository="$ATELIER_REPO_LIVE" -R atelier-desktop >/dev/null 2>&1; then
		pkgs+=(atelier-desktop)
	else
		log "WARN: atelier-desktop not in personal repo"
	fi

	if [ "${INSTALL_NVIDIA:-0}" -eq 1 ]; then
		pkgs+=(void-repo-nonfree nvidia)
		if [ -d "$ATELIER_REPO_LIVE" ] && xbps-query --repository="$ATELIER_REPO_LIVE" -R atelier-nvidia >/dev/null 2>&1; then
			pkgs+=(atelier-nvidia)
		fi
	fi
	if [ "${INSTALL_XLIBRE:-0}" -eq 1 ]; then
		if [ -d "$ATELIER_REPO_LIVE" ] && xbps-query --repository="$ATELIER_REPO_LIVE" -R atelier-xlibre-repo >/dev/null 2>&1; then
			pkgs+=(atelier-xlibre-repo)
		fi
	fi

	# Optional groups (only if present in Void)
	if [ "${PKG_EXTRA_CLI:-0}" -eq 1 ]; then
		for p in htop ripgrep fd curl wget; do
			if xbps-query --repository="$VOID_REPO" -R "$p" >/dev/null 2>&1; then pkgs+=("$p"); fi
		done
	fi
	if [ "${PKG_MEDIA:-0}" -eq 1 ]; then
		for p in mpv ffmpeg; do
			if xbps-query --repository="$VOID_REPO" -R "$p" >/dev/null 2>&1; then pkgs+=("$p"); fi
		done
	fi

	log "xbps-install ${pkgs[*]}"
	xbps-install -r "$TARGETDIR" -SyU "${REPO_ARGS[@]}" "${pkgs[@]}" 2>&1 | tee -a "$LOG"

	if [ "${INSTALL_XLIBRE:-0}" -eq 1 ] && [ -f "$TARGETDIR/etc/xbps.d/99-repository-xlibre.conf" ]; then
		xbps-install -r "$TARGETDIR" -SyU "${REPO_ARGS[@]}" xlibre 2>&1 | tee -a "$LOG" || \
			log "WARN: xlibre install failed"
	fi

	xbps-reconfigure -r "$TARGETDIR" -f base-files >>"$LOG" 2>&1 || true
	chroot "$TARGETDIR" xbps-reconfigure -a >>"$LOG" 2>&1 || true
}

enable_sv() {
	local sv=$1
	if [ -d "$TARGETDIR/etc/sv/$sv" ]; then
		mkdir -p "$TARGETDIR/etc/runit/runsvdir/default"
		ln -sfn "/etc/sv/$sv" "$TARGETDIR/etc/runit/runsvdir/default/$sv"
		log "enabled service $sv"
	fi
}

configure_system() {
	log "Configuring system"
	printf '%s\n' "$HOSTNAME" >"$TARGETDIR/etc/hostname"
	if [ -e "/usr/share/zoneinfo/$TIMEZONE" ]; then
		ln -sf "/usr/share/zoneinfo/$TIMEZONE" "$TARGETDIR/etc/localtime"
	elif [ -e "$TARGETDIR/usr/share/zoneinfo/$TIMEZONE" ]; then
		chroot "$TARGETDIR" ln -sf "/usr/share/zoneinfo/$TIMEZONE" /etc/localtime
	fi
	if [ -f "$TARGETDIR/etc/default/libc-locales" ]; then
		sed -i -e "/${LOCALE}/s/^#//" "$TARGETDIR/etc/default/libc-locales" || true
	fi
	printf 'LANG=%s\n' "$LOCALE" >"$TARGETDIR/etc/locale.conf"
	chroot "$TARGETDIR" xbps-reconfigure -f glibc-locales >>"$LOG" 2>&1 || true
	if [ -f "$TARGETDIR/etc/rc.conf" ]; then
		sed -i -e "s|#\?KEYMAP=.*|KEYMAP=$KEYMAP|g" "$TARGETDIR/etc/rc.conf" || true
	fi
	printf 'KEYMAP=%s\n' "$KEYMAP" >"$TARGETDIR/etc/vconsole.conf"
	printf 'root:%s\n' "$ROOTPASS" | chroot "$TARGETDIR" chpasswd -c SHA512
	local groups="wheel,users,audio,video,input,cdrom,optical,storage,network,floppy"
	chroot "$TARGETDIR" useradd -m -s /bin/bash -G "$groups" "$USERNAME" || true
	printf '%s:%s\n' "$USERNAME" "$USERPASS" | chroot "$TARGETDIR" chpasswd -c SHA512
	if [ -d "$TARGETDIR/etc/sudoers.d" ]; then
		printf '%%%s ALL=(ALL:ALL) ALL\n' "wheel" >"$TARGETDIR/etc/sudoers.d/wheel"
		chmod 440 "$TARGETDIR/etc/sudoers.d/wheel"
	fi
	enable_sv NetworkManager
	enable_sv dbus
	enable_sv elogind
	write_fstab
	rm -f "$TARGETDIR/usr/sbin/void-installer" "$TARGETDIR/usr/bin/void-installer" \
		"$TARGETDIR/etc/profile.d/atelier-live.sh" 2>/dev/null || true
}

install_bootloader() {
	[ "${INSTALL_BOOTLOADER:-1}" -eq 1 ] || { log "skipping bootloader"; return 0; }
	log "Installing GRUB on $DISK"
	if is_efi; then
		chroot "$TARGETDIR" grub-install --target=x86_64-efi \
			--efi-directory=/boot/efi --bootloader-id=atelier --recheck >>"$LOG" 2>&1
	else
		chroot "$TARGETDIR" grub-install --target=i386-pc "$DISK" >>"$LOG" 2>&1
	fi
	chroot "$TARGETDIR" grub-mkconfig -o /boot/grub/grub.cfg >>"$LOG" 2>&1
}

cleanup_mounts() {
	log "Unmounting target"
	sync
	umount -R "$TARGETDIR" 2>/dev/null || umount -Rl "$TARGETDIR" 2>/dev/null || true
}

run_install() {
	ui_info "Installing... This may take a long time.

Log: $LOG

Do not power off."
	trap 'log "FAILED - see $LOG"; cleanup_mounts; ui_error "Installation failed. See $LOG"; exit 1' ERR
	partition_disk
	mount_target
	install_packages
	configure_system
	install_bootloader
	trap - ERR
	cleanup_mounts
	ui_info "Installation complete.

Reboot into Atelier Linux and remove the live medium.

Log: $LOG"
	if ui_confirm "Reboot now?"; then
		sync
		reboot || telinit 6 2>/dev/null || true
	fi
}

# --- main wizard loop ---------------------------------------------------------
main() {
	: >"$LOG"
	log "atelier-install $VERSION starting UI=$UI"
	ensure_root "$@"
	have parted || die "parted is required"
	have mkfs.ext4 || die "e2fsprogs (mkfs.ext4) is required"
	have xbps-install || die "xbps-install is required"
	have lsblk || die "util-linux (lsblk) is required"

	# steps as names; navigate with index
	local steps=(welcome disk identity locale graphics software mirror bootloader summary)
	local i=0 n=${#steps[@]} rc
	while [ "$i" -ge 0 ] && [ "$i" -lt "$n" ]; do
		rc=0
		case ${steps[$i]} in
		welcome) step_welcome || rc=$? ;;
		disk) step_disk || rc=$? ;;
		identity) step_identity || rc=$? ;;
		locale) step_locale || rc=$? ;;
		graphics) step_graphics || rc=$? ;;
		software) step_software || rc=$? ;;
		mirror) step_mirror || rc=$? ;;
		bootloader) step_bootloader || rc=$? ;;
		summary) step_summary || rc=$? ;;
		esac
		log "step ${steps[$i]} rc=$rc"
		case $rc in
		0) i=$((i + 1)) ;;
		1) i=$((i - 1)); [ "$i" -lt 0 ] && i=0 ;;
		*) log "abort"; exit 1 ;;
		esac
	done

	run_install
}

main "$@"
