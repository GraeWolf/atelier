#!/usr/bin/env bash
# Atelier Linux installer (wizard, whole-disk)
# Console installer: gum TUI by default (Void package: gum).
# Plain text (pipes and tests): atelier-install --text
# ASCII-only UI strings for locale safety.
# Colors are 16-color on a raw console and 256-color in a terminal.
# Truecolor is not required. TERM=linux uses ASCII borders.
# Escape and Ctrl+C never start the install.
#
# Settings come from a preset (/etc/atelier/install.conf, or --preset FILE).
# Preset values are not asked. The wizard asks for the disk, one user
# password, a LUKS passphrase only when encryption is on, then a summary
# (Install / Edit a field / Quit). Root is locked. The user is in wheel
# and uses sudo.
#
# Optional LUKS2 on the root filesystem. /boot and ESP stay unencrypted
# so GRUB does not need cryptodisk (GRUB cannot unlock LUKS2+argon2id).
# Optional /swapfile for hibernation (default off; no swap partition).
# Optional Steam (preset GAMING, default yes on this desktop). Enables
# Void multilib and installs the 32-bit graphics stack. Edit can turn it
# off. A Steam failure does not roll back the desktop. Preflight still
# requires those packages to be reachable before the disk is wiped.
# XLibre is always installed. xinit does not pull in an X server, and
# there is no X.Org fallback.
#
# set -E (errtrace): without it, an ERR trap is not inherited by functions.
# A failure inside partition_disk / install_packages then exits 1 with no
# error screen, no unmount, and no LUKS close.
set -eEuo pipefail

VERSION="0.6.0"
TITLE="Atelier Installer"
TARGETDIR="${TARGETDIR:-/mnt/atelier-target}"
LOG="${LOG:-/tmp/atelier-install.log}"
# SummitHQ. repo-default.voidlinux.org has been timing out. A preset
# MIRROR= line, or Edit → Mirror, replaces this.
VOID_REPO="${VOID_REPO:-https://mirrors.summithq.com/voidlinux/current}"
VOID_REPO="${VOID_REPO%/}"
VOID_NONFREE_REPO="${VOID_NONFREE_REPO:-${VOID_REPO}/nonfree}"
# Preflight gives up after this many seconds and names the mirror.
MIRROR_TIMEOUT="${MIRROR_TIMEOUT:-30}"
ATELIER_REPO_LIVE="${ATELIER_REPO_LIVE:-/usr/share/atelier/repo}"
XLIBRE_REPO="${XLIBRE_REPO:-https://github.com/xlibre-void/xlibre/releases/latest/download/}"
XLIBRE_KEY_NAME="00:ca:42:57:c9:c0:9a:ec:94:b4:7d:97:e5:a9:aa:1e.plist"

# State (wizard). Built-in defaults match installer/install.conf.
# A preset value is not asked. Hostname and username are empty here and
# in the shipped preset, so the wizard asks. A private --preset file
# may set them.
INSTALL_NVIDIA=0
NVIDIA_MODE=auto
# Shipped preset is GAMING=yes. Built-in default matches that file.
INSTALL_GAMING=1
INSTALL_XLIBRE=1
NVIDIA_INSTALL_STATUS=skipped
GAMING_INSTALL_STATUS=skipped
GAMING_LIST_FILE=""
GAMING_REPO_PKGS=()
GAMING_PKGS=()
GAMING_NVIDIA_PKGS=()
RECONFIGURE_STATUS=skipped
NVIDIA_GPU_DETECTED=0
FIRMWARE_MODE=""
# Failure handling (armed only while run_install is in progress).
INSTALL_PHASE=""
INSTALL_TRAPS=0
INSTALL_CLEANED=0
INSTALL_FAIL_TEXT=""
INSTALL_FAIL_CMD=""
INSTALL_MAIN_PID=$BASHPID
LOG_COPIED=0
INSTALL_BOOTLOADER=1
# Extra package names from the preset. dropbox is not in the base list.
PKG_EXTRA=(dropbox)
ENCRYPT_DISK=0
CREATE_SWAP=0
DISK=""
# Empty unless a preset sets them. The shipped preset leaves both empty.
HOSTNAME=""
USERNAME=""
# forward or back. A filled name step is skipped going forward and
# passed through when moving back, so Back does not bounce.
NAV=forward
USERPASS=""
LUKSPASS=""
TIMEZONE="America/New_York"
LOCALE="en_US.UTF-8"
KEYMAP="us"
PRESET_FILE=""
PRESET_PATH=""
DRY_RUN=0
# Tests point this at a fixture tree. Live installs use the system tzdata.
ZONEINFO_DIR="${ZONEINFO_DIR:-/usr/share/zoneinfo}"
ASSIGN_PACKAGES_ERR=""
PART_ESP=""
PART_BOOT=""
PART_CRYPT=""
PART_ROOT=""
CRYPT_NAME="cryptroot"

# --- locale -------------------------------------------------------------------
# gum and the text prompts need a UTF-8 locale. A writable runtime
# directory is kept for pkexec when the installer is not already root.
ensure_locale() {
	if [ -z "${LANG:-}" ] || [ "$LANG" = "C" ] || [ "$LANG" = "POSIX" ]; then
		if locale -a 2>/dev/null | grep -qiE 'en_US\.utf-?8'; then
			export LANG=en_US.UTF-8
		else
			export LANG=C.UTF-8
		fi
	fi
	export LC_ALL="${LC_ALL:-$LANG}"
	export LC_CTYPE="${LC_CTYPE:-$LANG}"
	if [ -z "${XDG_RUNTIME_DIR:-}" ] || [ ! -d "${XDG_RUNTIME_DIR}" ] || [ ! -w "${XDG_RUNTIME_DIR}" ]; then
		if [ -d "/run/user/$(id -u)" ] && [ -w "/run/user/$(id -u)" ]; then
			XDG_RUNTIME_DIR="/run/user/$(id -u)"
			export XDG_RUNTIME_DIR
		else
			XDG_RUNTIME_DIR="${TMPDIR:-/tmp}/runtime-$(id -u)"
			export XDG_RUNTIME_DIR
			mkdir -p "$XDG_RUNTIME_DIR"
			chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true
		fi
	fi
}
ensure_locale

# --- helpers ------------------------------------------------------------------
# During run_install the EXIT trap shows the message after cleanup.
# Before that, show it immediately (wizard / early checks).
die() {
	# Stop a preflight spinner before any error screen.
	if declare -F ui_spin_end >/dev/null 2>&1; then
		ui_spin_end || true
	fi
	if [ "${INSTALL_TRAPS:-0}" -eq 1 ]; then
		INSTALL_FAIL_TEXT="$*"
		exit 1
	fi
	ui_error "$*"
	exit 1
}
log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$LOG"; }
have() { command -v "$1" >/dev/null 2>&1; }

# Read one stdin line into the variable named by $1.
# A final line with no trailing newline still counts.
# 0 = got a line (it may be empty). 2 = EOF and no characters.
read_line_to() {
	local __dest=$1 __line="" __st=0
	IFS= read -r __line || __st=$?
	if [ -n "$__line" ] || [ "$__st" -eq 0 ]; then
		printf -v "$__dest" '%s' "$__line"
		return 0
	fi
	return 2
}

# UI mode: tui (gum, default) or text (pipes and tests).
UI_MODE=tui
UI=none
UI_STEP=""
UI_INTERRUPTED=0
UI_SPIN_PID=""
UI_SPIN_FIFO=""
UI_SPIN_FD=""
UI_ASCII=1
UI_COLOR=0
UI_ROWS=24
UI_COLS=80
UI_BOX=76
UI_TEXT=72
UI_FG=7
UI_ACCENT=6
UI_RED=1
UI_GREEN=2
UI_MUTED=7
UI_SEL_FG=0
UI_SEL_BG=6
UI_SPINNER=line
# Unit separator. It does not appear in disk names or zone paths.
UI_DELIM=$(printf '\037')

# Ctrl+C during the wizard sets a flag. During the install it stops
# the run. It is never treated as Yes or as Start installation.
ui_on_int() {
	if [ "${INSTALL_TRAPS:-0}" -eq 1 ]; then
		INSTALL_FAIL_TEXT="Interrupted. The install was stopped."
		exit 1
	fi
	UI_INTERRUPTED=1
}

ui_mark() {
	UI_STEP="$*"
}

# Forward steps. Encryption adds one screen, so the total is 6 or 7.
ui_step_total() {
	if [ "${ENCRYPT_DISK:-0}" -eq 1 ]; then
		printf '7\n'
	else
		printf '6\n'
	fi
}

ui_mark_step() {
	local n=$1 label=$2 total
	total=$(ui_step_total)
	ui_mark "Step ${n}/${total}  ${label}"
}

ui_term_size() {
	local lines=24 cols=80
	if [ -c /dev/tty ]; then
		lines=$(stty size </dev/tty 2>/dev/null | awk '{print $1}') || lines=24
		cols=$(stty size </dev/tty 2>/dev/null | awk '{print $2}') || cols=80
	fi
	case ${lines:-} in
	''|*[!0-9]*) lines=24 ;;
	esac
	case ${cols:-} in
	''|*[!0-9]*) cols=80 ;;
	esac
	if [ "$lines" -lt 16 ]; then
		lines=24
	fi
	if [ "$cols" -lt 60 ]; then
		cols=80
	fi
	UI_ROWS=$lines
	UI_COLS=$cols
	UI_BOX=$((cols - 2))
	if [ "$UI_BOX" -gt 78 ]; then
		UI_BOX=78
	fi
	UI_TEXT=$((UI_BOX - 4))
	if [ "$UI_TEXT" -lt 20 ]; then
		UI_TEXT=20
	fi
}

# Draw on the terminal. Never on stdout: callers capture stdout as the answer.
ui_tty() {
	if [ -c /dev/tty ]; then
		"$@" >/dev/tty
	else
		"$@" >&2
	fi
}

ui_clear() {
	if [ -c /dev/tty ]; then
		printf '\033[H\033[2J\033[H' >/dev/tty
	else
		printf '\033[H\033[2J\033[H' >&2
	fi
}

# Drop keys left in the tty. A bounded loop: `read -t 0` can stay true forever.
ui_drain_keys() {
	local _n=0 _junk
	[ -c /dev/tty ] || return 0
	while [ "$_n" -lt 8 ]; do
		_n=$((_n + 1))
		IFS= read -r -t 0.01 _junk </dev/tty 2>/dev/null || break
	done
	return 0
}

ui_theme_init() {
	local utf8=0
	UI_ASCII=0
	UI_COLOR=1
	case ${LC_ALL:-${LC_CTYPE:-${LANG:-}}} in
	*[Uu][Tt][Ff]*8*|*[Uu][Tt][Ff]*-8*) utf8=1 ;;
	esac
	case ${TERM:-linux} in
	linux|dumb|vt*|ansi|cons*|unknown) UI_ASCII=1 ;;
	esac
	if [ "$utf8" -ne 1 ]; then
		UI_ASCII=1
	fi
	if [ -n "${NO_COLOR:-}" ] || [ "${FORCE_COLOR:-}" = 0 ]; then
		UI_COLOR=0
		UI_ASCII=1
	fi
	if [ "$UI_COLOR" -eq 0 ]; then
		UI_FG=7
		UI_ACCENT=7
		UI_RED=7
		UI_GREEN=7
		UI_MUTED=7
		UI_SEL_FG=7
		UI_SEL_BG=0
		UI_SPINNER=line
	elif [ "$UI_ASCII" -eq 1 ]; then
		# 16-color stand-ins for Tokyo Night. No hex, no 256-color indexes.
		UI_FG=7
		UI_ACCENT=6
		UI_RED=1
		UI_GREEN=2
		UI_MUTED=7
		UI_SEL_FG=0
		UI_SEL_BG=6
		UI_SPINNER=line
	else
		# 256-color Tokyo Night. These are palette indexes, not truecolor.
		UI_FG=189
		UI_ACCENT=111
		UI_RED=204
		UI_GREEN=150
		UI_MUTED=103
		UI_SEL_FG=235
		UI_SEL_BG=111
		UI_SPINNER="dot"
	fi
	export GUM_CHOOSE_CURSOR="> "
	export GUM_CHOOSE_SHOW_HELP=false
	export GUM_CHOOSE_PADDING="0 0"
	export GUM_CHOOSE_CURSOR_FOREGROUND="$UI_ACCENT"
	export GUM_CHOOSE_HEADER_FOREGROUND="$UI_ACCENT"
	export GUM_CHOOSE_ITEM_FOREGROUND="$UI_FG"
	export GUM_CHOOSE_SELECTED_FOREGROUND="$UI_SEL_FG"
	export GUM_CHOOSE_SELECTED_BACKGROUND="$UI_SEL_BG"
	export GUM_INPUT_PROMPT="> "
	export GUM_INPUT_SHOW_HELP=false
	export GUM_INPUT_PADDING="0 0"
	export GUM_INPUT_PROMPT_FOREGROUND="$UI_ACCENT"
	export GUM_INPUT_CURSOR_FOREGROUND="$UI_ACCENT"
	export GUM_INPUT_HEADER_FOREGROUND="$UI_FG"
	export GUM_INPUT_PLACEHOLDER_FOREGROUND="$UI_MUTED"
	export GUM_INPUT_WIDTH=60
	export GUM_SPIN_SPINNER="$UI_SPINNER"
	export GUM_SPIN_SPINNER_FOREGROUND="$UI_ACCENT"
	export GUM_SPIN_TITLE_FOREGROUND="$UI_FG"
	export GUM_SPIN_PADDING="0 0"
	export GUM_CONFIRM_SHOW_HELP=false
	export GUM_CONFIRM_PADDING="0 0"
	export GUM_CONFIRM_PROMPT_FOREGROUND="$UI_ACCENT"
	export GUM_CONFIRM_SELECTED_FOREGROUND="$UI_SEL_FG"
	export GUM_CONFIRM_SELECTED_BACKGROUND="$UI_GREEN"
	export GUM_CONFIRM_UNSELECTED_FOREGROUND="$UI_FG"
	if [ "$UI_ASCII" -eq 1 ]; then
		export GUM_INPUT_CURSOR_MODE=static
	else
		export GUM_INPUT_CURSOR_MODE=blink
	fi
	ui_term_size
	log "theme ascii=$UI_ASCII color=$UI_COLOR rows=$UI_ROWS cols=$UI_COLS spinner=$UI_SPINNER"
}

select_ui() {
	if [ "$UI_MODE" != text ]; then
		if [ -z "${TERM:-}" ] || [ "$TERM" = "dumb" ]; then
			export TERM=linux
		fi
	fi
	case $UI_MODE in
	text)
		UI=text
		;;
	tui|*)
		if have gum; then
			UI=gum
			ui_theme_init
		else
			UI=none
		fi
		;;
	esac
	log "UI_MODE=$UI_MODE UI=$UI TERM=${TERM:-} title=$TITLE"
}

# Capture gum's stdout in the current shell. Stdin is the real tty.
# Ctrl+C is ignored here so the key returns from gum instead of killing
# the installer. The caller treats a non-zero status as "no choice".
gum_capture() {
	local __dest=$1
	shift
	local __out="" __rc=0
	ui_drain_keys || true
	trap '' INT
	if [ -c /dev/tty ]; then
		__out=$("$@" </dev/tty) || __rc=$?
	else
		__out=$("$@") || __rc=$?
	fi
	trap ui_on_int INT
	__out=${__out//$'\r'/}
	printf -v "$__dest" '%s' "$__out"
	return "$__rc"
}

# Parent-side capture. Command substitution would hide Ctrl+C from this
# shell, so the interrupt flag is checked here after gum returns.
ui_read() {
	local __dest=$1
	shift
	local __out="" __rc=0
	UI_INTERRUPTED=0
	__out=$("$@") || __rc=$?
	if [ "${UI_INTERRUPTED:-0}" -eq 1 ] || [ "$__rc" -eq 130 ]; then
		UI_INTERRUPTED=0
		printf -v "$__dest" '%s' ""
		return 1
	fi
	printf -v "$__dest" '%s' "$__out"
	return "$__rc"
}

# height, header, selected (empty skips), then choices.
gum_pick() {
	local __var=$1 __h=$2 __header=$3 __sel=$4
	shift 4
	local -a __cmd
	__cmd=(gum choose --no-show-help --height "$__h" --header "$__header")
	if [ -n "$__sel" ]; then
		__cmd+=(--selected "$__sel")
	fi
	__cmd+=(-- "$@")
	gum_capture "$__var" "${__cmd[@]}"
}

ui_wrap_lines() {
	local width=$1 line
	while IFS= read -r line || [ -n "$line" ]; do
		if [ "${#line}" -le "$width" ]; then
			printf '%s\n' "$line"
			continue
		fi
		if have fold; then
			printf '%s\n' "$line" | fold -w "$width"
		else
			printf '%s\n' "$line"
		fi
	done
}

# Keep the start and the end when a message is taller than the console.
ui_fit_text() {
	local text=$1 max=$2 width=$3
	local wrapped n head tail i
	local -a rows=()
	wrapped=$(printf '%s\n' "$text" | ui_wrap_lines "$width")
	mapfile -t rows <<< "$wrapped"
	n=${#rows[@]}
	if [ "$n" -gt 0 ] && [ -z "${rows[$((n - 1))]}" ]; then
		unset 'rows[$((n - 1))]'
		n=${#rows[@]}
	fi
	if [ "$n" -le "$max" ]; then
		if [ "$n" -eq 0 ]; then
			return 0
		fi
		printf '%s\n' "${rows[@]}"
		return 0
	fi
	head=$((max / 3))
	if [ "$head" -lt 2 ]; then
		head=2
	fi
	tail=$((max - head - 1))
	if [ "$tail" -lt 2 ]; then
		tail=2
	fi
	i=0
	while [ "$i" -lt "$head" ] && [ "$i" -lt "$n" ]; do
		printf '%s\n' "${rows[$i]}"
		i=$((i + 1))
	done
	printf '%s\n' "..."
	i=$((n - tail))
	if [ "$i" -lt 0 ]; then
		i=0
	fi
	while [ "$i" -lt "$n" ]; do
		printf '%s\n' "${rows[$i]}"
		i=$((i + 1))
	done
}

ui_sgr() {
	local tone=$1
	if [ "${UI_COLOR:-0}" -ne 1 ]; then
		return 0
	fi
	case $tone in
	error) printf '\033[31m' ;;
	ok) printf '\033[32m' ;;
	*) printf '\033[36m' ;;
	esac
}

ui_ascii_card() {
	local text=$1 tone=${2:-normal}
	local w=$UI_BOX inner line bar esc reset
	inner=$((w - 4))
	if [ "$inner" -lt 10 ]; then
		inner=10
		w=$((inner + 4))
	fi
	printf -v bar '%*s' $((inner + 2)) ''
	bar=${bar// /-}
	esc=$(ui_sgr "$tone")
	reset=""
	if [ -n "$esc" ]; then
		reset=$(printf '\033[0m')
	fi
	ui_tty printf '%s+%s+%s\n' "$esc" "$bar" "$reset"
	while IFS= read -r line || [ -n "$line" ]; do
		line=${line:0:$inner}
		ui_tty printf '%s| %-*s |%s\n' "$esc" "$inner" "$line" "$reset"
	done <<< "$text"
	ui_tty printf '%s+%s+%s\n' "$esc" "$bar" "$reset"
}

ui_gum_color() {
	case $1 in
	error) printf '%s\n' "$UI_RED" ;;
	ok) printf '%s\n' "$UI_GREEN" ;;
	*) printf '%s\n' "$UI_ACCENT" ;;
	esac
}

ui_card() {
	local text=$1 tone=${2:-normal}
	local wrapped color
	wrapped=$(printf '%s\n' "$text" | ui_wrap_lines "$UI_TEXT")
	if [ "$UI_ASCII" -eq 1 ] || [ "${UI_COLOR:-0}" -eq 0 ]; then
		ui_ascii_card "$wrapped" "$tone"
		return 0
	fi
	color=$(ui_gum_color "$tone")
	ui_tty gum style --border rounded --border-foreground "$color" \
		--foreground "$UI_FG" --width "$UI_BOX" --padding "0 1" \
		"$wrapped" || ui_ascii_card "$wrapped" "$tone"
}

ui_banner() {
	local right="v${VERSION}"
	local left="Atelier Linux"
	local gap spaces line
	if [ -n "${UI_STEP:-}" ]; then
		right="v${VERSION}  ${UI_STEP}"
	fi
	gap=$((UI_TEXT - ${#left} - ${#right}))
	if [ "$gap" -lt 1 ]; then
		gap=1
	fi
	printf -v spaces '%*s' "$gap" ''
	line="${left}${spaces}${right}"
	if [ "$UI_ASCII" -eq 1 ] || [ "${UI_COLOR:-0}" -eq 0 ]; then
		ui_ascii_card "$line" normal
		return 0
	fi
	ui_tty gum style --border rounded --border-foreground "$UI_ACCENT" \
		--foreground "$UI_FG" --bold --width "$UI_BOX" --padding "0 1" \
		"$line" || ui_ascii_card "$line" normal
}

ui_screen_open() {
	[ "${UI:-none}" = gum ] || return 0
	ui_term_size
	ui_clear
	ui_banner
	ui_tty printf '\n'
}

ui_nl() {
	[ "${UI:-none}" = gum ] || return 0
	ui_tty printf '\n'
}

# Close the spinner by letting its command finish. Killing it leaves
# the tty in raw mode. The fifo is held open so the write cannot block
# when gum has already exited.
ui_spin_end() {
	local pid=${UI_SPIN_PID:-}
	local fifo=${UI_SPIN_FIFO:-}
	local i=0
	if [ -n "$fifo" ]; then
		printf '\n' >"$fifo" 2>/dev/null || true
	fi
	if [ -n "${UI_SPIN_FD:-}" ]; then
		exec {UI_SPIN_FD}>&-
	fi
	UI_SPIN_PID=""
	UI_SPIN_FIFO=""
	UI_SPIN_FD=""
	if [ -n "$pid" ]; then
		while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 30 ]; do
			sleep 0.05
			i=$((i + 1))
		done
		if kill -0 "$pid" 2>/dev/null; then
			kill "$pid" 2>/dev/null || true
		fi
		wait "$pid" 2>/dev/null || true
	fi
	if [ -n "$fifo" ]; then
		rm -f "$fifo" 2>/dev/null || true
	fi
	if [ -c /dev/tty ]; then
		printf '\033[?25h' >/dev/tty 2>/dev/null || true
	fi
	return 0
}

ui_spin_begin() {
	local title=$1
	ui_spin_end
	[ "${UI:-none}" = gum ] || return 0
	ui_mark "Checking"
	ui_screen_open
	UI_SPIN_FIFO=$(mktemp -u /tmp/atelier-spin.XXXXXX)
	if ! mkfifo -m 600 "$UI_SPIN_FIFO"; then
		UI_SPIN_FIFO=""
		return 0
	fi
	# Read/write open: a later write still returns if the reader is gone.
	exec {UI_SPIN_FD}<>"$UI_SPIN_FIFO"
	if [ -c /dev/tty ]; then
		# shellcheck disable=SC2016
		gum spin --spinner "$UI_SPINNER" --title "$title" -- \
			bash -c "read -r _ < \"\$1\"" _ "$UI_SPIN_FIFO" \
			</dev/null >/dev/tty 2>/dev/tty &
	else
		gum spin --spinner "$UI_SPINNER" --title "$title" -- \
			bash -c "read -r _ < \"\$1\"" _ "$UI_SPIN_FIFO" \
			</dev/null &
	fi
	UI_SPIN_PID=$!
	return 0
}

ui_phase() {
	local name=$1
	[ "${UI:-none}" = gum ] || return 0
	if [ "$UI_ASCII" -eq 0 ] && [ "${UI_COLOR:-0}" -eq 1 ]; then
		ui_tty gum style --foreground "$UI_ACCENT" --bold ">> ${name}" || \
			ui_tty printf '>> %s\n' "$name"
		return 0
	fi
	if [ "${UI_COLOR:-0}" -eq 1 ]; then
		ui_tty printf '\033[36m>> %s\033[0m\n' "$name"
	else
		ui_tty printf '>> %s\n' "$name"
	fi
}

ui_ack() {
	local label=$1
	local pick="" rc=0
	gum_pick pick 1 "Enter continues." "$label" "$label" || rc=$?
	if [ "${UI_INTERRUPTED:-0}" -eq 1 ]; then
		UI_INTERRUPTED=0
	fi
	return 0
}

ui_panel() {
	local tone=$1 msg=$2 ack=$3
	local max fitted
	ui_spin_end
	ui_term_size
	max=$((UI_ROWS - 10))
	if [ "$max" -lt 6 ]; then
		max=6
	fi
	fitted=$(ui_fit_text "$msg" "$max" "$UI_TEXT")
	ui_screen_open
	ui_card "$fitted" "$tone"
	ui_nl
	ui_ack "$ack"
}

ui_error() {
	local msg=$1
	local saved=${UI_STEP:-}
	log "ERROR: $msg"
	case $UI in
	gum)
		ui_mark "Error"
		ui_panel error "$msg" "OK"
		UI_STEP=$saved
		;;
	*) printf 'ERROR: %s\n' "$msg" >&2 ;;
	esac
}

# Taller than ui_error so a phase name plus the log tail fit on a TTY.
ui_show_fail() {
	local msg=$1
	case $UI in
	gum)
		ui_mark "Failed"
		ui_panel error "$msg" "Close"
		;;
	*) printf 'ERROR: %s\n' "$msg" >&2 ;;
	esac
}

ui_info() {
	local msg=$1
	case $UI in
	gum)
		ui_spin_end
		ui_mark "Installing"
		ui_screen_open
		ui_card "$msg" ok
		ui_nl
		;;
	*) printf '%s\n' "$msg" ;;
	esac
}

# Completion screen. The reboot question is the next screen.
ui_result() {
	local msg=$1
	case $UI in
	gum)
		ui_mark "Finished"
		ui_panel ok "$msg" "Continue"
		;;
	*) printf '%s\n' "$msg" ;;
	esac
}

# Returns: 0=Yes, 1=No, 2=EOF (no answer).
# Escape and Ctrl+C are not answers. A blank line is not No.
# The second argument is the highlighted choice: yes (default) or no.
# Disk erase passes no, so Enter does not destroy the disk.
ui_confirm() {
	local msg=$1 focus=${2:-yes}
	local rc=0 pick="" sel="Yes"
	case $focus in
	no|No|NO) sel="No" ;;
	esac
	while true; do
		rc=0
		pick=""
		case $UI in
		gum)
			ui_screen_open
			ui_card "$msg"
			ui_nl
			UI_INTERRUPTED=0
			gum_pick pick 2 "Yes or No. Escape selects neither." "$sel" "Yes" "No" || rc=$?
			if [ "${UI_INTERRUPTED:-0}" -eq 1 ] || [ "$rc" -ne 0 ]; then
				UI_INTERRUPTED=0
				ui_error "Choose Yes or No. Escape does not select No."
				continue
			fi
			case $pick in
			Yes) return 0 ;;
			No) return 1 ;;
			*)
				ui_error "Choose Yes or No. Escape does not select No."
				;;
			esac
			;;
		*)
			printf '%s\nYes or No [y/n]: ' "$msg" >&2
			a=""
			read_line_to a || return 2
			case $a in
			y|Y|yes|YES) return 0 ;;
			n|N|no|NO) return 1 ;;
			*)
				printf 'Choose yes or no. A blank answer is not No.\n' >&2
				continue
				;;
			esac
			;;
		esac
	done
}

# Wizard page: text + Back/Next/Abort. 0=next 1=back 2=abort
wizard_page() {
	local msg=$1
	local rc=0 pick=""
	case $UI in
	gum)
		ui_screen_open
		ui_card "$msg"
		ui_nl
		UI_INTERRUPTED=0
		gum_pick pick 3 "Next continues. Back returns. Abort leaves the disk alone." \
			"Next" "Next" "Back" "Abort" || rc=$?
		if [ "${UI_INTERRUPTED:-0}" -eq 1 ] || [ "$rc" -ne 0 ]; then
			UI_INTERRUPTED=0
			return 2
		fi
		case $pick in
		Next) return 0 ;;
		Back) return 1 ;;
		*) return 2 ;;
		esac
		;;
	*)
		printf '%s\n[Enter]=Next [b]=Back [q]=Abort: ' "$msg" >&2
		a=""
		read_line_to a || return 2
		case $a in b|B) rc=1;; q|Q) rc=2;; *) rc=0;; esac
		;;
	esac
	return "$rc"
}

ui_entry() {
	local label=$1 default=${2:-} val="" rc=0 width
	case $UI in
	gum)
		ui_screen_open
		ui_card "$label"
		ui_nl
		width=$UI_TEXT
		if [ "$width" -gt 60 ]; then
			width=60
		fi
		UI_INTERRUPTED=0
		gum_capture val gum input --no-show-help --width "$width" \
			--header "Enter submits. Escape goes back." \
			--placeholder "${default:-type here}" \
			--value "$default" --prompt "> " || rc=$?
		if [ "${UI_INTERRUPTED:-0}" -eq 1 ] || [ "$rc" -ne 0 ]; then
			UI_INTERRUPTED=0
			return 1
		fi
		printf '%s\n' "${val:-$default}"
		;;
	*)
		printf '%s [%s]: ' "$label" "$default" >&2
		a=""
		read_line_to a || return 1
		printf '%s\n' "${a:-$default}"
		;;
	esac
}

ui_password() {
	local label=$1 val="" rc=0 width
	case $UI in
	gum)
		ui_screen_open
		ui_card "$label"
		ui_nl
		width=$UI_TEXT
		if [ "$width" -gt 60 ]; then
			width=60
		fi
		UI_INTERRUPTED=0
		# char-limit 0: gum treats 0 as "no limit", so a long passphrase
		# is not cut off. The value is masked and is not logged.
		gum_capture val gum input --password --no-show-help --char-limit 0 \
			--width "$width" \
			--header "Hidden. Enter submits. Escape goes back." \
			--placeholder "password" --prompt "> " || rc=$?
		if [ "${UI_INTERRUPTED:-0}" -eq 1 ] || [ "$rc" -ne 0 ]; then
			UI_INTERRUPTED=0
			return 1
		fi
		printf '%s\n' "$val"
		;;
	*)
		printf '%s: ' "$label" >&2
		a=""
		# A pipe (tests, --text) has no terminal. Do not call stty there.
		if [ -t 0 ]; then stty -echo 2>/dev/null || true; fi
		if ! read_line_to a; then
			if [ -t 0 ]; then stty echo 2>/dev/null || true; fi
			return 1
		fi
		if [ -t 0 ]; then stty echo 2>/dev/null || true; printf '\n' >&2; fi
		printf '%s\n' "$a"
		;;
	esac
}

ui_list_height() {
	local n_items=$1
	local reserve=${2:-8}
	local avail=$((UI_ROWS - reserve))
	if [ "$avail" -lt 3 ]; then
		avail=3
	fi
	# 15 edit fields fit under the banner on 80x24. A longer list pages.
	if [ "$avail" -gt 16 ]; then
		avail=16
	fi
	if [ "$n_items" -lt "$avail" ]; then
		printf '%s\n' "$n_items"
	else
		printf '%s\n' "$avail"
	fi
}

# List pick: returns selected id. Args after text: pairs id detail
# Exit status: 0 ok, 1 cancel/back, 2 EOF (text mode)
ui_list_pick() {
	local text=$1
	shift
	local pick="" rc=0
	case $UI in
	gum)
		local -a opts=()
		local id detail h n=0
		while [ $# -ge 2 ]; do
			id=$1
			detail=$2
			shift 2
			id=${id//"$UI_DELIM"/}
			detail=${detail//"$UI_DELIM"/}
			if [ -n "$detail" ] && [ "$detail" != "$id" ]; then
				opts+=("${id}  ${detail}${UI_DELIM}${id}")
			else
				opts+=("${id}${UI_DELIM}${id}")
			fi
			n=$((n + 1))
		done
		if [ "$n" -eq 0 ]; then
			return 1
		fi
		ui_screen_open
		h=$(ui_list_height "$n" 8)
		UI_INTERRUPTED=0
		gum_capture pick gum choose --no-show-help --height "$h" \
			--label-delimiter "$UI_DELIM" --header "$text" \
			-- "${opts[@]}" || rc=$?
		if [ "${UI_INTERRUPTED:-0}" -eq 1 ] || [ "$rc" -ne 0 ]; then
			UI_INTERRUPTED=0
			return 1
		fi
		if [ -z "$pick" ] || [ "$pick" != "${pick//[[:cntrl:]]/}" ]; then
			return 1
		fi
		printf '%s\n' "$pick"
		;;
	*)
		printf '%s\n' "$text" >&2
		local id detail
		while [ $# -ge 2 ]; do
			id=$1
			detail=$2
			shift 2
			printf '  %s  %s\n' "$id" "$detail" >&2
		done
		printf 'Select: ' >&2
		a=""
		if ! read_line_to a; then
			return 2
		fi
		if [ -z "$a" ]; then
			return 1
		fi
		printf '%s\n' "$a"
		;;
	esac
}

# Checklist: print selected tags one per line. Args: TAG "Label" on/off ...
# Not used by the wizard. Kept so a caller does not need dialog.
ui_checklist() {
	local text=$1
	shift
	case $UI in
	gum)
		local -a opts=() presel=()
		local t l s out="" rc=0 joined=""
		while [ $# -ge 3 ]; do
			t=$1
			l=$2
			s=$3
			shift 3
			opts+=("$t  $l")
			if [ "$s" = on ]; then
				presel+=("$t  $l")
			fi
		done
		ui_screen_open
		if [ "${#presel[@]}" -gt 0 ]; then
			joined=$(IFS=,; printf '%s' "${presel[*]}")
			gum_capture out gum choose --no-limit --no-show-help --height 8 \
				--header "$text" --selected "$joined" \
				--cursor-prefix "> " --selected-prefix "[x] " \
				--unselected-prefix "[ ] " -- "${opts[@]}" || rc=$?
		else
			gum_capture out gum choose --no-limit --no-show-help --height 8 \
				--header "$text" \
				--cursor-prefix "> " --selected-prefix "[x] " \
				--unselected-prefix "[ ] " -- "${opts[@]}" || rc=$?
		fi
		if [ "$rc" -ne 0 ]; then
			return 1
		fi
		printf '%s\n' "$out"
		;;
	*)
		printf ''
		;;
	esac
}

ensure_root() {
	if [ "$(id -u)" -eq 0 ]; then return 0; fi
	# pkexec (polkit) first, then sudo. Locale and TERM must survive so
	# gum still draws on the live TTY. Display-session variables are
	# not forwarded: this installer has no graphical front end.
	if have pkexec; then
		exec pkexec env \
			LANG="${LANG:-C.UTF-8}" LC_ALL="${LC_ALL:-${LANG:-C.UTF-8}}" \
			TERM="${TERM:-linux}" \
			"$0" "$@"
	fi
	if have sudo; then
		# TERM is required for gum on a live TTY
		exec sudo --preserve-env=LANG,LC_ALL,TERM,COLORTERM \
			"$0" "$@"
	fi
	die "Root privileges required (pkexec or sudo)."
}

is_efi() { [ -d /sys/firmware/efi ]; }

part_path() {
	local disk=$1 num=$2 base
	base=$(basename "$disk")
	if printf '%s' "$base" | grep -qE '[0-9]$'; then printf '%s\n' "${disk}p${num}"
	else printf '%s\n' "${disk}${num}"; fi
}

# LUKS passphrase lives in a 0600 keyfile, never on argv or in the log.
make_luks_keyfile() {
	local dir=/tmp f
	if [ -d /dev/shm ] && [ -w /dev/shm ]; then
		dir=/dev/shm
	fi
	f=$(mktemp "$dir/atelier-luks.XXXXXX")
	chmod 600 "$f"
	printf '%s' "$LUKSPASS" >"$f"
	printf '%s\n' "$f"
}

wipe_luks_keyfile() {
	local f=$1
	[ -n "$f" ] && [ -f "$f" ] || return 0
	if have shred; then
		shred -u "$f" 2>/dev/null || rm -f "$f"
	else
		rm -f "$f"
	fi
}

wipe_luks_pass() {
	LUKSPASS=""
}

close_cryptroot() {
	if have cryptsetup && cryptsetup status "$CRYPT_NAME" >/dev/null 2>&1; then
		cryptsetup close "$CRYPT_NAME" 2>/dev/null || true
		log "closed mapper $CRYPT_NAME"
	fi
}

luks_format_and_open() {
	local keyfile=""
	[ -n "${LUKSPASS:-}" ] || die "LUKS passphrase missing"
	[ -n "$PART_CRYPT" ] && [ -b "$PART_CRYPT" ] || die "LUKS partition missing: ${PART_CRYPT:-empty}"
	keyfile=$(make_luks_keyfile)
	if ! cryptsetup luksFormat --type luks2 --batch-mode --force-password \
		--key-file="$keyfile" "$PART_CRYPT"; then
		wipe_luks_keyfile "$keyfile"
		wipe_luks_pass
		die "cryptsetup luksFormat failed on $PART_CRYPT"
	fi
	if ! cryptsetup open --key-file="$keyfile" "$PART_CRYPT" "$CRYPT_NAME"; then
		wipe_luks_keyfile "$keyfile"
		wipe_luks_pass
		die "cryptsetup open failed on $PART_CRYPT"
	fi
	wipe_luks_keyfile "$keyfile"
	wipe_luks_pass
	PART_ROOT="/dev/mapper/$CRYPT_NAME"
	sleep 1
	udevadm settle 2>/dev/null || sleep 1
	if [ ! -b "$PART_ROOT" ]; then
		close_cryptroot
		die "mapper $PART_ROOT did not appear"
	fi
}

list_disks() {
	lsblk -dn -b -o NAME,SIZE,TYPE,MODEL 2>/dev/null | while read -r name size type model; do
		[ "$type" = "disk" ] || continue
		case $name in loop*|ram*|zram*|sr*) continue ;; esac
		model=${model:-disk}
		hs=$(lsblk -dn -o SIZE "/dev/$name" 2>/dev/null || echo "?")
		printf '%s|%s|%s\n' "/dev/$name" "$hs" "$model"
	done
}

detect_nvidia_gpu() {
	if have lspci && lspci -nn 2>/dev/null | grep -qiE 'nvidia|\[10de:'; then
		return 0
	fi
	# PCI vendor 10de even if lspci is missing or the string is odd
	grep -q '^0x10de$' /sys/bus/pci/devices/*/vendor 2>/dev/null
}

valid_hostname() {
	local h=$1
	printf '%s' "$h" | grep -qE '^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$'
}

valid_username() {
	local u=$1
	[ "$u" != "root" ] || return 1
	printf '%s' "$u" | grep -qE '^[a-z_][a-z0-9_-]{0,31}$'
}

valid_locale() {
	local loc=$1
	case $loc in
	POSIX|C) return 0 ;;
	esac
	printf '%s' "$loc" | grep -qE '^[A-Za-z0-9][A-Za-z0-9_.@+-]*$'
}

valid_keymap() {
	local km=$1
	printf '%s' "$km" | grep -qE '^[A-Za-z0-9][A-Za-z0-9_-]*$'
}

valid_pkgname() {
	local p=$1
	printf '%s' "$p" | grep -qE '^[a-z0-9][a-z0-9+_.-]*$'
}

# Relative zoneinfo path: America/New_York, US/Eastern, UTC.
# posix/ and right/ duplicate the tree. Metadata files are not zones.
# When ZONEINFO_DIR exists, the name must be a file or a symlink to one
# (US/* compatibility names are symlinks in tzdata).
valid_timezone() {
	local tz=$1
	[ -n "$tz" ] || return 1
	case $tz in
	.*|/*|*/..|*/../*) return 1 ;;
	posix|posix/*|right|right/*) return 1 ;;
	*.tab|Factory|localtime|leapseconds|leap-seconds.list|tzdata.zi|posixrules) return 1 ;;
	*[!A-Za-z0-9_+-/]*) return 1 ;;
	esac
	if [ -d "$ZONEINFO_DIR" ]; then
		[ -e "$ZONEINFO_DIR/$tz" ] || return 1
		# A directory (America) is not a zone. Symlinks to zone files are.
		[ -d "$ZONEINFO_DIR/$tz" ] && return 1
	fi
	return 0
}

# Build the zone list from tzdata. Do not call timedatectl (Void has no
# systemd) and do not truncate: a 400-name cap drops Pacific/* and US/*
# after an alphabetical sort.
list_timezones() {
	local root=$ZONEINFO_DIR f rel
	[ -d "$root" ] || return 0
	while IFS= read -r f; do
		[ -n "$f" ] || continue
		case $f in
		"$root"/posix/*|"$root"/right/*) continue ;;
		esac
		rel=${f#"$root"/}
		[ "$rel" != "$f" ] || continue
		valid_timezone "$rel" || continue
		printf '%s\n' "$rel"
	done < <(find "$root" \( -type f -o -type l \) \
		! -path "$root/posix" ! -path "$root/posix/*" \
		! -path "$root/right" ! -path "$root/right/*" \
		-print 2>/dev/null) | sort -u
}

# --- wizard steps: print nav code via return; mutate globals -----------------
# Convention: return 0 next, 1 back, 2 abort

# RAM rounded up to the next GiB (hibernation needs swap >= RAM).
swap_size_gib() {
	local mem_kb gib
	mem_kb=$(awk '/MemTotal:/ { print $2; exit }' /proc/meminfo) || mem_kb=0
	[ "${mem_kb:-0}" -gt 0 ] || mem_kb=1048576
	gib=$(((mem_kb * 1024 + 1073741823) / 1073741824))
	[ "$gib" -ge 1 ] || gib=1
	printf '%s\n' "$gib"
}

# --- preset and field editors -------------------------------------------------
# Keep these defaults aligned with installer/install.conf.

set_mirror() {
	local url=$1
	url=${url%/}
	case $url in
	http://*|https://*) ;;
	*) return 1 ;;
	esac
	VOID_REPO=$url
	VOID_NONFREE_REPO="${VOID_REPO}/nonfree"
}

parse_bool() {
	local v=${1,,}
	case $v in
	y|yes|1|true|on) printf 'yes\n' ;;
	n|no|0|false|off) printf 'no\n' ;;
	*) return 1 ;;
	esac
}

apply_nvidia_policy() {
	case $NVIDIA_MODE in
	yes) INSTALL_NVIDIA=1 ;;
	no) INSTALL_NVIDIA=0 ;;
	auto)
		if detect_nvidia_gpu; then
			INSTALL_NVIDIA=1
		else
			INSTALL_NVIDIA=0
		fi
		;;
	*) return 1 ;;
	esac
}

# Split a package list on whitespace. Rejects globs and invalid names.
# On failure, ASSIGN_PACKAGES_ERR holds the bad token and the live list
# is left unchanged.
assign_packages() {
	local raw=$1 p
	local -a words=()
	local -a next=()
	set -f
	# Intentional word split. set -f blocks globbing.
	# shellcheck disable=SC2206
	words=($raw)
	set +f
	for p in "${words[@]}"; do
		[ -n "$p" ] || continue
		if ! valid_pkgname "$p"; then
			ASSIGN_PACKAGES_ERR=$p
			return 1
		fi
		next+=("$p")
	done
	if [ ${#next[@]} -eq 0 ]; then
		PKG_EXTRA=()
	else
		PKG_EXTRA=("${next[@]}")
	fi
	ASSIGN_PACKAGES_ERR=""
}

# installer/gaming.txt when running from the repo. The package copies it
# to /usr/share/atelier/installer/gaming.txt. GAMING_LIST overrides both.
gaming_list_path() {
	local src dir
	if [ -n "${GAMING_LIST:-}" ]; then
		if [ -f "$GAMING_LIST" ]; then
			printf '%s\n' "$GAMING_LIST"
			return 0
		fi
		die "GAMING_LIST is not a file: $GAMING_LIST"
	fi
	src=${BASH_SOURCE[0]}
	dir=$(dirname "$src")
	if [ -f "$dir/gaming.txt" ]; then
		printf '%s\n' "$dir/gaming.txt"
		return 0
	fi
	if [ -f /usr/share/atelier/installer/gaming.txt ]; then
		printf '%s\n' /usr/share/atelier/installer/gaming.txt
		return 0
	fi
	printf '\n'
}

# repo lines enable repositories. nvidia lines are installed only when
# the proprietary NVIDIA packages are on the target. Other lines are the
# Steam and 32-bit stack, installed after a sync.
load_gaming_list() {
	local file line kind name lineno=0
	local -a words=()
	GAMING_REPO_PKGS=()
	GAMING_PKGS=()
	GAMING_NVIDIA_PKGS=()
	file=$(gaming_list_path)
	GAMING_LIST_FILE=$file
	if [ -z "$file" ]; then
		log "gaming package list not found"
		return 0
	fi
	[ -r "$file" ] || die "Gaming package list is not readable: $file"
	log "loading gaming package list $file"
	while IFS= read -r line || [ -n "$line" ]; do
		lineno=$((lineno + 1))
		line=${line%$'\r'}
		line=${line%%#*}
		line="${line#"${line%%[![:space:]]*}"}"
		line="${line%"${line##*[![:space:]]}"}"
		[ -n "$line" ] || continue
		set -f
		# Intentional word split. set -f blocks globbing.
		# shellcheck disable=SC2206
		words=($line)
		set +f
		if [ ${#words[@]} -eq 1 ]; then
			kind=pkg
			name=${words[0]}
		elif [ ${#words[@]} -eq 2 ]; then
			kind=${words[0]}
			name=${words[1]}
			case $kind in
			repo|pkg|nvidia) ;;
			*) die "Gaming list $file:$lineno: tag must be repo, pkg, or nvidia" ;;
			esac
		else
			die "Gaming list $file:$lineno: expected one package per line"
		fi
		if ! valid_pkgname "$name"; then
			die "Gaming list $file:$lineno: invalid package name '$name'"
		fi
		case $kind in
		repo) GAMING_REPO_PKGS+=("$name") ;;
		nvidia) GAMING_NVIDIA_PKGS+=("$name") ;;
		*) GAMING_PKGS+=("$name") ;;
		esac
	done <"$file"
	log "gaming repos=${GAMING_REPO_PKGS[*]:-(none)} pkgs=${GAMING_PKGS[*]:-(none)} nvidia=${GAMING_NVIDIA_PKGS[*]:-(none)}"
}

load_preset() {
	local file=$1 line key val bool
	local lineno=0
	[ -f "$file" ] || die "Preset not found: $file"
	[ -r "$file" ] || die "Preset is not readable: $file"
	log "loading preset $file"
	while IFS= read -r line || [ -n "$line" ]; do
		lineno=$((lineno + 1))
		line=${line%$'\r'}
		line=${line%%#*}
		line="${line#"${line%%[![:space:]]*}"}"
		line="${line%"${line##*[![:space:]]}"}"
		[ -n "$line" ] || continue
		case $line in
		*=*) ;;
		*) die "Preset $file:$lineno: expected KEY=value" ;;
		esac
		key=${line%%=*}
		val=${line#*=}
		key="${key#"${key%%[![:space:]]*}"}"
		key="${key%"${key##*[![:space:]]}"}"
		val="${val#"${val%%[![:space:]]*}"}"
		val="${val%"${val##*[![:space:]]}"}"
		case $val in
		\"*\") val=${val#\"}; val=${val%\"} ;;
		\'*\') val=${val#\'}; val=${val%\'} ;;
		esac
		key=${key^^}
		case $key in
		HOSTNAME)
			# Empty means "ask". A private preset may set a real name.
			if [ -z "$val" ]; then
				HOSTNAME=""
			elif valid_hostname "$val"; then
				HOSTNAME=$val
			else
				die "Preset $file:$lineno: invalid HOSTNAME '$val'"
			fi
			;;
		USERNAME)
			if [ -z "$val" ]; then
				USERNAME=""
			elif valid_username "$val"; then
				USERNAME=$val
			else
				die "Preset $file:$lineno: invalid USERNAME '$val'"
			fi
			;;
		TIMEZONE)
			valid_timezone "$val" || die "Preset $file:$lineno: invalid TIMEZONE '$val'"
			TIMEZONE=$val
			;;
		LOCALE)
			valid_locale "$val" || die "Preset $file:$lineno: invalid LOCALE '$val'"
			LOCALE=$val
			;;
		KEYMAP)
			valid_keymap "$val" || die "Preset $file:$lineno: invalid KEYMAP '$val'"
			KEYMAP=$val
			;;
		MIRROR)
			set_mirror "$val" || die "Preset $file:$lineno: invalid MIRROR '$val'"
			;;
		NVIDIA)
			val=${val,,}
			case $val in
			auto|yes|no) NVIDIA_MODE=$val ;;
			*) die "Preset $file:$lineno: NVIDIA must be auto, yes, or no" ;;
			esac
			;;
		ENCRYPT)
			bool=$(parse_bool "$val") || die "Preset $file:$lineno: ENCRYPT must be yes or no"
			if [ "$bool" = yes ]; then
				ENCRYPT_DISK=1
			else
				ENCRYPT_DISK=0
				wipe_luks_pass
			fi
			;;
		SWAP)
			bool=$(parse_bool "$val") || die "Preset $file:$lineno: SWAP must be yes or no"
			if [ "$bool" = yes ]; then CREATE_SWAP=1; else CREATE_SWAP=0; fi
			;;
		GRUB)
			bool=$(parse_bool "$val") || die "Preset $file:$lineno: GRUB must be yes or no"
			if [ "$bool" = yes ]; then INSTALL_BOOTLOADER=1; else INSTALL_BOOTLOADER=0; fi
			;;
		GAMING)
			bool=$(parse_bool "$val") || die "Preset $file:$lineno: GAMING must be yes or no"
			if [ "$bool" = yes ]; then INSTALL_GAMING=1; else INSTALL_GAMING=0; fi
			;;
		PACKAGES)
			if ! assign_packages "$val"; then
				die "Preset $file:$lineno: invalid package name '${ASSIGN_PACKAGES_ERR:-}'"
			fi
			;;
		*)
			die "Preset $file:$lineno: unknown key '$key'"
			;;
		esac
	done <"$file"
	PRESET_FILE=$file
	apply_nvidia_policy || die "Invalid NVIDIA mode '$NVIDIA_MODE'"
	log "preset HOSTNAME=$HOSTNAME USERNAME=$USERNAME TIMEZONE=$TIMEZONE LOCALE=$LOCALE KEYMAP=$KEYMAP"
	log "preset NVIDIA_MODE=$NVIDIA_MODE INSTALL_NVIDIA=$INSTALL_NVIDIA INSTALL_GAMING=$INSTALL_GAMING ENCRYPT_DISK=$ENCRYPT_DISK CREATE_SWAP=$CREATE_SWAP INSTALL_BOOTLOADER=$INSTALL_BOOTLOADER"
	log "preset MIRROR=$VOID_REPO PACKAGES=${PKG_EXTRA[*]:-(none)}"
}

prompt_hostname() {
	local h
	ui_mark_step 3 Hostname
	while true; do
		ui_read h ui_entry "Hostname:" "$HOSTNAME" || return 1
		h=${h// /}
		if valid_hostname "$h"; then
			HOSTNAME=$h
			log "HOSTNAME=$HOSTNAME"
			return 0
		fi
		ui_error "Invalid hostname '$h'. Use letters, digits, and hyphens (not first or last)."
	done
}

# Do not strip characters before checking. Deleting invalid characters
# turned 'Kevin' into 'evin' and accepted it with no error.
prompt_username() {
	local u
	ui_mark_step 4 Username
	while true; do
		ui_read u ui_entry "Username (lowercase):" "$USERNAME" || return 1
		if valid_username "$u"; then
			USERNAME=$u
			log "USERNAME=$USERNAME"
			return 0
		fi
		ui_error "Invalid username '$u'.
Use 1-32 of: lowercase letters, digits, underscore, hyphen.
Start with a letter or underscore. 'root' is not allowed.
Characters are not removed; type a valid name."
	done
}

prompt_user_password() {
	local p1 p2
	ui_mark_step 5 Password
	while true; do
		ui_read p1 ui_password "Password for $USERNAME.

Root is locked. This user is in the wheel group
and can run commands with sudo.
This is the only login password." || return 1
		ui_read p2 ui_password "Confirm password for $USERNAME:" || return 1
		if [ -n "$p1" ] && [ "$p1" = "$p2" ]; then
			USERPASS=$p1
			log "user password set for $USERNAME"
			return 0
		fi
		ui_error "Passwords empty or do not match. Try again."
	done
}

prompt_luks_passphrase() {
	local p1 p2
	ui_mark_step 6 Encryption
	while true; do
		ui_read p1 ui_password "LUKS passphrase (required at every boot):" || return 1
		ui_read p2 ui_password "Confirm LUKS passphrase:" || return 1
		if [ -z "$p1" ]; then
			ui_error "Passphrase cannot be empty."
			continue
		fi
		if [ "${#p1}" -lt 8 ]; then
			ui_error "Passphrase must be at least 8 characters."
			continue
		fi
		if [ "$p1" != "$p2" ]; then
			ui_error "Passphrases do not match. Try again."
			continue
		fi
		LUKSPASS=$p1
		log "LUKS passphrase set"
		return 0
	done
}

pick_timezone() {
	local args=() tz pick found=0
	while IFS= read -r tz; do
		[ -n "$tz" ] || continue
		if [ "$tz" = "$TIMEZONE" ]; then
			args+=("$tz" "current")
			found=1
		else
			args+=("$tz" "$tz")
		fi
	done < <(list_timezones)
	if [ "$found" -eq 0 ] && [ -n "$TIMEZONE" ]; then
		args=("$TIMEZONE" "current" "${args[@]}")
	fi
	if [ ${#args[@]} -eq 0 ]; then
		ui_error "No timezones found under $ZONEINFO_DIR."
		return 1
	fi
	ui_read pick ui_list_pick "Select timezone:" "${args[@]}" || return 1
	if ! valid_timezone "$pick"; then
		ui_error "Invalid timezone: $pick"
		return 1
	fi
	TIMEZONE=$pick
	log "TIMEZONE=$TIMEZONE"
}

pick_locale() {
