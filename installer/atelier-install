		if [ "${INSTALL_NVIDIA:-0}" -eq 1 ]; then
			printf 'yes (Steam + NVIDIA 32-bit)\n'
		else
			printf 'yes (Steam)\n'
		fi
	else
		printf 'no\n'
	fi
}

summary_text() {
	local mode=BIOS ns enc sw bl pkgs pw preset gs
	is_efi && mode=UEFI
	gs=$(gaming_label)
	case $NVIDIA_MODE in
	auto)
		if [ "$INSTALL_NVIDIA" -eq 1 ]; then
			ns="yes (auto, GPU detected)"
		else
			ns="no (auto, no GPU)"
		fi
		;;
	yes) ns=yes ;;
	no) ns=no ;;
