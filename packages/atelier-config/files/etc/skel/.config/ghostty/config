# Atelier — ghostty
# https://ghostty.org/docs/config
#
# Font: Fira Code is shipped via atelier-base (font-firacode).
# JetBrains Mono is planned but not yet packaged — do not require it here.
# Palette: generated by atelier-theme (`?` = optional until first apply).

config-file = ?../atelier/current/ghostty.conf

font-family = Fira Code
font-family-bold = Fira Code
font-size = 12

# Slight transparency; picom opacity-rule also softens the window.
# Keep high enough for readable text; browsers stay fully opaque in picom.
background-opacity = 0.75
minimum-contrast = 1.1
window-decoration = none

window-padding-x = 8
window-padding-y = 8
window-theme = dark
confirm-close-surface = false
clipboard-paste-protection = false
