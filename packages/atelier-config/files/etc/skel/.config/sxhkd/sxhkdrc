# Atelier — sxhkd hotkeys for bspwm
# Super (mod4) is the main modifier. Keep bindings easy to remember.

# --- Terminal / launcher -----------------------------------------------------
# Prefer ghostty; fall back to xterm if ghostty fails to start (e.g. odd GL).
super + Return
	sh -c 'command -v ghostty >/dev/null && exec ghostty || exec xterm'

# Call /usr/bin/atelier-rofi (simple path - nested quotes break under sxhkd)
super + d
	atelier-rofi drun

super + shift + d
	atelier-rofi run

# --- Window close / kill -----------------------------------------------------
super + w
	bspc node -c

super + shift + w
	bspc node -k

# --- Focus (vim-like; k reserved for Super+k keybind cheat sheet) ------------
super + {h,j,l}
	bspc node -f {west,south,east}

super + {Left,Down,Up,Right}
	bspc node -f {west,south,north,east}

# --- Swap --------------------------------------------------------------------
super + shift + {h,j,k,l}
	bspc node -s {west,south,north,east}

# --- Resize (expand/contract) ------------------------------------------------
super + alt + {h,j,k,l}
	bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# --- Preselect / split -------------------------------------------------------
super + ctrl + {h,j,k,l}
	bspc node -p {west,south,north,east}

super + ctrl + space
	bspc node -p cancel

# --- State -------------------------------------------------------------------
super + shift + space
	bspc node -t floating
super + f
	bspc node -t fullscreen
super + t
	bspc node -t tiled

# --- Desktops (primary 1-6, secondary 7-9 on dual-head) ----------------------
# Use desktop NAMES (1-9), not ^N. ^N means "Nth desktop in global order"
# and breaks when the secondary monitor is ordered first (Super+1 → desk 7).
super + {1-9}
	bspc desktop -f {1-9}

super + shift + {1-9}
	bspc node -d {1-9} --follow

# --- Rotate / balance --------------------------------------------------------
super + r
	bspc node @/ -R 90

super + equal
	bspc node @/ -B

# --- Reload configs ----------------------------------------------------------
super + Escape
	pkill -USR1 -x sxhkd

super + shift + r
	bspc wm -r

# --- Lock / quit session -----------------------------------------------------
super + shift + l
	xsecurelock

super + shift + q
	bspc quit

# Multi-monitor layout wizard (writes ~/.config/atelier/monitors.conf)
super + shift + m
	atelier-monitors setup

# Keybind cheat sheet (floating centered TUI; toggle)
# Prefer PATH (/usr/bin from package); fall back to ~/bin for local installs
super + k
	sh -c 'command -v atelier-keybinds >/dev/null 2>&1 && exec atelier-keybinds; exec "$HOME/bin/atelier-keybinds"'

# --- Audio (PipeWire via pactl / pavucontrol) --------------------------------
XF86AudioRaiseVolume
	pactl set-sink-volume @DEFAULT_SINK@ +5%

XF86AudioLowerVolume
	pactl set-sink-volume @DEFAULT_SINK@ -5%

XF86AudioMute
	pactl set-sink-mute @DEFAULT_SINK@ toggle

# Volume mixer GUI
super + shift + v
	pavucontrol

# --- Common apps (PLAN set) --------------------------------------------------
super + shift + b
	xdg-open about:blank 2>/dev/null || true
# Prefer brave when packaged; fall back is intentional for Step 2
super + b
	sh -c 'command -v brave-browser >/dev/null && exec brave-browser || command -v brave >/dev/null && exec brave || command -v chromium >/dev/null && exec chromium || exec xdg-open about:blank'

super + e
	nemo

super + shift + Return
	sh -c 'command -v ghostty >/dev/null && exec ghostty -e neovim || exec xterm -e neovim'
