# Atelier — sxhkd hotkeys for bspwm
# Super (mod4) is the main modifier. Keep bindings easy to remember.
# Omarchy-inspired additions: Space launcher, Shift+F files, scratchpad,
# screenshots (no Print key), power menu, btop, brightness.

# --- Terminal / launcher -----------------------------------------------------
# Prefer ghostty; fall back to xterm if ghostty fails to start (e.g. odd GL).
super + Return
	sh -c 'command -v ghostty >/dev/null && exec ghostty || exec xterm'

# Primary launcher (Omarchy-like Super+Space); Super+d kept as alias
super + space
	atelier-rofi drun

# System control menu (Omarchy-like Super+Alt+Space)
super + alt + space
	atelier-menu

# Theme picker (Omarchy-like Super+Ctrl+Shift+Space)
super + ctrl + shift + space
	atelier-menu theme

super + d
	atelier-rofi drun

super + shift + d
	atelier-rofi run

# --- Window close / kill -----------------------------------------------------
super + w
	bspc node -c

super + shift + w
	bspc node -k

# --- Focus (vim-like; k reserved for Super+k keybind cheat sheet) ------------
super + {h,j,l}
	bspc node -f {west,south,east}

super + {Left,Down,Up,Right}
	bspc node -f {west,south,north,east}

# --- Swap --------------------------------------------------------------------
# Note: Super+Shift+l is reserved for lock (atelier-lock) — use arrows for east.
super + shift + {h,j,k}
	bspc node -s {west,south,north}

super + shift + {Left,Down,Up,Right}
	bspc node -s {west,south,north,east}

# --- Resize (expand/contract) ------------------------------------------------
super + alt + {h,j,k,l}
	bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# --- Preselect / split -------------------------------------------------------
super + ctrl + {h,j,k,l}
	bspc node -p {west,south,north,east}

super + ctrl + space
	bspc node -p cancel

# --- State (Atelier semantics: explicit tiled / float / fullscreen) ----------
super + shift + space
	bspc node -t floating
super + f
	bspc node -t fullscreen
super + t
	bspc node -t tiled

# --- Scratchpad (Omarchy-inspired) -------------------------------------------
super + s
	atelier-scratchpad toggle

super + alt + s
	atelier-scratchpad send

# --- Desktops (primary 1-6, secondary 7-9 on dual-head) ----------------------
# Use desktop NAMES (1-9), not ^N. ^N means "Nth desktop in global order"
# and breaks when the secondary monitor is ordered first (Super+1 → desk 7).
super + {1-9}
	bspc desktop -f {1-9}

super + shift + {1-9}
	bspc node -d {1-9} --follow

# --- Rotate / balance --------------------------------------------------------
super + r
	bspc node @/ -R 90

super + equal
	bspc node @/ -B

# --- Reload configs ----------------------------------------------------------
super + Escape
	pkill -USR1 -x sxhkd

super + shift + r
	bspc wm -r

# --- Lock / quit / power -----------------------------------------------------
# Use atelier-lock (sources XSECURELOCK_* env; talks to xss-lock when running)
super + shift + l
	sh -c 'command -v atelier-lock >/dev/null 2>&1 && exec atelier-lock; exec "$HOME/bin/atelier-lock"'

# Omarchy-like lock alias
super + ctrl + l
	sh -c 'command -v atelier-lock >/dev/null 2>&1 && exec atelier-lock; exec "$HOME/bin/atelier-lock"'

super + shift + q
	bspc quit

# Power menu (do not steal Super+Escape — that reloads sxhkd)
super + ctrl + Escape
	atelier-power-menu

# Multi-monitor layout wizard (writes ~/.config/atelier/monitors.conf)
super + shift + m
	atelier-monitors setup

# Keybind cheat sheet (floating centered TUI; toggle)
super + k
	sh -c 'command -v atelier-keybinds >/dev/null 2>&1 && exec atelier-keybinds; exec "$HOME/bin/atelier-keybinds"'

# --- Audio (PipeWire via pactl / pavucontrol) --------------------------------
XF86AudioRaiseVolume
	pactl set-sink-volume @DEFAULT_SINK@ +5%

XF86AudioLowerVolume
	pactl set-sink-volume @DEFAULT_SINK@ -5%

XF86AudioMute
	pactl set-sink-mute @DEFAULT_SINK@ toggle

# Fine volume (±1%)
alt + XF86AudioRaiseVolume
	pactl set-sink-volume @DEFAULT_SINK@ +1%

alt + XF86AudioLowerVolume
	pactl set-sink-volume @DEFAULT_SINK@ -1%

# Volume mixer GUI
super + shift + v
	pavucontrol

# --- Brightness (laptops; no-op friendly if brightnessctl missing) -----------
XF86MonBrightnessUp
	sh -c 'command -v brightnessctl >/dev/null && brightnessctl set +5% || true'

XF86MonBrightnessDown
	sh -c 'command -v brightnessctl >/dev/null && brightnessctl set 5%- || true'

# --- Capture (no Print key — Omarchy-style chords) ---------------------------
# Menu: region / window / full
super + ctrl + c
	atelier-screenshot menu

# Region select → clipboard + ~/Pictures/Screenshots
super + shift + s
	atelier-screenshot region

# Full screen
super + shift + ctrl + s
	atelier-screenshot full

# Focused window
super + shift + alt + s
	atelier-screenshot window

# --- Activity / apps (PLAN set) ----------------------------------------------
# Floating btop (Omarchy Super+Ctrl+T)
super + ctrl + t
	atelier-btop

super + shift + b
	xdg-open about:blank 2>/dev/null || true

# Prefer brave when packaged; fall back is intentional for Step 2
super + b
	sh -c 'command -v brave-browser >/dev/null && exec brave-browser || command -v brave >/dev/null && exec brave || command -v chromium >/dev/null && exec chromium || exec xdg-open about:blank'

# Files: Omarchy-like Super+Shift+F primary; Super+e kept as alias
super + shift + f
	nemo

super + e
	nemo

super + shift + Return
	sh -c 'command -v ghostty >/dev/null && exec ghostty -e neovim || exec xterm -e neovim'
