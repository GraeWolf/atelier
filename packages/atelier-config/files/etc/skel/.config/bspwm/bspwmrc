#!/bin/sh
# Atelier — bspwm configuration
# Keep this file simple and well-commented.
# Colors/wallpaper come from atelier-theme (~/.config/atelier/current/).

# --- Autostart ---------------------------------------------------------------
# Hotkeys
pgrep -x sxhkd >/dev/null || sxhkd &

# Compositor: terminal transparency, opaque browsers, vsync (less tearing).
# picom.conf prefers glx; fall back to xrender if glx fails (VMs).
_picom_cfg="${XDG_CONFIG_HOME:-$HOME/.config}/picom/picom.conf"
if [ -z "${ATELIER_SKIP_PICOM:-}" ]; then
	pkill -x picom 2>/dev/null || true
	sleep 0.1
	if [ -f "$_picom_cfg" ]; then
		picom --config "$_picom_cfg" -b 2>/tmp/atelier-picom.log \
			|| picom --backend xrender --vsync -b 2>>/tmp/atelier-picom.log \
			|| true
	else
		picom --backend xrender --vsync -b 2>/tmp/atelier-picom.log || true
	fi
fi
unset _picom_cfg

# Status bar
if [ -x "$HOME/.config/polybar/launch.sh" ]; then
	"$HOME/.config/polybar/launch.sh" &
fi

# Screen lock on idle / sleep (xss-lock → atelier-lock → xsecurelock)
# Idle timeout is set in ~/.xinitrc via `xset s`. Env from xsecurelock/env.sh.
if command -v xss-lock >/dev/null 2>&1; then
	pkill -x xss-lock 2>/dev/null || true
	_locker=atelier-lock
	command -v atelier-lock >/dev/null 2>&1 || _locker=xsecurelock
	_dimmer=""
	for _d in /usr/libexec/xsecurelock/dimmer /usr/lib/xsecurelock/dimmer; do
		if [ -x "$_d" ]; then
			_dimmer=$_d
			break
		fi
	done
	if [ -n "$_dimmer" ]; then
		xss-lock -n "$_dimmer" -l -- "$_locker" --as-locker &
	else
		xss-lock -l -- "$_locker" --as-locker &
	fi
	unset _locker _dimmer _d
fi

# Wallpaper: themed copy from atelier-theme, else stock, else solid
_colors="${XDG_CONFIG_HOME:-$HOME/.config}/atelier/current/bspwm-colors.sh"
if [ -f "$_colors" ]; then
	# shellcheck source=/dev/null
	. "$_colors"
fi
WALL="${ATELIER_WALLPAPER:-${XDG_CONFIG_HOME:-$HOME/.config}/atelier/current/wallpaper.png}"
if [ ! -f "$WALL" ]; then
	for _w in /usr/share/atelier/wallpaper.png /usr/share/atelier/wallpaper.jpg \
		/usr/share/atelier/wallpaper.jpeg /usr/share/atelier/wallpaper.webp
	do
		if [ -f "$_w" ]; then
			WALL=$_w
			break
		fi
	done
	unset _w
fi
if [ -f "$WALL" ] && command -v feh >/dev/null 2>&1; then
	feh --no-fehbg --bg-fill "$WALL" &
else
	xsetroot -solid "${ATELIER_BG:-#1a1b26}"
fi
unset _colors

# --- Monitors / desktops -----------------------------------------------------
# Layout (primary + side) is applied by atelier-monitors in ~/.xinitrc before
# bspwm starts. Here we only assign workspaces.
#   1 monitor  → desktops 1-9
#   2 monitors → primary 1-6, secondary 7-9
# Polybar pin-workspaces shows only this monitor's desktops per bar.
# Reconfigure layout: Super+Shift+m  or  atelier-monitors setup
bspc config remove_disabled_monitors  true
bspc config remove_unplugged_monitors true

_prim=""
if command -v xrandr >/dev/null 2>&1; then
	_prim=$(xrandr --query 2>/dev/null | awk '/ connected primary/{ print $1; exit }')
fi

# Order: primary first, then remaining bspwm monitor names
_ordered=""
_seen_prim=0
for _m in $(bspc query -M --names 2>/dev/null); do
	[ -n "$_m" ] || continue
	if [ -n "$_prim" ] && [ "$_m" = "$_prim" ]; then
		_ordered="$_prim $_ordered"
		_seen_prim=1
	else
		_ordered="$_ordered $_m"
	fi
done
if [ -n "$_prim" ] && [ "$_seen_prim" -eq 0 ]; then
	_ordered="$_prim $_ordered"
fi
# shellcheck disable=SC2086
set -- $_ordered

if [ "$#" -le 1 ]; then
	if [ -n "${1:-}" ]; then
		bspc monitor "$1" -d 1 2 3 4 5 6 7 8 9
	else
		bspc monitor -d 1 2 3 4 5 6 7 8 9
	fi
else
	# $1 = primary, $2 = secondary (e.g. left-of primary)
	bspc monitor "$1" -d 1 2 3 4 5 6
	bspc monitor "$2" -d 7 8 9
	# Keep primary first in bspwm's monitor list (focus order, ^ indices, polybar)
	bspc wm -O "$@" 2>/dev/null || true
	shift 2
	_n=10
	for _m in "$@"; do
		bspc monitor "$_m" -d "$_n"
		_n=$((_n + 1))
	done
fi
unset _prim _ordered _seen_prim _m _n

# --- Gaps, borders, colors ---------------------------------------------------
bspc config border_width         2
bspc config window_gap           8
bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true
bspc config focus_follows_pointer true

bspc config normal_border_color   "${ATELIER_BORDER_NORMAL:-#414868}"
bspc config active_border_color   "${ATELIER_BORDER_ACTIVE:-#7aa2f7}"
bspc config focused_border_color  "${ATELIER_BORDER_FOCUSED:-#7aa2f7}"
bspc config presel_feedback_color "${ATELIER_PRESEL:-#bb9af7}"

# --- Rules (optional, keep minimal) ------------------------------------------
# Floating helpers (one-shot -o also set by the launcher scripts)
bspc rule -a XTerm:atelier-nmtui state=floating center=on focus=on
bspc rule -a XTerm:atelier-keys state=floating center=on focus=on
bspc rule -a XTerm:atelier-btop state=floating center=on focus=on
# Scratchpad members are marked sticky+floating by atelier-scratchpad
# bspc rule -a Gimp desktop='^8' state=floating follow=on
# bspc rule -a Brave-browser desktop='^2'
