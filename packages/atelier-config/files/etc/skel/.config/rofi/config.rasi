/* Atelier — rofi main config (palette from atelier-theme) */
configuration {
	modi: "drun,run,window";
	show-icons: true;
	icon-theme: "Papirus-Dark";
	/* Fira Code is installed via atelier-base; JetBrains Mono is not yet packaged */
	font: "Fira Code 11";
	drun-display-format: "{name}";
	disable-history: false;
	sidebar-mode: false;
	terminal: "ghostty";
	/* Do not override kb-row-up/down with Control+k/j — those collide with
	   rofi defaults (e.g. Control+k is already bound) and abort startup. */
}

@theme "~/.config/atelier/current/rofi"
