#!/bin/sh
# Unload MediaTek mt7921e/mt7925e around sleep/hibernate.
#
# pci_pm_restore -110 (Message 00020007 timeout) hangs the kernel. rmmod
# often fails (Bluetooth holds the chip), so also unbind + PCI-remove.
# Reload after unlock (not during the lock prompt): probing mt7921e in the
# post hook hung the kernel. Wait for xsecurelock to exit, then PCI-rescan
# and modprobe.
#
# Called as: atelier-wifi <pre|post> <suspend|hibernate|...>
# Always exit 0.
#
# elogind does not suspend until this pre hook returns. Every external
# command and every sysfs write is bounded by timeout(1), and pre always
# logs "pre: start" first and "pre: leave elapsed=Ns" last.
#
# Test aid: ATELIER_PM_LOG and ATELIER_WIFI_RUNDIR override the log file
# and the directory for the state files.
_run=${ATELIER_WIFI_RUNDIR:-/run}
STASH=$_run/atelier-wifi.mod
SVLIST=$_run/atelier-wifi.sv
LOG=${ATELIER_PM_LOG:-/var/log/atelier-pm.log}
_t0=$(date +%s 2>/dev/null || echo 0)

log() {
	printf '%s atelier-wifi: %s\n' \
		"$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date)" "$*" \
		>>"$LOG" 2>/dev/null || true
}

# bounded SECS CMD...: run CMD, killed after SECS (KILL one second later).
if command -v timeout >/dev/null 2>&1; then
	bounded() {
		_secs=$1
		shift
		timeout -k 1 "$_secs" "$@"
	}
else
	bounded() {
		shift
		"$@"
	}
fi

# sysfs_write VALUE FILE: a driver unbind/remove can block in the kernel;
# a shell builtin redirect cannot be timed out, so write from a child.
sysfs_write() {
	# shellcheck disable=SC2016 # $1/$2 expand in the child shell
	bounded 3 sh -c 'printf "%s\n" "$1" >"$2"' sh "$1" "$2" >/dev/null 2>&1
}

# shellcheck disable=SC2120 # optional note; the signal trap passes one
_leave_pre() {
	log "pre: leave elapsed=$(( $(date +%s 2>/dev/null || echo 0) - _t0 ))s${1:+ $1}"
}

have_mod() {
	grep -q "^$1 " /proc/modules 2>/dev/null
}

# modprobe -r on btusb/btmtk can block inside the driver for a long time.
# elogind will not enter S3 until this hook returns. One attempt, killed
# after 3s. Skip the unload entirely unless a MediaTek PCI wifi function
# (mt7921e/mt7925e) is bound — that is the chip whose pci_pm_restore -110
# this hook exists for. A desktop USB dongle is left alone.
modprobe_r_bounded() {
	mod=$1
	have_mod "$mod" || return 0
	printf '%s\n' "$mod" >>"$STASH"
	log "pre: modprobe -r $mod (3s cap)"
	bounded 3 modprobe -r "$mod" >/dev/null 2>&1 || true
	if have_mod "$mod"; then
		log "WARN: $mod still loaded; not retrying"
	else
		log "pre: unloaded $mod"
	fi
}

mt_pci_bound() {
	drv=$1
	drvdir=/sys/bus/pci/drivers/$drv
	[ -d "$drvdir" ] || return 1
	for link in "$drvdir"/0000:*; do
		[ -e "$link" ] || continue
		return 0
	done
	return 1
}

wifi_down() {
	log "pre: start $*"
	trap '_leave_pre "(signal)"; exit 0' TERM INT HUP
	if [ -w /sys/power/pm_async ]; then
		sysfs_write 0 /sys/power/pm_async || true
	fi
	# Not ": >file": a failed redirect on a special builtin exits sh.
	true >"$STASH" 2>/dev/null || log "WARN: cannot write $STASH"
	true >"$SVLIST" 2>/dev/null || log "WARN: cannot write $SVLIST"

	if command -v nmcli >/dev/null 2>&1; then
		bounded 2 nmcli radio wifi off >/dev/null 2>&1 || log "pre: nmcli radio wifi off failed or timed out"
	fi
	if command -v rfkill >/dev/null 2>&1; then
		bounded 2 rfkill block wifi >/dev/null 2>&1 || true
		bounded 2 rfkill block bluetooth >/dev/null 2>&1 || true
	fi
	for iface in /sys/class/net/*; do
		[ -e "$iface/device/driver" ] || continue
		drv=$(basename "$(readlink "$iface/device/driver" 2>/dev/null)" 2>/dev/null) || continue
		case $drv in
		mt7921e | mt7925e)
			bounded 2 ip link set "$(basename "$iface")" down >/dev/null 2>&1 || true
			;;
		esac
	done

	for svc in bluetoothd bluetooth bluez; do
		if [ -e "/var/service/$svc" ]; then
			printf '%s\n' "$svc" >>"$SVLIST"
			# -w 2: sv's own wait; timeout is the backstop if sv itself hangs.
			bounded 3 sv -w 2 down "$svc" >/dev/null 2>&1 || true
		fi
	done
	if command -v bluetoothctl >/dev/null 2>&1; then
		bounded 2 bluetoothctl power off >/dev/null 2>&1 || true
	fi

	for drv in mt7925e mt7921e; do
		drvdir=/sys/bus/pci/drivers/$drv
		[ -d "$drvdir" ] || continue
		for link in "$drvdir"/0000:*; do
			[ -e "$link" ] || continue
			bdf=$(basename "$link")
			log "pre: unbind+remove $bdf ($drv)"
			sysfs_write "$bdf" "$drvdir/unbind" || log "WARN: unbind $bdf failed or timed out"
			if [ -w "/sys/bus/pci/devices/$bdf/remove" ]; then
				sysfs_write 1 "/sys/bus/pci/devices/$bdf/remove" || log "WARN: remove $bdf failed or timed out"
			fi
		done
	done

	if mt_pci_bound mt7921e || mt_pci_bound mt7925e; then
		sleep 1
		# btmtk is the Bluetooth function of that PCI chip. Do not touch
		# btintel/btrtl. One bounded rmmod; a busy module is left loaded.
		for mod in btmtk btusb mt7925e mt7921e; do
			modprobe_r_bounded "$mod"
		done
	else
		log "pre: no mt7921e/mt7925e PCI device; skip module unload"
	fi
	_leave_pre ''
}

wifi_up() {
	log "post: scheduling wifi reload after unlock"
	(
		trap '' HUP
		n=0
		while command -v pgrep >/dev/null 2>&1 && \
			pgrep -x xsecurelock >/dev/null 2>&1
		do
			n=$((n + 1))
			[ "$n" -ge 90 ] && break
			sleep 1
		done
		sleep 3
		log "post: reloading wifi"
		if [ -w /sys/bus/pci/rescan ]; then
			echo 1 >/sys/bus/pci/rescan 2>/dev/null || true
			sleep 2
		fi
		if [ -f "$STASH" ]; then
			if command -v tac >/dev/null 2>&1; then
				_list=$(tac "$STASH")
			else
				_list=$(cat "$STASH")
			fi
			printf '%s\n' "$_list" | while read -r mod; do
				[ -n "$mod" ] || continue
				modprobe "$mod" >/dev/null 2>&1 || true
			done
			rm -f "$STASH"
		fi
		modprobe mt7921e >/dev/null 2>&1 || true
		if [ -f "$SVLIST" ]; then
			while read -r svc; do
				[ -n "$svc" ] || continue
				sv up "$svc" >/dev/null 2>&1 || true
			done <"$SVLIST"
			rm -f "$SVLIST"
		fi
		if command -v rfkill >/dev/null 2>&1; then
			rfkill unblock bluetooth >/dev/null 2>&1 || true
			rfkill unblock wifi >/dev/null 2>&1 || true
		fi
		if command -v nmcli >/dev/null 2>&1; then
			nmcli radio wifi on >/dev/null 2>&1 || true
		fi
		log "post: reload finished"
		sync >/dev/null 2>&1 || true
	) >/dev/null 2>&1 &
}

case ${1:-} in
pre) wifi_down "$@" ;;
post)
	if [ -w /sys/power/pm_async ]; then
		sysfs_write 0 /sys/power/pm_async || true
	fi
	wifi_up
	;;
esac

exit 0
