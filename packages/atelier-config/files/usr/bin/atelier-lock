#!/bin/sh
# Atelier — lock the screen with xsecurelock (Super+Shift+l, idle, sleep).
#
# - Loads XSECURELOCK_* from ~/.config/xsecurelock/env.sh
# - Prefer xss-lock path via "xset s activate" when xss-lock is already running
# - When run as the xss-lock locker, runs xsecurelock (no exec) and may
#   schedule suspend after ATELIER_LOCK_SUSPEND_SEC (default 120) while locked.
#   The waiter is killed on unlock; the X screensaver idle timer is reset.
#
# Env:
#   ATELIER_LOCK_SUSPEND_SEC  seconds after lock before suspend (0 = never)
#   ATELIER_SKIP_LOCK_SUSPEND=1  same as 0
set -eu

# Load Atelier xsecurelock theme / prompts
if [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/xsecurelock/env.sh" ]; then
	# shellcheck source=/dev/null
	. "${XDG_CONFIG_HOME:-$HOME/.config}/xsecurelock/env.sh"
elif [ -f "$HOME/.config/xsecurelock/env.sh" ]; then
	# shellcheck source=/dev/null
	. "$HOME/.config/xsecurelock/env.sh"
fi

# Already locked
if pgrep -u "$(id -u)" -x xsecurelock >/dev/null 2>&1; then
	exit 0
fi

# If xss-lock is managing the locker, ask it to lock (correct sleep-lock FD path).
# Detect "we are the locker" via XSS_SLEEP_LOCK_FD or parent/argv.
if [ -z "${XSS_SLEEP_LOCK_FD:-}" ] \
	&& [ "${1:-}" != "--as-locker" ] \
	&& pgrep -u "$(id -u)" -x xss-lock >/dev/null 2>&1; then
	# Force screensaver → xss-lock starts us again as locker
	if command -v xset >/dev/null 2>&1; then
		xset s activate
		exit 0
	fi
	if command -v loginctl >/dev/null 2>&1; then
		loginctl lock-session 2>/dev/null && exit 0
	fi
fi

if ! command -v xsecurelock >/dev/null 2>&1; then
	printf 'atelier-lock: xsecurelock not found\n' >&2
	exit 1
fi

# Suspend shortly after lock while still locked (manual lock or idle lock).
_suspend_sec=${ATELIER_LOCK_SUSPEND_SEC:-120}
if [ -n "${ATELIER_SKIP_LOCK_SUSPEND:-}" ]; then
	_suspend_sec=0
fi

# Pidfile so a restored/orphaned waiter from a previous lock cannot fire after
# unlock. Do not exec xsecurelock: dash runs EXIT traps on exec, bash does not.
# xss-lock -l passes XSS_SLEEP_LOCK_FD; only xsecurelock may hold it. The
# waiter and this parent must close their copies or lid-sleep waits on them.
_uid=$(id -u)
_pidfile="${XDG_RUNTIME_DIR:-/tmp}/atelier-lock-suspend.${_uid}.pid"
_waiter=""

_close_sleep_fd() {
	case ${XSS_SLEEP_LOCK_FD:-} in
	''|*[!0-9]*) ;;
	*) eval "exec ${XSS_SLEEP_LOCK_FD}>&-" ;;
	esac
}

_stop_waiter() {
	if [ -n "$_waiter" ]; then
		kill "$_waiter" 2>/dev/null || true
		wait "$_waiter" 2>/dev/null || true
		_waiter=""
	fi
	if [ -f "$_pidfile" ]; then
		_old=$(cat "$_pidfile" 2>/dev/null || true)
		if [ -n "$_old" ] && [ "$_old" != "$$" ]; then
			kill "$_old" 2>/dev/null || true
		fi
		rm -f "$_pidfile"
	fi
}

_reset_idle() {
	if command -v xset >/dev/null 2>&1; then
		xset s reset 2>/dev/null || true
	fi
}

_cleanup() {
	_stop_waiter
	_reset_idle
}
trap '_cleanup' EXIT INT TERM HUP

# Drop a waiter left over from a previous lock (hibernate restore, exec trap).
if [ -f "$_pidfile" ]; then
	_old=$(cat "$_pidfile" 2>/dev/null || true)
	if [ -n "$_old" ]; then
		kill "$_old" 2>/dev/null || true
	fi
	rm -f "$_pidfile"
fi

if [ "$_suspend_sec" -gt 0 ] 2>/dev/null; then
	(
		_close_sleep_fd
		sleep "$_suspend_sec"
		# Only suspend if still locked by us
		if pgrep -u "$(id -u)" -x xsecurelock >/dev/null 2>&1; then
			if command -v loginctl >/dev/null 2>&1; then
				# Swap + disk hibernate: sleep, then hibernate after 30 min
				# (elogind HibernateDelaySec from atelier-setup-swap).
				if [ -r /sys/power/state ] && grep -qw disk /sys/power/state \
					&& awk 'NR > 1 { sz += $3 } END { exit !(sz > 0) }' /proc/swaps 2>/dev/null
				then
					loginctl suspend-then-hibernate 2>/dev/null || loginctl suspend 2>/dev/null || true
				else
					loginctl suspend 2>/dev/null || true
				fi
			elif command -v zzz >/dev/null 2>&1; then
				zzz 2>/dev/null || true
			fi
		fi
	) &
	_waiter=$!
	mkdir -p "$(dirname "$_pidfile")" 2>/dev/null || true
	printf '%s\n' "$_waiter" >"$_pidfile"
fi

# Fork the locker first so it inherits XSS_SLEEP_LOCK_FD, then drop our copy.
xsecurelock &
_lockpid=$!
_close_sleep_fd
wait "$_lockpid" || true

