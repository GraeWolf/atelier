# Generated by atelier-theme — do not edit (switch themes instead)
# Colors are quoted so dunst does not treat "#" as a comment.

[global]
    frame_color = "{{ accent }}"
    separator_color = frame
    icon_theme = "{{ icon_theme }}"

[urgency_low]
    background = "{{ background }}"
    foreground = "{{ foreground_dim }}"
    frame_color = "{{ border }}"
    timeout = 5

[urgency_normal]
    background = "{{ background_alt }}"
    foreground = "{{ foreground }}"
    frame_color = "{{ accent }}"
    timeout = 8

[urgency_critical]
    background = "{{ red }}"
    foreground = "{{ background }}"
    frame_color = "{{ red }}"
    timeout = 0
