# Template file for 'atelier-installer'
# gum (TUI) whole-disk installer for Atelier live images.
pkgname=atelier-installer
version=0.6.0
revision=1
create_wrksrc=yes
short_desc="Atelier gum TUI installer (whole-disk, optional LUKS2, swapfile, Steam)"
maintainer="Atelier Linux <atelier@localhost>"
license="MIT"
homepage="https://github.com/GraeWolf/atelier"

# gum is the installer UI (Void package name: gum). polkit provides pkexec
# so a launch that is not already root can re-exec on the console. sudo is
# the live-ISO path (sudo atelier-install).
depends="
 gum>=0
 parted>=0
 e2fsprogs>=0
 dosfstools>=0
 util-linux>=0
 cryptsetup>=0
 xbps>=0
 sudo>=0
 polkit>=0
 grub>=0
"

do_install() {
	vinstall "${FILESDIR}/usr/bin/atelier-install" 755 usr/bin
	vinstall "${FILESDIR}/etc/atelier/install.conf" 644 etc/atelier
	vinstall "${FILESDIR}/usr/share/atelier/installer/gaming.txt" 644 usr/share/atelier/installer
}
