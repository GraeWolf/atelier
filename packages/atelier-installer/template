# Template file for 'atelier-installer'
# Dialog (TUI) whole-disk installer for Atelier live images.
pkgname=atelier-installer
version=0.5.11
revision=1
create_wrksrc=yes
short_desc="Atelier dialog TUI installer (whole-disk, optional LUKS2, optional swapfile)"
maintainer="Atelier Linux <atelier@localhost>"
license="MIT"
homepage="https://github.com/GraeWolf/atelier"

# dialog is the installer UI. polkit provides pkexec so a launch that is
# not already root can re-exec on the console. sudo is the live-ISO path
# (sudo atelier-install).
depends="
 dialog>=0
 parted>=0
 e2fsprogs>=0
 dosfstools>=0
 util-linux>=0
 cryptsetup>=0
 xbps>=0
 sudo>=0
 polkit>=0
 grub>=0
"

do_install() {
	vinstall "${FILESDIR}/usr/bin/atelier-install" 755 usr/bin
	vinstall "${FILESDIR}/etc/atelier/install.conf" 644 etc/atelier
}
