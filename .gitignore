# Build artifacts (populated when package/ISO builds exist)
*.iso
*.img
*.xbps
*.xbps.sig

# Local repository output (keep layout/docs; ignore generated indices and packages)
repo/out/
repo/work/
repo/x86_64/
repo/noarch/
repo/*-repodata
repo/*.xbps
repo/*.xbps.sig
repo/**/*.xbps
repo/**/*-repodata
repo/**/*.xbps.sig

# void-mklive workdirs, include staging, caches (generated in-tree)
iso/void-mklive/
iso/include/
iso/work/
iso/output/
iso/*.iso

# Editor / OS noise
*~
*.swp
.DS_Store

# Secrets and credentials — never commit
*.key
*.pem
**/*secret*
**/.env*
**/private/
**/keys/
